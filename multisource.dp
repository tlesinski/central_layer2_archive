SQL> CREATE OR REPLACE FUNCTION FN_ARCHIVER_HIGH_VALUE_DATE
  2  (
  3    p_high_value IN VARCHAR2
  4  )
  5  RETURN DATE
  6  IS
  7    l_date DATE;
  8  BEGIN
  9    IF p_high_value IS NULL THEN
 10  	 RAISE_APPLICATION_ERROR(-20001, 'HIGH_VALUE cannot be NULL');
 11    END IF;
 12  
 13    EXECUTE IMMEDIATE 'SELECT ' || p_high_value || ' FROM dual'
 14  	 INTO l_date;
 15  
 16    RETURN l_date;
 17  END;
 18  /

