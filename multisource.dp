SQL> CREATE OR REPLACE PACKAGE BODY PKG_REPLICA_REPLICATE
  2  AS
  3    /*
  4  	 Package      : PKG_REPLICA_REPLICATE
  5  	 Developer    : Tomasz Lesinski
  6  	 Date	      : 2026-06-01
  7  	 Purpose      : Replicate archived layer 2 partitions into layer 3 target
  8  			tables for the configured online window.
  9  
 10  	 Prerequisite : PKG_REPLICA_SQL, PKG_REPLICA_LOG, VW_REPLICA_REPLICATE_PARTITIONS
 11  
 12  	 Change History:
 13  	 ------------------------------------------------------------------------------
 14  	 Version    Date	 Programmer	    Description
 15  	 ------------------------------------------------------------------------------
 16  	  1.0	     2026-06-01   Tomasz Lesinski    Initial version
 17    */
 18    FUNCTION fn_normalize_execute(p_execute IN VARCHAR2) RETURN VARCHAR2 IS
 19    BEGIN
 20  	 RETURN CASE WHEN UPPER(NVL(TRIM(p_execute), 'N')) = 'Y' THEN 'Y' ELSE 'N' END;
 21    END fn_normalize_execute;
 22  
 23    FUNCTION fn_normalize_name(p_name IN VARCHAR2) RETURN VARCHAR2 IS
 24    BEGIN
 25  	 IF p_name IS NULL OR TRIM(p_name) IS NULL THEN
 26  	   RETURN NULL;
 27  	 END IF;
 28  
 29  	 RETURN PKG_REPLICA_SQL.fn_assert_simple_name(p_name);
 30    END fn_normalize_name;
 31  
 32    PROCEDURE prc_mark_partition
 33    (
 34  	 p_source_db_link	   IN VARCHAR2,
 35  	 p_source_owner 	   IN VARCHAR2,
 36  	 p_source_table_name	   IN VARCHAR2,
 37  	 p_partition_high_value    IN VARCHAR2,
 38  	 p_subpartition_high_value IN VARCHAR2,
 39  	 p_replica_status	   IN VARCHAR2,
 40  	 p_run_id		   IN NUMBER,
 41  	 p_target_row_count	   IN NUMBER DEFAULT NULL,
 42  	 p_error_message	   IN VARCHAR2 DEFAULT NULL
 43    )
 44    IS
 45    BEGIN
 46  	 UPDATE tbl_replica_partitions
 47  	    SET replica_status = p_replica_status,
 48  		quality_status = CASE WHEN p_replica_status = 'Y' THEN 'N' ELSE quality_status END,
 49  		target_row_count = COALESCE(p_target_row_count, target_row_count),
 50  		last_run_id = p_run_id,
 51  		error_message = p_error_message,
 52  		updated_at = SYSTIMESTAMP
 53  	  WHERE source_db_link = p_source_db_link
 54  	    AND source_owner = p_source_owner
 55  	    AND source_table_name = p_source_table_name
 56  	    AND partition_high_value = p_partition_high_value
 57  	    AND subpartition_high_value = p_subpartition_high_value;
 58    END prc_mark_partition;
 59  
 60    PROCEDURE prc_replicate
 61    (
 62  	 p_execute	     IN VARCHAR2 DEFAULT 'N',
 63  	 p_target_owner      IN VARCHAR2 DEFAULT NULL,
 64  	 p_target_table_name IN VARCHAR2 DEFAULT NULL
 65    )
 66    IS
 67  	 l_run_id	     NUMBER;
 68  	 l_log_id	     NUMBER;
 69  	 l_execute_flag      VARCHAR2(1);
 70  	 l_target_owner      VARCHAR2(128);
 71  	 l_target_table      VARCHAR2(128);
 72  	 l_sql		     CLOB;
 73  	 l_rows_available    NUMBER := 0;
 74  	 l_rows_loaded	     NUMBER;
 75  	 l_staging_table     VARCHAR2(128);
 76  	 l_units	     NUMBER := 0;
 77  	 l_replicated	     NUMBER := 0;
 78  	 l_tables	     NUMBER := 0;
 79  	 l_summary	     CLOB := NULL;
 80  	 l_table_summary     CLOB;
 81  	 l_partition_columns VARCHAR2(1000) :=
 82  	   'NOTE|SOURCE_PARTITION_NAME|SOURCE_SUBPARTITION_NAME|PARTITION_NAME|SUBPARTITION_NAME|PARTITION_HIGH_VALUE|SUBPARTITION_HIGH_VALUE|REPLICA_STATUS|QUALITY_STATUS|PURGE_STATUS|SOURCE_ROW_COUNT|TARGET_ROW_COUNT';
 83    BEGIN
 84  	 l_execute_flag := fn_normalize_execute(p_execute);
 85  	 l_target_owner := fn_normalize_name(p_target_owner);
 86  	 l_target_table := fn_normalize_name(p_target_table_name);
 87  	 l_run_id := PKG_REPLICA_LOG.fn_create_run('REPLICATE', NULL, NULL, NULL, l_execute_flag);
 88  	 l_log_id := PKG_REPLICA_LOG.fn_get_log_id(l_run_id);
 89  
 90  	 PKG_REPLICA_LOG.prc_log_message
 91  	 (
 92  	   p_run_id  => l_run_id,
 93  	   p_log_msg => 'Started REPLICA REPLICATE with parameters:' || CHR(10) ||
 94  			'  p_execute	       => ' || l_execute_flag || CHR(10) ||
 95  			'  p_target_owner      => ' || NVL(l_target_owner, '<ALL>') || CHR(10) ||
 96  			'  p_target_table_name => ' || NVL(l_target_table, '<ALL>')
 97  	 );
 98  
 99  	 IF l_execute_flag = 'Y' THEN
100  	   COMMIT;
101  	   EXECUTE IMMEDIATE 'ALTER SESSION ENABLE PARALLEL DML';
102  	 END IF;
103  
104  	 l_sql :=
105  	   'SELECT COUNT(*) ' ||
106  	   '  FROM VW_REPLICA_REPLICATE_PARTITIONS ' ||
107  	   ' WHERE (:1 IS NULL OR target_owner = :1) ' ||
108  	   '   AND (:2 IS NULL OR target_table_name = :2)';
109  
110  	 l_rows_available := PKG_REPLICA_SQL.fn_run_into_sql_in_bind
111  	 (
112  	   p_log_id	=> l_log_id,
113  	   p_sql	=> l_sql,
114  	   p_array_bind => SYS.ODCIVARCHAR2LIST(l_target_owner, l_target_table),
115  	   p_execute	=> 'Y'
116  	 );
117  
118  	 FOR t IN (
119  	   SELECT DISTINCT source_db_link,
120  		  source_owner,
121  		  source_table_name,
122  		  target_owner,
123  		  target_table_name
124  	     FROM vw_replica_replicate_partitions
125  	    WHERE (l_target_owner IS NULL OR target_owner = l_target_owner)
126  	      AND (l_target_table IS NULL OR target_table_name = l_target_table)
127  	    ORDER BY source_db_link, source_owner, source_table_name
128  	 ) LOOP
129  	   l_tables := l_tables + 1;
130  	   l_table_summary := NULL;
131  
132  	   FOR r IN (
133  	     SELECT p.*
134  	       FROM vw_replica_replicate_partitions p
135  	      WHERE p.source_db_link = t.source_db_link
136  		AND p.source_owner = t.source_owner
137  		AND p.source_table_name = t.source_table_name
138  		AND p.target_owner = t.target_owner
139  		AND p.target_table_name = t.target_table_name
140  	      ORDER BY p.partition_high_value, p.subpartition_high_value
141  	   ) LOOP
142  	     l_units := l_units + 1;
143  	     l_rows_loaded := NULL;
144  
145  	     IF l_execute_flag = 'Y' THEN
146  	       prc_mark_partition
147  	       (
148  		 r.source_db_link,
149  		 r.source_owner,
150  		 r.source_table_name,
151  		 r.partition_high_value,
152  		 r.subpartition_high_value,
153  		 'N',
154  		 l_run_id
155  	       );
156  	     END IF;
157  
158  	     PKG_REPLICA_PARTITION.prc_create_exchange_staging
159  	     (
160  	       p_target_owner	    => r.target_owner,
161  	       p_target_table	    => r.target_table_name,
162  	       p_partition_name     => r.partition_name,
163  	       p_staging_table_name => l_staging_table,
164  	       p_execute	    => l_execute_flag,
165  	       p_log_id 	    => l_log_id,
166  	       p_tablespace_name    => r.tablespace_name
167  	     );
168  
169  	     IF r.archive_unit_type = 'SUBPARTITION' THEN
170  	       PKG_REPLICA_PARTITION.prc_load_exchange_staging_subpartition
171  	       (
172  		 p_source_db_link	       => r.source_db_link,
173  		 p_source_owner 	       => r.source_owner,
174  		 p_source_table 	       => r.source_table_name,
175  		 p_target_owner 	       => r.target_owner,
176  		 p_target_table 	       => r.target_table_name,
177  		 p_staging_table_name	       => l_staging_table,
178  		 p_partition_high_value        => r.partition_high_value,
179  		 p_prev_partition_high_value   => r.prev_partition_high_value,
180  		 p_subpartition_high_value     => r.subpartition_high_value,
181  		 p_execute		       => l_execute_flag,
182  		 p_log_id		       => l_log_id,
183  		 p_parallel_degree	       => r.parallel_degree,
184  		 p_rows_loaded		       => l_rows_loaded
185  	       );
186  	     ELSE
187  	       PKG_REPLICA_PARTITION.prc_load_exchange_staging
188  	       (
189  		 p_source_db_link	 => r.source_db_link,
190  		 p_source_owner 	 => r.source_owner,
191  		 p_source_table 	 => r.source_table_name,
192  		 p_target_owner 	 => r.target_owner,
193  		 p_target_table 	 => r.target_table_name,
194  		 p_staging_table_name	 => l_staging_table,
195  		 p_high_value		 => r.partition_high_value,
196  		 p_prev_high_value	 => r.prev_partition_high_value,
197  		 p_execute		 => l_execute_flag,
198  		 p_log_id		 => l_log_id,
199  		 p_parallel_degree	 => r.parallel_degree,
200  		 p_rows_loaded		 => l_rows_loaded
201  	       );
202  	     END IF;
203  
204  	     PKG_REPLICA_PARTITION.prc_build_staging_indexes
205  	     (
206  	       p_target_owner	    => r.target_owner,
207  	       p_target_table	    => r.target_table_name,
208  	       p_staging_table_name => l_staging_table,
209  	       p_execute	    => l_execute_flag,
210  	       p_log_id 	    => l_log_id,
211  	       p_parallel_degree    => r.parallel_degree,
212  	       p_tablespace_name    => r.tablespace_name
213  	     );
214  
215  	     IF r.archive_unit_type = 'SUBPARTITION' THEN
216  	       PKG_REPLICA_PARTITION.prc_exchange_subpartition
217  	       (
218  		 p_target_owner       => r.target_owner,
219  		 p_target_table       => r.target_table_name,
220  		 p_subpartition_name  => r.subpartition_name,
221  		 p_staging_table_name => l_staging_table,
222  		 p_execute	      => l_execute_flag,
223  		 p_log_id	      => l_log_id
224  	       );
225  	     ELSE
226  	       PKG_REPLICA_PARTITION.prc_exchange_partition
227  	       (
228  		 p_target_owner       => r.target_owner,
229  		 p_target_table       => r.target_table_name,
230  		 p_partition_name     => r.partition_name,
231  		 p_staging_table_name => l_staging_table,
232  		 p_execute	      => l_execute_flag,
233  		 p_log_id	      => l_log_id
234  	       );
235  	     END IF;
236  
237  	     PKG_REPLICA_PARTITION.prc_drop_staging
238  	     (
239  	       p_staging_owner	    => r.target_owner,
240  	       p_staging_table_name => l_staging_table,
241  	       p_execute	    => l_execute_flag,
242  	       p_log_id 	    => l_log_id
243  	     );
244  
245  	     PKG_REPLICA_LOG.prc_log_message
246  	     (
247  	       p_run_id   => l_run_id,
248  	       p_log_type => 'REPLICA_EXCHANGE',
249  	       p_log_msg  => 'REPLICA_EXCHANGE ' ||
250  			     'source=' || r.source_db_link || '.' || r.source_owner || '.' || r.source_table_name ||
251  			     ' ' || r.source_partition_name ||
252  			     CASE
253  			       WHEN r.archive_unit_type = 'SUBPARTITION'
254  				 THEN '.' || r.source_subpartition_name
255  			     END ||
256  			     ', target=' || r.target_owner || '.' || r.target_table_name ||
257  			     ' ' || r.partition_name ||
258  			     CASE
259  			       WHEN r.archive_unit_type = 'SUBPARTITION'
260  				 THEN '.' || r.subpartition_name
261  			     END ||
262  			     ', staging=' || r.target_owner || '.' || l_staging_table ||
263  			     ', rows_loaded=' || NVL(TO_CHAR(l_rows_loaded), '<DRY_RUN>') ||
264  			     ', execute=' || l_execute_flag
265  	     );
266  
267  	     IF l_execute_flag = 'Y' THEN
268  	       prc_mark_partition
269  	       (
270  		 r.source_db_link,
271  		 r.source_owner,
272  		 r.source_table_name,
273  		 r.partition_high_value,
274  		 r.subpartition_high_value,
275  		 'Y',
276  		 l_run_id,
277  		 l_rows_loaded
278  	       );
279  
280  	       l_replicated := l_replicated + 1;
281  	       COMMIT;
282  	     END IF;
283  
284  	     DBMS_OUTPUT.PUT_LINE('REPLICATE_EXCHANGE ' ||
285  				  r.source_db_link || '.' || r.source_owner || '.' ||
286  				  r.source_table_name || ' ' || r.source_partition_name ||
287  				  CASE WHEN r.archive_unit_type = 'SUBPARTITION' THEN '.' || r.source_subpartition_name END ||
288  				  ' target=' || r.target_owner || '.' || r.target_table_name || ' ' ||
289  				  r.partition_name ||
290  				  CASE WHEN r.archive_unit_type = 'SUBPARTITION' THEN '.' || r.subpartition_name END ||
291  				  ' staging=' || r.target_owner || '.' || l_staging_table ||
292  				  ' loaded=' || NVL(TO_CHAR(l_rows_loaded), '<DRY_RUN>'));
293  
294  	     IF l_execute_flag = 'Y' THEN
295  	       l_table_summary := l_table_summary ||
296  		 TO_CLOB(PKG_REPLICA_LOG.fn_summary_cell('EXCHANGED')) || '|' ||
297  		 PKG_REPLICA_LOG.fn_summary_cell(r.source_partition_name) || '|' ||
298  		 PKG_REPLICA_LOG.fn_summary_cell(r.source_subpartition_name) || '|' ||
299  		 PKG_REPLICA_LOG.fn_summary_cell(r.partition_name) || '|' ||
300  		 PKG_REPLICA_LOG.fn_summary_cell(r.subpartition_name) || '|' ||
301  		 PKG_REPLICA_LOG.fn_summary_cell(r.partition_high_value) || '|' ||
302  		 PKG_REPLICA_LOG.fn_summary_cell(r.subpartition_high_value) || '|' ||
303  		 PKG_REPLICA_LOG.fn_summary_cell('Y') || '|' ||
304  		 PKG_REPLICA_LOG.fn_summary_cell('N') || '|' ||
305  		 PKG_REPLICA_LOG.fn_summary_cell(r.purge_status) || '|' ||
306  		 PKG_REPLICA_LOG.fn_summary_cell(TO_CHAR(r.source_row_count)) || '|' ||
307  		 PKG_REPLICA_LOG.fn_summary_cell(TO_CHAR(l_rows_loaded)) || CHR(10);
308  	     END IF;
309  	   END LOOP;
310  
311  	   IF l_execute_flag = 'Y' AND l_table_summary IS NOT NULL THEN
312  	     l_summary := l_summary ||
313  	       '=== TABLE: ' || t.source_db_link || '.' || t.source_owner || '.' || t.source_table_name || ' ===' || CHR(10) || CHR(10) ||
314  	       PKG_REPLICA_SQL.fn_format_table
315  	       (
316  		 p_columns => 'SOURCE_DB_LINK|TABLE_OWNER|TABLE_NAME|EXECUTE',
317  		 p_rows    => PKG_REPLICA_LOG.fn_summary_cell(t.source_db_link) || '|' ||
318  			      PKG_REPLICA_LOG.fn_summary_cell(t.source_owner) || '|' ||
319  			      PKG_REPLICA_LOG.fn_summary_cell(t.source_table_name) || '|' ||
320  			      PKG_REPLICA_LOG.fn_summary_cell(l_execute_flag) || CHR(10)
321  	       ) || CHR(10) ||
322  	       PKG_REPLICA_SQL.fn_format_table
323  	       (
324  		 p_columns => l_partition_columns,
325  		 p_rows    => l_table_summary
326  	       ) || CHR(10);
327  	   END IF;
328  	 END LOOP;
329  
330  	 IF l_summary IS NOT NULL THEN
331  	   PKG_REPLICA_LOG.prc_log_message(l_run_id, l_summary, 'SUMMARY');
332  	 END IF;
333  
334  	 DBMS_OUTPUT.PUT_LINE(
335  	   'REPLICATE tables=' || l_tables ||
336  	   ' units=' || l_units ||
337  	   ' found=' || l_rows_available ||
338  	   ' replicated=' || l_replicated ||
339  	   ' target_owner=' || NVL(l_target_owner, '<ALL>') ||
340  	   ' target_table=' || NVL(l_target_table, '<ALL>') ||
341  	   ' execute=' || l_execute_flag
342  	 );
343  
344  	 PKG_REPLICA_LOG.prc_finish_run(l_run_id, 'SUCCESS');
345    EXCEPTION
346  	 WHEN OTHERS THEN
347  	   IF l_run_id IS NOT NULL THEN
348  	     PKG_REPLICA_LOG.prc_log_error_stack(l_run_id);
349  	     PKG_REPLICA_LOG.prc_finish_run(l_run_id, 'ERROR', SQLERRM);
350  	   END IF;
351  	   RAISE;
352    END prc_replicate;
353  END PKG_REPLICA_REPLICATE;
354  /

