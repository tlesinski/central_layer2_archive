SQL> CREATE OR REPLACE VIEW VW_ARCHIVER_DISCOVERY_PARTITIONS
  2  AS
  3  SELECT s.source_db_link,
  4  	    s.source_agent_schema,
  5  	    s.source_owner,
  6  	    s.source_table_name,
  7  	    s.target_owner,
