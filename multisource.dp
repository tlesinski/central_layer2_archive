SQL> DECLARE
  2    l_invalid_objects PLS_INTEGER;
  3    l_tw_objects	 PLS_INTEGER;
  4    l_old_views	 PLS_INTEGER;
  5  BEGIN
  6    SELECT COUNT(*)
  7  	 INTO l_invalid_objects
  8  	 FROM USER_OBJECTS
  9  	WHERE status <> 'VALID';
 10  
 11    SELECT COUNT(*)
 12  	 INTO l_tw_objects
 13  	 FROM USER_OBJECTS
 14  	WHERE object_name LIKE 'TW\_%' ESCAPE '\';
 15  
 16    SELECT COUNT(*)
 17  	 INTO l_old_views
 18  	 FROM USER_VIEWS
 19  	WHERE view_name LIKE '%\_VW' ESCAPE '\';
 20  
 21    IF l_invalid_objects <> 0 THEN
 22  	 RAISE_APPLICATION_ERROR(-20071, 'Combined smoke invalid objects: ' || l_invalid_objects);
 23    ELSIF l_tw_objects <> 0 THEN
 24  	 RAISE_APPLICATION_ERROR(-20072, 'Combined smoke found TW_ objects: ' || l_tw_objects);
 25    ELSIF l_old_views <> 0 THEN
 26  	 RAISE_APPLICATION_ERROR(-20073, 'Combined smoke found _VW views: ' || l_old_views);
 27    END IF;
 28  
 29    DBMS_OUTPUT.PUT_LINE('COMBINED_SMOKE_OK');
 30  END;
