SQL> @layer3_replica/views/vw_replica_purge_partitions.sql
SQL> CREATE OR REPLACE VIEW VW_REPLICA_PURGE_PARTITIONS
  2  AS
  3  WITH base_dates AS (
  4    SELECT source_db_link,
  5  	      source_owner,
  6  	      source_table_name,
  7  	      MAX(partition_high_value_date) AS base_date
  8  	 FROM vw_replica_source_partitions
  9  	GROUP BY source_db_link, source_owner, source_table_name
 10  )
 11  SELECT p.source_db_link,
 12  	    p.source_owner,
 13  	    p.source_table_name,
 14  	    p.target_owner,
 15  	    p.target_table_name,
 16  	    p.archive_unit_type,
 17  	    p.source_partition_name,
 18  	    p.source_subpartition_name,
 19  	    p.partition_name,
 20  	    p.subpartition_name,
 21  	    p.partition_high_value,
 22  	    p.subpartition_high_value,
 23  	    p.prev_partition_high_value,
 24  	    p.replica_status,
 25  	    p.quality_status,
 26  	    p.purge_status,
 27  	    p.source_row_count,
 28  	    p.target_row_count,
 29  	    t.days_online,
 30  	    b.base_date,
 31  	    b.base_date - t.days_online AS cutoff_date,
 32  	    FN_REPLICA_HIGH_VALUE_DATE(p.partition_high_value) AS partition_high_value_date
 33    FROM tbl_replica_partitions p
 34    JOIN tbl_replica_tables t
 35  	 ON t.source_db_link = p.source_db_link
 36  	AND t.source_owner = p.source_owner
 37  	AND t.source_table_name = p.source_table_name
 38  	AND t.enabled_flag = 'Y'
 39    JOIN base_dates b
 40  	 ON b.source_db_link = p.source_db_link
 41  	AND b.source_owner = p.source_owner
 42  	AND b.source_table_name = p.source_table_name
 43   WHERE p.replica_status = 'Y'
 44  	AND p.quality_status = 'Y'
 45  	AND p.purge_status = 'N'
 46  	AND FN_REPLICA_HIGH_VALUE_DATE(p.partition_high_value) <= b.base_date - t.days_online;

