SQL> @layer2_core/packages/pkg_archiver_quality.body.sql
SQL> CREATE OR REPLACE PACKAGE BODY PKG_ARCHIVER_QUALITY
  2  AS
  3    /*
  4  	 Package      : PKG_ARCHIVER_QUALITY
  5  	 Developer    : Tomasz Lesinski
  6  	 Date	      : 2026-05-28
  7  	 Purpose      : Quality check - compare source and target row counts,
  8  			set QUALITY_STATUS
  9  
 10  	 Prerequisite : PKG_ARCHIVER_SQL, PKG_ARCHIVER_LOG, PKG_AGENT_ARCHIVE,
 11  			VW_ARCHIVER_QUALITY_PARTITIONS
 12  
 13  	 Change History:
 14  	 ------------------------------------------------------------------------------
 15  	 Version    Date	 Programmer	    Description
 16  	 ------------------------------------------------------------------------------
 17  	 1.0	    2026-05-28	 Tomasz Lesinski    Initial version
 18  	  1.1	     2026-05-28   Tomasz Lesinski    Add process summary logging
 19  	  1.2	     2026-05-31   Tomasz Lesinski    Compact per-table summary, ORA-40478 fix
 20    */
 21    FUNCTION fn_normalize_execute(p_execute IN VARCHAR2) RETURN VARCHAR2 IS
 22    BEGIN
 23  	 RETURN CASE WHEN UPPER(NVL(TRIM(p_execute), 'N')) = 'Y' THEN 'Y' ELSE 'N' END;
 24    END;
 25  
 26    FUNCTION fn_normalize_name(p_name IN VARCHAR2) RETURN VARCHAR2 IS
 27    BEGIN
 28  	 IF p_name IS NULL OR TRIM(p_name) IS NULL THEN
 29  	   RETURN NULL;
 30  	 END IF;
 31  
 32  	 RETURN PKG_ARCHIVER_SQL.fn_assert_simple_name(p_name);
 33    END;
 34  
 35    FUNCTION fn_qualified_agent_function(p_agent_schema IN VARCHAR2, p_source_db_link IN VARCHAR2) RETURN VARCHAR2 IS
 36  	 l_name VARCHAR2(400);
 37    BEGIN
 38  	 l_name := PKG_ARCHIVER_SQL.fn_assert_simple_name(p_agent_schema) || '.PKG_AGENT_ARCHIVE.FN_GET_ROW_COUNT';
 39  	 l_name := l_name || '@' || PKG_ARCHIVER_SQL.fn_assert_simple_name(p_source_db_link);
 40  	 RETURN l_name;
 41    END;
 42  
 43    PROCEDURE prc_quality
 44    (
 45  	 p_execute	     IN VARCHAR2 DEFAULT 'N',
 46  	 p_target_owner      IN VARCHAR2 DEFAULT NULL,
 47  	 p_target_table_name IN VARCHAR2 DEFAULT NULL
 48    )
 49    IS
 50  	 l_run_id	   NUMBER;
 51  	 l_log_id	   NUMBER;
 52  	 l_execute_flag    VARCHAR2(1);
 53  	 l_target_owner    VARCHAR2(128);
 54  	 l_target_table    VARCHAR2(128);
 55  	 l_sql		   CLOB;
 56  	 l_rows_available  NUMBER := 0;
 57  	 l_agent_function  VARCHAR2(400);
 58  	 l_source_rows	   NUMBER;
 59  	 l_units	   NUMBER := 0;
 60  	 l_tables	   NUMBER := 0;
 61  	 l_ok		   NUMBER := 0;
 62  	 l_failed	   NUMBER := 0;
 63  	 l_quality_status  VARCHAR2(1);
 64  	 l_summary	   CLOB := NULL;
 65  	 l_table_summary   CLOB;
 66  	 l_partition_columns VARCHAR2(1000) :=
 67  	   'NOTE|SOURCE_PARTITION_NAME|SOURCE_SUBPARTITION_NAME|PARTITION_NAME|SUBPARTITION_NAME|PARTITION_HIGH_VALUE|SUBPARTITION_HIGH_VALUE|ARCHIVE_STATUS|QUALITY_STATUS|TRUNCATE_STATUS|SOURCE_ROW_COUNT|TARGET_ROW_COUNT';
 68    BEGIN
 69  	 l_execute_flag := fn_normalize_execute(p_execute);
 70  	 l_target_owner := fn_normalize_name(p_target_owner);
 71  	 l_target_table := fn_normalize_name(p_target_table_name);
 72  	 l_run_id := PKG_ARCHIVER_LOG.fn_create_run('QUALITY', NULL, NULL, NULL, l_execute_flag);
 73  	 l_log_id := PKG_ARCHIVER_LOG.fn_get_log_id(l_run_id);
 74  
 75  	 PKG_ARCHIVER_LOG.prc_log_message
 76  	 (
 77  	   p_run_id  => l_run_id,
 78  	   p_log_msg => 'Started QUALITY with parameters:' || CHR(10) ||
 79  			'  p_execute	       => ' || l_execute_flag || CHR(10) ||
 80  			'  p_target_owner      => ' || NVL(l_target_owner, '<ALL>') || CHR(10) ||
 81  			'  p_target_table_name => ' || NVL(l_target_table, '<ALL>')
 82  	 );
 83  
 84  	 l_sql :=
 85  	   'SELECT COUNT(*) ' ||
 86  	   '  FROM VW_ARCHIVER_QUALITY_PARTITIONS ' ||
 87  	   ' WHERE (:1 IS NULL OR target_owner = :1) ' ||
 88  	   '   AND (:2 IS NULL OR target_table_name = :2)';
 89  
 90  	 l_rows_available := PKG_ARCHIVER_SQL.fn_run_into_sql_in_bind
 91  	 (
 92  	   p_log_id	=> l_log_id,
 93  	   p_sql	=> l_sql,
 94  	   p_array_bind => SYS.ODCIVARCHAR2LIST(l_target_owner, l_target_table),
 95  	   p_execute	=> 'Y'
 96  	 );
 97  
 98  	 FOR t IN (
 99  	   SELECT DISTINCT source_db_link,
100  		  source_agent_schema,
101  		  source_owner,
102  		  source_table_name,
103  		  target_owner,
104  		  target_table_name
105  	     FROM VW_ARCHIVER_QUALITY_PARTITIONS
106  	    WHERE (l_target_owner IS NULL OR target_owner = l_target_owner)
107  	      AND (l_target_table IS NULL OR target_table_name = l_target_table)
108  	    ORDER BY source_db_link, source_owner, source_table_name
109  	 ) LOOP
110  	   l_tables := l_tables + 1;
111  	   l_table_summary := NULL;
112  	   l_agent_function := fn_qualified_agent_function(t.source_agent_schema, t.source_db_link);
113  	   l_sql := 'SELECT ' || l_agent_function || '(:1, :2, :3, :4) FROM dual';
114  
115  	   FOR r IN (
116  	     SELECT p.*
117  	       FROM VW_ARCHIVER_QUALITY_PARTITIONS p
118  	      WHERE p.source_db_link = t.source_db_link
119  		AND p.source_owner = t.source_owner
120  		AND p.source_table_name = t.source_table_name
121  		AND p.target_owner = t.target_owner
122  		AND p.target_table_name = t.target_table_name
123  	       ORDER BY p.partition_high_value, p.subpartition_high_value
124  	   ) LOOP
125  	     l_units := l_units + 1;
126  
127  	     l_source_rows := PKG_ARCHIVER_SQL.fn_run_into_sql_in_bind
128  	     (
129  	       p_log_id     => l_log_id,
130  	       p_sql	    => l_sql,
131  	       p_array_bind => SYS.ODCIVARCHAR2LIST
132  			       (
133  				 r.SOURCE_OWNER,
134  				 r.SOURCE_TABLE_NAME,
135  				 r.SOURCE_PARTITION_NAME,
136  				 CASE WHEN r.SOURCE_SUBPARTITION_NAME = '#' THEN NULL ELSE r.SOURCE_SUBPARTITION_NAME END
137  			       ),
138  	       p_execute    => 'Y'
139  	     );
140  
141  	     IF l_source_rows = r.TARGET_ROW_COUNT THEN
142  	       l_quality_status := 'Y';
143  	       l_ok := l_ok + 1;
144  	     ELSE
145  	       l_quality_status := 'N';
146  	       l_failed := l_failed + 1;
147  	     END IF;
148  
149  	     DBMS_OUTPUT.PUT_LINE('QUALITY ' || r.SOURCE_DB_LINK || '.' || r.SOURCE_OWNER || '.' ||
150  				  r.SOURCE_TABLE_NAME || ' source_name=' || r.SOURCE_PARTITION_NAME ||
151  				  CASE WHEN r.SOURCE_SUBPARTITION_NAME <> '#' THEN '.' || r.SOURCE_SUBPARTITION_NAME ELSE NULL END ||
152  				  ' target_name=' || r.PARTITION_NAME ||
153  				  CASE WHEN r.SUBPARTITION_NAME <> '#' THEN '.' || r.SUBPARTITION_NAME ELSE NULL END ||
154  				  ' source_rows=' || NVL(TO_CHAR(l_source_rows), 'NULL') ||
155  				  ' target_rows=' || NVL(TO_CHAR(r.TARGET_ROW_COUNT), 'NULL') ||
156  				  ' status=' || l_quality_status || ' execute=' || l_execute_flag);
157  
158  	     IF l_execute_flag = 'Y' THEN
159  	       UPDATE TBL_ARCHIVER_PARTITIONS
160  		  SET SOURCE_ROW_COUNT = l_source_rows,
161  		      QUALITY_STATUS = l_quality_status,
162  		      LAST_RUN_ID = l_run_id,
163  		      ERROR_MESSAGE = CASE
164  					WHEN l_quality_status = 'Y' THEN NULL
165  					ELSE 'Source row count does not match target row count'
166  				      END,
167  		      UPDATED_AT = SYSTIMESTAMP
168  		WHERE SOURCE_DB_LINK = r.SOURCE_DB_LINK
169  		  AND SOURCE_OWNER = r.SOURCE_OWNER
170  		  AND SOURCE_TABLE_NAME = r.SOURCE_TABLE_NAME
171  		  AND PARTITION_HIGH_VALUE = r.PARTITION_HIGH_VALUE
172  		  AND SUBPARTITION_HIGH_VALUE = r.SUBPARTITION_HIGH_VALUE;
173  
174  	       COMMIT;
175  	     END IF;
176  
177  	     l_table_summary := l_table_summary ||
178  	       TO_CLOB(PKG_ARCHIVER_LOG.fn_summary_cell(CASE WHEN l_quality_status = 'Y' THEN 'OK' ELSE 'MISMATCH' END)) || '|' ||
179  	       PKG_ARCHIVER_LOG.fn_summary_cell(r.source_partition_name) || '|' ||
180  	       PKG_ARCHIVER_LOG.fn_summary_cell(r.source_subpartition_name) || '|' ||
181  	       PKG_ARCHIVER_LOG.fn_summary_cell(r.partition_name) || '|' ||
182  	       PKG_ARCHIVER_LOG.fn_summary_cell(r.subpartition_name) || '|' ||
183  	       PKG_ARCHIVER_LOG.fn_summary_cell(r.partition_high_value) || '|' ||
184  	       PKG_ARCHIVER_LOG.fn_summary_cell(r.subpartition_high_value) || '|' ||
185  	       PKG_ARCHIVER_LOG.fn_summary_cell(r.archive_status) || '|' ||
186  	       PKG_ARCHIVER_LOG.fn_summary_cell(l_quality_status) || '|' ||
187  	       PKG_ARCHIVER_LOG.fn_summary_cell(r.truncate_status) || '|' ||
188  	       PKG_ARCHIVER_LOG.fn_summary_cell(TO_CHAR(l_source_rows)) || '|' ||
189  	       PKG_ARCHIVER_LOG.fn_summary_cell(TO_CHAR(r.target_row_count)) || CHR(10);
190  	   END LOOP; -- FOR r
191  
192  	   IF l_table_summary IS NOT NULL THEN
193  	     l_summary := l_summary ||
194  	       '=== TABLE: ' || t.source_db_link || '.' || t.source_owner || '.' || t.source_table_name || ' ===' || CHR(10) || CHR(10) ||
195  	       PKG_ARCHIVER_SQL.fn_format_table(
196  		 p_columns => 'SOURCE_DB_LINK|TABLE_OWNER|TABLE_NAME|EXECUTE',
197  		 p_rows    => PKG_ARCHIVER_LOG.fn_summary_cell(t.source_db_link) || '|' ||
198  			      PKG_ARCHIVER_LOG.fn_summary_cell(t.source_owner) || '|' ||
199  			      PKG_ARCHIVER_LOG.fn_summary_cell(t.source_table_name) || '|' ||
200  			      PKG_ARCHIVER_LOG.fn_summary_cell(l_execute_flag) || CHR(10)
201  	       ) || CHR(10) ||
202  	       PKG_ARCHIVER_SQL.fn_format_table(
203  		 p_columns    => l_partition_columns,
204  		 p_rows       => l_table_summary
205  	       ) || CHR(10);
206  	   END IF;
207  	 END LOOP; -- FOR t
208  
209  	 DBMS_OUTPUT.PUT_LINE(
210  	   'QUALITY tables=' || l_tables ||
211  	   ' units=' || l_units ||
212  	   ' found=' || l_rows_available ||
213  	   ' ok=' || l_ok ||
214  	   ' failed=' || l_failed ||
215  	   ' target_owner=' || NVL(l_target_owner, '<ALL>') ||
216  	   ' target_table=' || NVL(l_target_table, '<ALL>') ||
217  	   ' execute=' || l_execute_flag
218  	 );
219  
220  	 IF l_summary IS NOT NULL THEN
221  	   PKG_ARCHIVER_LOG.prc_log_message(l_run_id, l_summary, 'SUMMARY');
222  	 END IF;
223  
224  	 PKG_ARCHIVER_LOG.prc_finish_run(l_run_id, CASE WHEN l_failed > 0 THEN 'WARNING' ELSE 'SUCCESS' END);
225    EXCEPTION
226  	 WHEN OTHERS THEN
227  	   IF l_run_id IS NOT NULL THEN
228  	     PKG_ARCHIVER_LOG.prc_log_error_stack(l_run_id);
229  	     PKG_ARCHIVER_LOG.prc_finish_run(l_run_id, 'ERROR', SQLERRM);
230  	   END IF;
231  	   RAISE;
232    END prc_quality;
233  END PKG_ARCHIVER_QUALITY;
234  /

