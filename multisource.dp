SQL> DECLARE
  2    l_quality_failures	 PLS_INTEGER;
  3    l_invalid_source_links PLS_INTEGER;
  4    l_invalid_run_links	 PLS_INTEGER;
  5    l_invalid_objects	 PLS_INTEGER;
  6    l_target_rows	      PLS_INTEGER;
  7  BEGIN
  8    SELECT COUNT(*)
  9  	 INTO l_quality_failures
 10  	 FROM TBL_REPLICA_PARTITIONS
 11  	WHERE source_db_link = UPPER('&1')
 12  	  AND replica_status = 'Y'
 13  	  AND quality_status <> 'Y';
 14  
 15    SELECT COUNT(*)
 16  	 INTO l_invalid_source_links
 17  	 FROM TBL_REPLICA_TABLES t
 18  	WHERE t.source_db_link IS NULL
 19  	   OR UPPER(TRIM(t.source_db_link)) IN ('LOCAL', 'NONE')
 20  	   OR NOT EXISTS (
 21  		SELECT 1
 22  		  FROM USER_DB_LINKS l
 23  		 WHERE l.DB_LINK = UPPER(TRIM(t.source_db_link))
 24  	      );
 25  
 26    SELECT COUNT(*)
 27  	 INTO l_invalid_run_links
 28  	 FROM TBL_REPLICA_RUNS r
 29  	WHERE r.source_db_link IS NULL
 30  	   OR UPPER(TRIM(r.source_db_link)) IN ('LOCAL', 'NONE')
 31  	   OR NOT EXISTS (
 32  		SELECT 1
 33  		  FROM USER_DB_LINKS l
 34  		 WHERE l.DB_LINK = UPPER(TRIM(r.source_db_link))
 35  	      );
 36  
 37    SELECT COUNT(*)
 38  	 INTO l_invalid_objects
 39  	 FROM USER_OBJECTS
 40  	WHERE status <> 'VALID';
 41  
 42    SELECT COUNT(*)
 43  	 INTO l_target_rows
 44  	 FROM TBL_REPLICA_ORDERS_SRC;
 45  
 46    IF l_quality_failures <> 0 THEN
 47  	 RAISE_APPLICATION_ERROR(-20062, 'REPLICA smoke quality failures: ' || l_quality_failures);
 48    ELSIF l_invalid_source_links <> 0 THEN
 49  	 RAISE_APPLICATION_ERROR(-20063, 'REPLICA smoke invalid source DB links: ' || l_invalid_source_links);
 50    ELSIF l_invalid_run_links <> 0 THEN
 51  	 RAISE_APPLICATION_ERROR(-20066, 'REPLICA smoke invalid run DB links: ' || l_invalid_run_links);
 52    ELSIF l_invalid_objects <> 0 THEN
 53  	 RAISE_APPLICATION_ERROR(-20064, 'REPLICA smoke invalid objects: ' || l_invalid_objects);
 54    ELSIF l_target_rows = 0 THEN
