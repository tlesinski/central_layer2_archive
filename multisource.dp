 37  	tablespace_name, last_business_date, days_online, enabled_flag)
 38  VALUES
 39    (src.source_db_link, src.source_owner, src.source_table_name, src.source_agent_schema,
 40  	src.target_owner, src.target_table_name, src.truncate_mode, src.parallel_degree,
 41  	src.tablespace_name, src.last_business_date, src.days_online, src.enabled_flag);

