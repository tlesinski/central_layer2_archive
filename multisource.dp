SQL> @layer3_replica/packages/pkg_replica_tl_logging.spec.sql
SQL> CREATE OR REPLACE EDITIONABLE PACKAGE PKG_REPLICA_TL_LOGGING --AUTHID CURRENT_USER
  2  authid current_user
  3  AS
  4  
  5    /*
  6  	 Package      : PKG_REPLICA_TL_LOGGING
  7  	 Developer    : Tomasz Lesinski
  8  	 Date	      : 2020-02-24
  9  	 Purpose      : Logging package
 10  
 11  	 Prerequisite : TBL_REPLICA_PROCESS_LOG, REPLICA_PROCESS_LOG_SEQ
 12  
 13  	 Change History:
 14  	 ------------------------------------------------------------------------------
 15  	 Version    Date	 Programmer	    Description
 16  	 ------------------------------------------------------------------------------
 17  	 1.0	    2020-02-20	 Tomasz Lesinski    Initial version
 18  	 2.0	    2021-12-01	 Tomasz Lesinski    Simplification
 19  	  2.1	     2022-11-04   Tomasz Lesinski    JSON column support
 20  	  2.2	     2026-05-31   Tomasz Lesinski    ORA-40478 fix: manual JSON for large CLOB messages
 21    */
 22  
 23  -- global variables
 24  
 25  g_lang_const CONSTANT VARCHAR2(30) := 'english';
 26  
 27  g_timestamp_formt_const CONSTANT VARCHAR2(30) := 'DD-MM-YYYY HH24:MI:SSXFF';
 28  g_date_formt_const CONSTANT VARCHAR2(30) := 'DD-MM-YYYY HH24:MI:SS';
 29  g_short_date_formt_const CONSTANT VARCHAR2(30) := 'DD-MM-YYYY';
 30  
 31  g_sttus_init_const CONSTANT VARCHAR2(30) := 'INIT';
 32  g_sttus_executing_const CONSTANT VARCHAR2(30) := 'EXECUTING';
 33  g_sttus_warning_const CONSTANT VARCHAR2(30) := 'WARNING';
 34  g_sttus_success_const CONSTANT VARCHAR2(30) := 'SUCCESS';
 35  g_sttus_error_const CONSTANT VARCHAR2(30) := 'ERROR';
 36  g_sttus_running_const CONSTANT VARCHAR2(30) := 'RUNNING';
 37  g_sttus_undefined_const CONSTANT VARCHAR2(30) := 'UNDEFINED';
 38  
 39  g_err_sev_low_const CONSTANT VARCHAR2(10) := 'LOW';
 40  g_err_sev_med_const CONSTANT VARCHAR2(10) := 'MEDIUM';
 41  g_err_sev_hig_const CONSTANT VARCHAR2(10) := 'HIGH';
 42  
 43  --Can be set to Y if there is a need for writing log entries of type debug during the next execution.
 44  --'N' normal mode 'D' debug mode
 45  g_log_lvl VARCHAR2(10) := 'N';
 46  
 47  --How many days should the log be stored. Used by prc_log_cleanup_table.
 48  g_log_retention_days NUMBER := 90;
 49  
 50  --The name of log table.
 51  g_log_table_name VARCHAR2(128) := 'TBL_REPLICA_PROCESS_LOG';
 52  
 53  --The name of sequence used for PK.
 54  g_log_sequence_name VARCHAR2(128) := 'REPLICA_PROCESS_LOG_SEQ';
 55  
 56  g_curr_schema_name VARCHAR2(128);
 57  
 58    --Procedure prc_log
 59    -- base logging message
 60  
 61    -- Parameters:
 62    -- p_log_id log_id of entry to be inserted or updated
 63    -- p_log_msg message to save (the only required parameter)
 64    -- p_log_lvl logging level 'N' - normal default | 'D' - debug level
 65    -- p_mstr_log_id mstr_log_id (group id) of entry to be inserted or updated
 66    -- p_log_categ log category description
 67    -- p_mstr_fun log function name
 68    -- p_log_sttus status of process execution
 69    -- p_start_date process start date
 70    -- p_end_date process end date
 71    -- p_last_err_code ORA error number
 72    -- p_last_err_desc error description
 73  
 74    -- Example use #1:
 75    -- PKG_REPLICA_TL_LOGGING.prc_log( p_log_msg => 'log message');
 76    --
 77    -- Example use #2:
 78    -- DECLARE
 79    -- l_log_id NUMBER := REPLICA_PROCESS_LOG_SEQ.nextval;
 80    -- BEGIN
 81    -- PKG_REPLICA_TL_LOGGING.prc_log
 82    -- (
 83    -- p_log_id => l_log_id,
 84    -- p_log_categ => 'load dimensions',
 85    -- p_mstr_fun => 'prc_load_time_dim',
 86    -- p_log_sttus => PKG_REPLICA_TL_LOGGING.g_sttus_init_const,
 87    -- p_start_date => SYSDATE,
 88    -- p_log_msg => 'init message'
 89    -- );
 90    -- END;
 91  
 92    PROCEDURE prc_log
 93    (
 94  	 p_log_id IN NUMBER,
 95  	 p_log_msg IN CLOB,
 96  	 p_log_lvl IN VARCHAR2 DEFAULT 'N',
 97  	 p_mstr_log_id IN NUMBER DEFAULT NULL,
 98  	 p_log_categ IN VARCHAR2 DEFAULT NULL,
 99  	 p_mstr_fun IN VARCHAR2 DEFAULT NULL,
100  	 p_log_sttus IN VARCHAR2 DEFAULT NULL,
101  	 p_start_date IN DATE DEFAULT NULL,
102  	 p_end_date IN DATE DEFAULT NULL,
103  	 p_last_err_code IN VARCHAR2 DEFAULT NULL,
104  	 p_last_err_desc IN VARCHAR2 DEFAULT NULL,
105  	 p_log_type IN VARCHAR2 DEFAULT 'TEXT'
106    );
107  
108  --Procedure prc_error_stack
109  -- Dumps oracle stack into table MD_PRCSS_LOG if error occurs.
110  -- All parameters are optional. If log_id is used stack will be
111  -- printed in auto log and passed log_id entry.
112  
113  -- Parameters:
114  -- p_log_id log_id
115  -- p_proc_name procedure name
116  -- p_mstr_log_id used for custom logging entries (not auto)
117  
118  PROCEDURE prc_error_stack
119  (
120  p_log_id IN NUMBER,
121  p_mstr_log_id IN NUMBER DEFAULT NULL
122  );
123  END PKG_REPLICA_TL_LOGGING;
124  /

Package created.

SQL> @layer3_replica/packages/pkg_replica_tl_logging.body.sql
SQL> CREATE OR REPLACE EDITIONABLE PACKAGE BODY PKG_REPLICA_TL_LOGGING AS
  2  
  3    /*
  4  	 Package      : PKG_REPLICA_TL_LOGGING
  5  	 Developer    : Tomasz Lesinski
  6  	 Date	      : 2020-02-24
  7  	 Purpose      : Logging package
  8  
  9  	 Prerequisite : TBL_REPLICA_PROCESS_LOG, REPLICA_PROCESS_LOG_SEQ
 10  
 11  	 Change History:
 12  	 ------------------------------------------------------------------------------
 13  	 Version    Date	 Programmer	    Description
 14  	 ------------------------------------------------------------------------------
 15  	 1.0	    2020-02-20	 Tomasz Lesinski    Initial version
 16  	 2.0	    2021-12-01	 Tomasz Lesinski    Simplification
 17  	  2.1	     2022-11-04   Tomasz Lesinski    JSON column support
 18  	  2.2	     2026-05-31   Tomasz Lesinski    ORA-40478 fix: manual JSON for large CLOB messages
 19    */
 20  
 21  --Procedure prc_init_log just pre declaration
 22  
 23  PROCEDURE prc_init_log
 24  (
 25  p_force IN VARCHAR2 DEFAULT 'N'
 26  );
 27  
 28  PROCEDURE prc_log_cleanup_table;
 29  
 30  FUNCTION fn_generate_json_log
 31  (
 32    p_log_msg	  IN CLOB,
 33    p_log_type	  IN VARCHAR2,
 34    p_log_date	  IN VARCHAR2
 35  )
 36  RETURN CLOB
 37  IS
 38    l_json_entry CLOB;
 39  BEGIN
 40    -- JSON_OBJECT does not accept CLOB values larger than 32767.
 41    -- Build JSON manually via CLOB concatenation for safety.
 42    l_json_entry := TO_CLOB('{"type":"') || p_log_type ||
 43  		       TO_CLOB('","timestamp":"') || p_log_date ||
 44  		       TO_CLOB('","message":"') ||
 45  		       REPLACE(REPLACE(REPLACE(p_log_msg, '\', '\\'), '"', '\"'), CHR(10), '\n') ||
 46  		       TO_CLOB('"}');
 47  
 48    -- Wrap log entry within "log_entries" array to support multiple entries
 49    RETURN l_json_entry;
 50  END fn_generate_json_log;
 51  
 52  --Procedure prc_log
 53  -- base logging message
 54  
 55  PROCEDURE prc_log
 56  (
 57    p_log_id	  IN NUMBER,
 58    p_log_msg	  IN CLOB,
 59    p_log_lvl	  IN VARCHAR2 DEFAULT 'N',
 60    p_mstr_log_id   IN NUMBER DEFAULT NULL,
 61    p_log_categ	  IN VARCHAR2 DEFAULT NULL,
 62    p_mstr_fun	  IN VARCHAR2 DEFAULT NULL,
 63    p_log_sttus	  IN VARCHAR2 DEFAULT NULL,
 64    p_start_date	  IN DATE DEFAULT NULL,
 65    p_end_date	  IN DATE DEFAULT NULL,
 66    p_last_err_code IN VARCHAR2 DEFAULT NULL,
 67    p_last_err_desc IN VARCHAR2 DEFAULT NULL,
 68    p_log_type	  IN VARCHAR2 DEFAULT 'TEXT'
 69  )
 70  IS
 71    PRAGMA autonomous_transaction;
 72    l_curr_schema VARCHAR2(128) := sys_context('USERENV', 'CURRENT_SCHEMA');
 73    l_today	     VARCHAR2(10)  := TO_CHAR(SYSDATE, 'YYYYMMDD');
 74    l_log_categ	VARCHAR2(128);
 75    l_msg	     CLOB;
 76    l_msg_json	CLOB;
 77    l_sysdate	VARCHAR2(64);
 78    l_sql	     CLOB;
 79    l_mstr_log_id NUMBER;
 80    l_log_id	NUMBER;
 81  BEGIN
 82    l_sysdate := to_char(SYSDATE, g_date_formt_const, 'nls_date_language = ''' || g_lang_const || '''' );
 83  
 84    --daily log categ
 85    l_log_categ := 'LOG_' || l_curr_schema || '_' || l_today ||'.log';
 86  
 87    l_msg := to_clob(chr(10) || l_sysdate || ' | ' ) || p_log_msg || to_clob(chr(10));
 88  
 89    l_msg_json := fn_generate_json_log(p_log_msg => p_log_msg, p_log_date => l_sysdate, p_log_type => p_log_type);
 90  
 91    IF p_log_lvl = 'N' OR ( p_log_lvl = 'D' AND g_log_lvl = 'D' ) THEN
 92  	 IF p_log_id IS NOT NULL THEN
 93  	   l_log_id := 0;
 94  
 95  	   l_sql := 'MERGE INTO ' || g_log_table_name || q'! a
 96  	   USING
 97  	   (
 98  	     SELECT
 99  		nvl(:p_mstr_log_id, :p_log_id)	      AS mstr_log_id
100  	       ,:p_log_id			      AS log_id
101  	       ,:p_log_categ			      AS log_categ
102  	       ,:p_mstr_fun			      AS mstr_fun
103  	       ,:p_log_sttus			      AS log_sttus
104  	       ,:p_start_date			      AS start_date
105  	       ,:p_end_date			      AS end_date
106  	       ,:p_log_msg			      AS log_msg
107  	       ,:p_log_json			      AS log_json
108  	       ,:p_last_err_code		      AS last_err_code
109  	       ,:p_last_err_desc		      AS last_err_desc
110  	       ,sys_context('userenv','instance')     AS inst_id
111  	       ,sys_context('userenv','sid')	      AS sid
112  	       ,sys_context('userenv','sessionid')    AS serial#
113  	       ,sys_context('userenv','client_info')  AS client_info
114  	       ,sys_context('userenv','module')       AS module
115  	     FROM dual
116  	   ) b
117  	   ON
118  	   (
119  	     a.mstr_log_id = b.mstr_log_id
120  	     AND a.log_id = b.log_id
121  	   )
122  	   WHEN MATCHED THEN
123  	     UPDATE
124  	     SET
125  	       a.log_categ     = nvl(b.log_categ, a.log_categ),
126  	       a.mstr_fun      = nvl(b.mstr_fun, a.mstr_fun),
127  	       a.log_sttus     = nvl(b.log_sttus, a.log_sttus),
128  	       a.start_date    = nvl(b.start_date, a.start_date),
129  	       a.end_date      = nvl(b.end_date, a.end_date),
130  	       a.log_msg       = a.log_msg || b.log_msg,
131  	       a.log_json      = rtrim(a.log_json,']') || to_clob(',') || b.log_json ||to_clob(']'),
132  	       a.last_err_code = nvl(b.last_err_code, a.last_err_code),
133  	       a.last_err_desc = nvl(b.last_err_desc, a.last_err_desc),
134  	       a.last_updt_dt  = SYSDATE,
135  	       a.last_updt_by  = sys_context('USERENV','SESSION_USER')
136  	   WHEN NOT MATCHED THEN
137  	     INSERT
138  	     (
139  		mstr_log_id
140  	       ,log_id
141  	       ,log_categ
142  	       ,mstr_fun
143  	       ,log_sttus
144  	       ,start_date
145  	       ,end_date
146  	       ,log_msg
147  	       ,log_json
148  	       ,last_err_code
149  	       ,last_err_desc
150  	       ,inst_id
151  	       ,sid
152  	       ,serial#
153  	       ,client_info
154  	       ,module
155  	       ,crtn_dt
156  	       ,crtn_by
157  	       ,last_updt_dt
158  	       ,last_updt_by
159  	     )
160  	     VALUES
161  	     (
162  		b.mstr_log_id
163  	       ,b.log_id
164  	       ,b.log_categ
165  	       ,b.mstr_fun
166  	       ,nvl(b.log_sttus, :g_sttus_undefined_const)
167  	       ,nvl(b.start_date, SYSDATE)
168  	       ,b.end_date
169  	       ,b.log_msg
170  	       ,to_clob('[')||b.log_json||to_clob(']')
171  	       ,b.last_err_code
172  	       ,b.last_err_desc
173  	       ,b.inst_id
174  	       ,b.sid
175  	       ,b.serial#
176  	       ,b.client_info
177  	       ,b.module
178  	       ,SYSDATE
179  	       ,sys_context('USERENV','SESSION_USER')
180  	       ,SYSDATE
181  	       ,sys_context('USERENV','SESSION_USER')
182  	     )!';
183  
184  	   BEGIN
185  	     EXECUTE IMMEDIATE l_sql
186  	     USING
187  		p_mstr_log_id
188  	       ,p_log_id
189  	       ,p_log_id
190  	       ,p_log_categ
191  	       ,p_mstr_fun
192  	       ,p_log_sttus
193  	       ,p_start_date
194  	       ,p_end_date
195  	       ,l_msg
196  	       ,l_msg_json
197  	       ,p_last_err_code
198  	       ,p_last_err_desc
199  	       ,PKG_REPLICA_TL_LOGGING.g_sttus_undefined_const;
200  
201  	     COMMIT;
202  	   EXCEPTION
203  	     WHEN OTHERS THEN
204  	       prc_init_log( p_force => 'Y' );
205  
206  	       EXECUTE IMMEDIATE l_sql
207  	       USING
208  		  p_mstr_log_id
209  		 ,p_log_id
210  		 ,p_log_id
211  		 ,p_log_categ
212  		 ,p_mstr_fun
213  		 ,p_log_sttus
214  		 ,p_start_date
215  		 ,p_end_date
216  		 ,l_msg
217  		 ,l_msg_json
218  		 ,p_last_err_code
219  		 ,p_last_err_desc
220  		 ,PKG_REPLICA_TL_LOGGING.g_sttus_undefined_const;
221  
222  	       COMMIT;
223  	   END;
224  	 END IF;
225    END IF;
226  END prc_log;
227  
228  --Procedure prc_error_stack
229  -- dumps oracle stack if error occures into table MD_PRCSS_LOG
230  
231    PROCEDURE prc_error_stack
232    (
233  	 p_log_id IN NUMBER,
234  	 p_mstr_log_id IN NUMBER DEFAULT NULL
235    )
236    IS
237  	 l_sqlcode NUMBER;
238  	 l_sqlerrm VARCHAR2(255);
239  	 l_message CLOB;
240    BEGIN
241  	 l_sqlcode := sqlcode;
242  	 l_sqlerrm := substr(SQLERRM, 1, 255);
243  
244  	 l_message := chr(10) ||
245  	   '===================================================================' || chr(10) ||
246  	   ' SQLCODE:	      ' || l_sqlcode					 || chr(10) ||
247  	   ' SQLERRM:	      ' || l_sqlerrm					 || chr(10) ||
248  	   '===================================================================' || CHR(10) ||
249  	   ' Call stack:      ' || dbms_utility.format_call_stack()		 || CHR(10) ||
250  	   '===================================================================' || chr(10) ||
251  	   ' Error stack:     ' || dbms_utility.format_error_stack()		 || CHR(10) ||
252  	   '===================================================================' || CHR(10) ||
253  	   ' Error backtrace: ' || dbms_utility.format_error_backtrace		 || CHR(10) ||
254  	   '===================================================================';
255  
256  	 dbms_output.put_line(l_message);
257  
258  	 prc_log
259  	 (
260  	   p_mstr_log_id    => p_mstr_log_id,
261  	   p_log_id	    => p_log_id,
262  	   p_log_sttus	    => PKG_REPLICA_TL_LOGGING.g_sttus_error_const,
263  	   p_end_date	    => SYSDATE,
264  	   p_log_msg	    => l_message,
265  	   p_last_err_code  => l_sqlcode,
266  	   p_last_err_desc  => l_sqlerrm,
267  	   p_log_type	    => 'ERROR'
268  	 );
269    END prc_error_stack;
270  
271  -- creates local log table TBL_REPLICA_PROCESS_LOG
272  -- and local log sequence REPLICA_PROCESS_LOG_SEQ
273  
274  PROCEDURE prc_log_create_table
275  IS
276  l_check NUMBER;
277  l_sql CLOB;
278  l_proc_name VARCHAR2(128) := 'prc_log_create_table';
279  BEGIN
280  --------------------------------------------
281  --create local log table g_log_table_name
282  --------------------------------------------
283  SELECT COUNT(*)
284  INTO l_check
285  FROM user_tables
286  WHERE table_name = g_log_table_name;
287  
288  SELECT COUNT(*)
289    INTO l_check
290  FROM (
291    SELECT 1
292  	 FROM user_tables
293  	WHERE table_name = g_log_table_name
294  	UNION ALL
295    SELECT 1
296  	 FROM user_synonyms
297  	WHERE synonym_name = g_log_table_name
298  );
299  
300  IF l_check = 0 THEN
301    dbms_output.put_line('Try to create log table ' || g_log_table_name);
302  
303    l_sql := q'!CREATE TABLE "TBL_REPLICA_PROCESS_LOG"
304  
305  ( "MSTR_LOG_ID" NUMBER NOT NULL ENABLE,
306  "LOG_ID" NUMBER NOT NULL ENABLE,
307  "LOG_CATEG" VARCHAR2(256 BYTE),
308  "MSTR_FUN" VARCHAR2(128 BYTE),
309  "LOG_STTUS" VARCHAR2(30 BYTE) NOT NULL ENABLE,
310  "START_DATE" DATE,
311  "END_DATE" DATE,
312  "INTERVAL_TIME" INTERVAL DAY (2) TO SECOND (6) GENERATED ALWAYS AS (NUMTODSINTERVAL("END_DATE"-"START_DATE",'DAY')) VIRTUAL ,
313  "LOG_MSG" CLOB NOT NULL ENABLE,
314  "LOG_JSON" CLOB,
315  "LAST_ERR_CODE" VARCHAR2(30 BYTE),
316  "LAST_ERR_DESC" VARCHAR2(256 BYTE),
317  "INST_ID" NUMBER,
318  "SID" NUMBER,
319  "SERIAL#" NUMBER,
320  "CLIENT_INFO" VARCHAR2(128 BYTE),
321  "MODULE" VARCHAR2(128 BYTE),
322  "CRTN_DT" DATE DEFAULT SYSDATE NOT NULL ENABLE,
323  "CRTN_BY" VARCHAR2(128 BYTE) DEFAULT sys_context('USERENV','SESSION_USER') NOT NULL ENABLE,
324  "LAST_UPDT_DT" DATE DEFAULT SYSDATE NOT NULL ENABLE,
325  "LAST_UPDT_BY" VARCHAR2(128 BYTE) DEFAULT sys_context('USERENV','SESSION_USER') NOT NULL ENABLE
326  )
327  PARTITION BY RANGE ("START_DATE") INTERVAL (NUMTOYMINTERVAL(1, 'MONTH'))
328  (PARTITION "P_START" VALUES LESS THAN (TO_DATE(' 2019-01-01 00:00:00', 'SYYYY-MM-DD HH24:MI:SS', 'NLS_CALENDAR=GREGORIAN')) )!';
329  
330  EXECUTE IMMEDIATE l_sql;
331  
332  l_sql := 'CREATE INDEX "TBL_REPLICA_PROCESS_LOG_IDX1" ON "TBL_REPLICA_PROCESS_LOG" ("MSTR_LOG_ID", "LOG_ID") LOCAL';
333  
334    EXECUTE IMMEDIATE l_sql;
335  ELSE
336    dbms_output.put_line('Local log table ' || g_log_table_name || ' or synonym already exists');
337  END IF;
338  
339  --------------------------------------------
340  --create local log sequence g_log_sequence_name
341  --------------------------------------------
342  SELECT COUNT(*)
343    INTO l_check
344  FROM (
345    SELECT 1
346  	 FROM user_sequences
347  	WHERE sequence_name = g_log_sequence_name
348  	UNION ALL
349    SELECT 1
350  	 FROM user_synonyms
351  	WHERE synonym_name = g_log_sequence_name
352  );
353  
354  IF l_check = 0 THEN
355    dbms_output.put_line('Try to create log sequence ' || g_log_sequence_name);
356  
357    l_sql := 'CREATE SEQUENCE REPLICA_PROCESS_LOG_SEQ START WITH 1 INCREMENT BY 1';
358  
359    EXECUTE IMMEDIATE l_sql;
360  ELSE
361    dbms_output.put_line('Local log sequence ' || g_log_sequence_name || ' or synonym already exists');
362  END IF;
363  
364  prc_log_cleanup_table;
365  
366  EXCEPTION
367  WHEN OTHERS THEN
368  prc_error_stack(p_log_id=>null);
369  
370    raise_application_error( -20001, 'Creation of local log table ' || g_log_table_name || chr(10) ||
371  					' or sequence ' || g_log_sequence_name || chr(10) ||
372  					' failed turn on serveroutput to get more info' );
373  
374  END prc_log_create_table;
375  
376  --Procedure prc_init_log
377  -- initializes log in physical file and in TBL_REPLICA_PROCESS_LOG table
378  
379  PROCEDURE prc_init_log
380  (
381  p_force IN VARCHAR2 DEFAULT 'N'
382  )
383  IS
384  l_check NUMBER;
385  BEGIN
386  dbms_output.put_line('prc_init_log');
387  
388  IF g_curr_schema_name IS NULL OR p_force = 'Y' THEN
389    g_curr_schema_name := sys_context('USERENV', 'CURRENT_SCHEMA');
390  
391    prc_log_create_table;
392  END IF;
393  
394  END prc_init_log;
395  
396  -- cleanup old partitions in table TBL_REPLICA_PROCESS_LOG
397  
398  PROCEDURE prc_log_cleanup_table
399  IS
400  l_proc_name VARCHAR2(128) := 'prc_log_cleanup_table';
401  l_long VARCHAR2(4000);
402  l_interval_date DATE;
403  l_partition_date DATE;
404  l_sql CLOB;
405  BEGIN
406  dbms_output.put_line
407  (
408  'Calling procedure ' || $$plsql_unit|| '.' || l_proc_name
409  );
410  
411  l_interval_date := (SYSDATE - ABS(g_log_retention_days));
412  
413  dbms_output.put_line
414  (
415    'Drop partitions for table ' || g_log_table_name || chr(10) ||
416    '  older than ' || g_log_retention_days || ' days' || chr(10) ||
417    '  older than ' || to_char( l_interval_date, g_date_formt_const )
418  );
419  
420  FOR i IN ( SELECT table_name, partition_name, high_value
421  		  FROM user_tab_partitions
422  		 WHERE table_name = g_log_table_name
423  		   AND partition_name != 'P_START'
424  		 ORDER BY partition_position )
425  LOOP
426    --convert partition high_value long to date;
427    l_long := i.high_value;
428  
429    EXECUTE IMMEDIATE 'SELECT ' || l_long || ' FROM dual' INTO l_partition_date;
430  
431    IF l_interval_date > l_partition_date THEN
432  	 l_sql := 'ALTER TABLE ' || i.table_name || ' DROP PARTITION ' || i.partition_name;
433  
434  	 dbms_output.put_line
435  	 (
436  	   'Partition ' || i.partition_name || ' high_value ' || to_char( l_partition_date, g_date_formt_const ) || chr(10) ||
437  	   ' older than ' || to_char( l_interval_date, g_date_formt_const ) || chr(10) ||
438  	   ' to drop: ' || l_sql
439  	 );
440  
441  	 EXECUTE IMMEDIATE l_sql;
442    END IF;
443  END LOOP;
444  
445  dbms_output.put_line
446  (
447    'Completed procedure ' || $$plsql_unit || '.' || l_proc_name
448  );
449  
450  EXCEPTION
451  WHEN OTHERS THEN
452  dbms_output.put_line('Error cleaning log table ' || SQLCODE || substr(SQLERRM, 1, 200));
453  END prc_log_cleanup_table;
454  BEGIN
455  
456  --calling base procedure to intialize entries in TBL_REPLICA_PROCESS_LOG table and file with directories
457  
458  prc_init_log;
459  END PKG_REPLICA_TL_LOGGING;
460  /

