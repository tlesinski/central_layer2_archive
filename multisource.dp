 17    FROM VW_ARCHIVER_SOURCE_PARTITIONS s
 18   WHERE NOT EXISTS (
 19  	    SELECT 1
 20  	      FROM TBL_ARCHIVER_PARTITIONS p
 21  	     WHERE p.source_db_link = s.source_db_link
 22  	       AND p.source_owner = s.source_owner
 23  	       AND p.source_table_name = s.source_table_name
 24  	       AND p.partition_high_value = s.partition_high_value
 25  	       AND p.subpartition_high_value = s.subpartition_high_value
 26  	    );

