 12  	 Change History:
 13  	 ------------------------------------------------------------------------------
 14  	 Version    Date	 Programmer	    Description
 15  	 ------------------------------------------------------------------------------
 16  	  1.0	     2026-06-01   Tomasz Lesinski    Initial version
 17    */
 18    PROCEDURE prc_replicate
 19    (
 20  	 p_execute	     IN VARCHAR2 DEFAULT 'N',
 21  	 p_target_owner      IN VARCHAR2 DEFAULT NULL,
 22  	 p_target_table_name IN VARCHAR2 DEFAULT NULL
 23    );
 24  END PKG_REPLICA_REPLICATE;
