  5    /*
  6  	 Package      : PKG_REPLICA_TL_LOGGING
  7  	 Developer    : Tomasz Lesinski
  8  	 Date	      : 2020-02-24
  9  	 Purpose      : Logging package
 10  
 11  	 Prerequisite : TBL_REPLICA_PROCESS_LOG, REPLICA_PROCESS_LOG_SEQ
 12  
 13  	 Change History:
 14  	 ------------------------------------------------------------------------------
 15  	 Version    Date	 Programmer	    Description
 16  	 ------------------------------------------------------------------------------
 17  	 1.0	    2020-02-20	 Tomasz Lesinski    Initial version
 18  	 2.0	    2021-12-01	 Tomasz Lesinski    Simplification
 19  	  2.1	     2022-11-04   Tomasz Lesinski    JSON column support
 20  	  2.2	     2026-05-31   Tomasz Lesinski    ORA-40478 fix: manual JSON for large CLOB messages
 21    */
 22  
 23  -- global variables
 24  
 25  g_lang_const CONSTANT VARCHAR2(30) := 'english';
 26  
 27  g_timestamp_formt_const CONSTANT VARCHAR2(30) := 'DD-MM-YYYY HH24:MI:SSXFF';
 28  g_date_formt_const CONSTANT VARCHAR2(30) := 'DD-MM-YYYY HH24:MI:SS';
 29  g_short_date_formt_const CONSTANT VARCHAR2(30) := 'DD-MM-YYYY';
 30  
 31  g_sttus_init_const CONSTANT VARCHAR2(30) := 'INIT';
 32  g_sttus_executing_const CONSTANT VARCHAR2(30) := 'EXECUTING';
 33  g_sttus_warning_const CONSTANT VARCHAR2(30) := 'WARNING';
 34  g_sttus_success_const CONSTANT VARCHAR2(30) := 'SUCCESS';
 35  g_sttus_error_const CONSTANT VARCHAR2(30) := 'ERROR';
 36  g_sttus_running_const CONSTANT VARCHAR2(30) := 'RUNNING';
 37  g_sttus_undefined_const CONSTANT VARCHAR2(30) := 'UNDEFINED';
 38  
 39  g_err_sev_low_const CONSTANT VARCHAR2(10) := 'LOW';
 40  g_err_sev_med_const CONSTANT VARCHAR2(10) := 'MEDIUM';
 41  g_err_sev_hig_const CONSTANT VARCHAR2(10) := 'HIGH';
 42  
 43  --Can be set to Y if there is a need for writing log entries of type debug during the next execution.
 44  --'N' normal mode 'D' debug mode
 45  g_log_lvl VARCHAR2(10) := 'N';
 46  
 47  --How many days should the log be stored. Used by prc_log_cleanup_table.
 48  g_log_retention_days NUMBER := 90;
 49  
 50  --The name of log table.
 51  g_log_table_name VARCHAR2(128) := 'TBL_REPLICA_PROCESS_LOG';
 52  
 53  --The name of sequence used for PK.
 54  g_log_sequence_name VARCHAR2(128) := 'REPLICA_PROCESS_LOG_SEQ';
 55  
 56  g_curr_schema_name VARCHAR2(128);
 57  
 58    --Procedure prc_log
 59    -- base logging message
 60  
 61    -- Parameters:
 62    -- p_log_id log_id of entry to be inserted or updated
 63    -- p_log_msg message to save (the only required parameter)
 64    -- p_log_lvl logging level 'N' - normal default | 'D' - debug level
 65    -- p_mstr_log_id mstr_log_id (group id) of entry to be inserted or updated
 66    -- p_log_categ log category description
 67    -- p_mstr_fun log function name
 68    -- p_log_sttus status of process execution
 69    -- p_start_date process start date
 70    -- p_end_date process end date
 71    -- p_last_err_code ORA error number
 72    -- p_last_err_desc error description
 73  
 74    -- Example use #1:
 75    -- PKG_REPLICA_TL_LOGGING.prc_log( p_log_msg => 'log message');
 76    --
 77    -- Example use #2:
 78    -- DECLARE
 79    -- l_log_id NUMBER := REPLICA_PROCESS_LOG_SEQ.nextval;
 80    -- BEGIN
 81    -- PKG_REPLICA_TL_LOGGING.prc_log
 82    -- (
 83    -- p_log_id => l_log_id,
 84    -- p_log_categ => 'load dimensions',
 85    -- p_mstr_fun => 'prc_load_time_dim',
 86    -- p_log_sttus => PKG_REPLICA_TL_LOGGING.g_sttus_init_const,
 87    -- p_start_date => SYSDATE,
 88    -- p_log_msg => 'init message'
 89    -- );
 90    -- END;
 91  
 92    PROCEDURE prc_log
 93    (
 94  	 p_log_id IN NUMBER,
 95  	 p_log_msg IN CLOB,
 96  	 p_log_lvl IN VARCHAR2 DEFAULT 'N',
 97  	 p_mstr_log_id IN NUMBER DEFAULT NULL,
 98  	 p_log_categ IN VARCHAR2 DEFAULT NULL,
 99  	 p_mstr_fun IN VARCHAR2 DEFAULT NULL,
100  	 p_log_sttus IN VARCHAR2 DEFAULT NULL,
101  	 p_start_date IN DATE DEFAULT NULL,
102  	 p_end_date IN DATE DEFAULT NULL,
103  	 p_last_err_code IN VARCHAR2 DEFAULT NULL,
104  	 p_last_err_desc IN VARCHAR2 DEFAULT NULL,
105  	 p_log_type IN VARCHAR2 DEFAULT 'TEXT'
106    );
107  
108  --Procedure prc_error_stack
109  -- Dumps oracle stack into table MD_PRCSS_LOG if error occurs.
110  -- All parameters are optional. If log_id is used stack will be
111  -- printed in auto log and passed log_id entry.
112  
113  -- Parameters:
114  -- p_log_id log_id
115  -- p_proc_name procedure name
116  -- p_mstr_log_id used for custom logging entries (not auto)
117  
118  PROCEDURE prc_error_stack
119  (
120  p_log_id IN NUMBER,
121  p_mstr_log_id IN NUMBER DEFAULT NULL
122  );
123  END PKG_REPLICA_TL_LOGGING;
124  /

