SQL> @layer3_replica/packages/pkg_replica_partition.body.sql
SQL> CREATE OR REPLACE PACKAGE BODY PKG_REPLICA_PARTITION
  2  AS
  3    /*
  4  	 Package      : PKG_REPLICA_PARTITION
  5  	 Developer    : Tomasz Lesinski
  6  	 Date	      : 2026-06-01
  7  	 Purpose      : Partition exchange staging for layer 3 replica -
  8  			create staging, load from L2 source partition,
  9  			build indexes, exchange, drop staging.
 10  
 11  	 Prerequisite : PKG_REPLICA_SQL, PKG_REPLICA_LOG
 12  
 13  	 Change History:
 14  	 ------------------------------------------------------------------------------
 15  	 Version    Date	 Programmer	    Description
 16  	 ------------------------------------------------------------------------------
 17  	  1.0	     2026-06-01   Tomasz Lesinski    Initial version
 18    */
 19    FUNCTION fn_normalize_execute(p_execute IN VARCHAR2) RETURN VARCHAR2 IS
 20    BEGIN
 21  	 RETURN CASE WHEN UPPER(NVL(TRIM(p_execute), 'N')) = 'Y' THEN 'Y' ELSE 'N' END;
 22    END;
 23  
 24    FUNCTION fn_qualified_table
 25    (
 26  	 p_owner	  IN VARCHAR2,
 27  	 p_table	  IN VARCHAR2,
 28  	 p_source_db_link IN VARCHAR2 DEFAULT NULL
 29    )
 30    RETURN VARCHAR2
 31    IS
 32  	 l_name VARCHAR2(400);
 33    BEGIN
 34  	 l_name := PKG_REPLICA_SQL.fn_assert_simple_name(p_owner) || '.' || PKG_REPLICA_SQL.fn_assert_simple_name(p_table);
 35  
 36  	 IF p_source_db_link IS NOT NULL THEN
 37  	   l_name := l_name || '@' || PKG_REPLICA_SQL.fn_assert_simple_name(p_source_db_link);
 38  	 END IF;
 39  
 40  	 RETURN l_name;
 41    END fn_qualified_table;
 42  
 43    FUNCTION fn_qualified_source_table
 44    (
 45  	 p_owner	  IN VARCHAR2,
 46  	 p_table	  IN VARCHAR2,
 47  	 p_source_db_link IN VARCHAR2
 48    )
 49    RETURN VARCHAR2
 50    IS
 51    BEGIN
 52  	 IF p_source_db_link IS NULL OR TRIM(p_source_db_link) IS NULL THEN
 53  	   RAISE_APPLICATION_ERROR(-20046, 'SOURCE_DB_LINK is required for layer 3 source reads');
 54  	 END IF;
 55  
 56  	 RETURN fn_qualified_table(p_owner, p_table, p_source_db_link);
 57    END fn_qualified_source_table;
 58  
 59    FUNCTION fn_normalize_tablespace_name(p_tablespace_name IN VARCHAR2) RETURN VARCHAR2 IS
 60    BEGIN
 61  	 IF p_tablespace_name IS NULL OR TRIM(p_tablespace_name) IS NULL THEN
 62  	   raise_application_error(-20045, 'TABLESPACE_NAME is required for exchange staging objects');
 63  	 END IF;
 64  
 65  	 RETURN PKG_REPLICA_SQL.fn_assert_simple_name(p_tablespace_name);
 66    END fn_normalize_tablespace_name;
 67  
 68    FUNCTION fn_high_value_to_date(p_high_value IN VARCHAR2) RETURN DATE IS
 69  	 l_date DATE;
 70    BEGIN
 71  	 IF p_high_value IS NULL OR UPPER(TRIM(p_high_value)) = 'MAXVALUE' THEN
 72  	   RETURN NULL;
 73  	 END IF;
 74  
 75  	 EXECUTE IMMEDIATE 'SELECT ' || p_high_value || ' FROM dual' INTO l_date;
 76  	 RETURN l_date;
 77    EXCEPTION
 78  	 WHEN OTHERS THEN
 79  	   RETURN NULL;
 80    END fn_high_value_to_date;
 81  
 82    FUNCTION fn_first_partition_key_column
 83    (
 84  	 p_owner IN VARCHAR2,
 85  	 p_table IN VARCHAR2
 86    )
 87    RETURN VARCHAR2
 88    IS
 89  	 l_column_name VARCHAR2(128);
 90    BEGIN
 91  	 SELECT column_name
 92  	   INTO l_column_name
 93  	   FROM all_part_key_columns
 94  	  WHERE owner = UPPER(p_owner)
 95  	    AND name = UPPER(p_table)
 96  	    AND object_type = 'TABLE'
 97  	    AND column_position = 1;
 98  
 99  	 RETURN PKG_REPLICA_SQL.fn_assert_simple_name(l_column_name);
100    END fn_first_partition_key_column;
101  
102    FUNCTION fn_first_subpartition_key_column
103    (
104  	 p_owner IN VARCHAR2,
105  	 p_table IN VARCHAR2
106    )
107    RETURN VARCHAR2
108    IS
109  	 l_column_name VARCHAR2(128);
110    BEGIN
111  	 SELECT column_name
112  	   INTO l_column_name
113  	   FROM all_subpart_key_columns
114  	  WHERE owner = UPPER(p_owner)
115  	    AND name = UPPER(p_table)
116  	    AND object_type = 'TABLE'
117  	    AND column_position = 1;
118  
119  	 RETURN PKG_REPLICA_SQL.fn_assert_simple_name(l_column_name);
120    END fn_first_subpartition_key_column;
121  
122    PROCEDURE prc_build_staging_indexes
123    (
124  	 p_target_owner       IN VARCHAR2,
125  	 p_target_table       IN VARCHAR2,
126  	 p_staging_table_name IN VARCHAR2,
127  	 p_execute	      IN VARCHAR2 DEFAULT 'Y',
128  	 p_log_id	      IN NUMBER DEFAULT NULL,
129  	 p_parallel_degree    IN NUMBER DEFAULT 4,
130  	 p_tablespace_name    IN VARCHAR2
131    )
132    IS
133  	 l_sql		CLOB;
134  	 l_column_list	VARCHAR2(4000);
135  	 l_sql_rowcount NUMBER;
136  	 l_index_name	VARCHAR2(128);
137  	 l_tablespace	VARCHAR2(128);
138    BEGIN
139  	 l_tablespace := fn_normalize_tablespace_name(p_tablespace_name);
140  
141  	 FOR r IN (
142  	   SELECT i.index_name, i.uniqueness
143  	     FROM all_indexes i
144  	     JOIN all_part_indexes p
145  	       ON p.owner = i.owner
146  	      AND p.index_name = i.index_name
147  	    WHERE i.owner = UPPER(p_target_owner)
148  	      AND i.table_owner = UPPER(p_target_owner)
149  	      AND i.table_name = UPPER(p_target_table)
150  	      AND i.index_type = 'NORMAL'
151  	      AND p.locality = 'LOCAL'
152  	    ORDER BY i.index_name
153  	 ) LOOP
154  	   SELECT LISTAGG(
155  		    PKG_REPLICA_SQL.fn_assert_simple_name(column_name) ||
156  		    CASE WHEN descend = 'DESC' THEN ' DESC' END,
157  		    ', '
158  		  ) WITHIN GROUP (ORDER BY column_position)
159  	     INTO l_column_list
160  	     FROM all_ind_columns
161  	    WHERE index_owner = UPPER(p_target_owner)
162  	      AND table_owner = UPPER(p_target_owner)
163  	      AND table_name = UPPER(p_target_table)
164  	      AND index_name = r.index_name;
165  
166  	   l_index_name := SUBSTR('STG_' || r.index_name || '_' || TO_CHAR(SYSTIMESTAMP, 'HH24MISSFF3'), 1, 128);
167  
168  	   l_sql := 'CREATE ' ||
169  		    CASE WHEN r.uniqueness = 'UNIQUE' THEN 'UNIQUE ' END ||
170  		    'INDEX ' ||
171  		    PKG_REPLICA_SQL.fn_assert_simple_name(p_target_owner) || '.' ||
172  		    PKG_REPLICA_SQL.fn_assert_simple_name(l_index_name) ||
173  		    ' ON ' ||
174  		    fn_qualified_table(p_target_owner, p_staging_table_name) ||
175  		    '(' || l_column_list || ')' ||
176  		    ' TABLESPACE ' || l_tablespace ||
177  		    ' PARALLEL ' || p_parallel_degree;
178  
179  	   l_sql_rowcount := PKG_REPLICA_SQL.fn_run_sql(p_log_id, l_sql, p_execute);
180  	 END LOOP;
181    END prc_build_staging_indexes;
182  
183    PROCEDURE prc_create_exchange_staging
184    (
185  	 p_target_owner       IN VARCHAR2,
186  	 p_target_table       IN VARCHAR2,
187  	 p_partition_name     IN VARCHAR2,
188  	 p_staging_table_name OUT VARCHAR2,
189  	 p_execute	      IN VARCHAR2 DEFAULT 'Y',
190  	 p_log_id	      IN NUMBER DEFAULT NULL,
191  	 p_tablespace_name    IN VARCHAR2
192    )
193    IS
194  	 l_sql		CLOB;
195  	 l_sql_rowcount NUMBER;
196  	 l_tablespace	VARCHAR2(128);
197    BEGIN
198  	 l_tablespace := fn_normalize_tablespace_name(p_tablespace_name);
199  
200  	 p_staging_table_name := SUBSTR(
201  	   'TBL_REPLICA_STG_TMP_' || TO_CHAR(REPLICA_STG_TMP_SEQ.NEXTVAL),
202  	   1,
203  	   128
204  	 );
205  
206  	 l_sql := 'CREATE TABLE ' ||
207  		  fn_qualified_table(p_target_owner, p_staging_table_name) ||
208  		  ' TABLESPACE ' || l_tablespace ||
209  		  ' FOR EXCHANGE WITH TABLE ' ||
210  		  fn_qualified_table(p_target_owner, p_target_table);
211  
212  	 l_sql_rowcount := PKG_REPLICA_SQL.fn_run_sql(p_log_id, l_sql, p_execute);
213  
214    END prc_create_exchange_staging;
215  
216    PROCEDURE prc_load_exchange_staging
217    (
218  	 p_source_db_link	  IN VARCHAR2,
219  	 p_source_owner 	  IN VARCHAR2,
220  	 p_source_table 	  IN VARCHAR2,
221  	 p_target_owner 	  IN VARCHAR2,
222  	 p_target_table 	  IN VARCHAR2,
223  	 p_staging_table_name	  IN VARCHAR2,
224  	 p_high_value		  IN VARCHAR2,
225  	 p_prev_high_value	  IN VARCHAR2 DEFAULT NULL,
226  	 p_execute		  IN VARCHAR2 DEFAULT 'Y',
227  	 p_log_id		  IN NUMBER DEFAULT NULL,
228  	 p_parallel_degree	  IN NUMBER DEFAULT 4,
229  	 p_rows_loaded		  OUT NUMBER
230    )
231    IS
232  	 l_sql	      CLOB;
233  	 l_key_column VARCHAR2(128);
234  	 l_high_date  DATE;
235  	 l_low_date   DATE;
236    BEGIN
237  	 l_key_column := fn_first_partition_key_column(p_target_owner, p_target_table);
238  	 l_high_date := fn_high_value_to_date(p_high_value);
239  	 l_low_date := fn_high_value_to_date(p_prev_high_value);
240  
241  	 IF l_high_date IS NULL THEN
242  	   RAISE_APPLICATION_ERROR(-20048, 'REPLICA EXCHANGE requires a DATE high value for target partition');
243  	 END IF;
244  
245  	 l_sql := 'INSERT /*+ APPEND PARALLEL(' || p_parallel_degree || ') */ INTO ' ||
246  		  fn_qualified_table(p_target_owner, p_staging_table_name) ||
247  		  ' SELECT * FROM ' ||
248  		  fn_qualified_source_table(p_source_owner, p_source_table, p_source_db_link) ||
249  		  ' WHERE ' || l_key_column || ' < DATE ''' || TO_CHAR(l_high_date, 'YYYY-MM-DD') || '''';
250  
251  	 IF l_low_date IS NOT NULL THEN
252  	   l_sql := l_sql || ' AND ' || l_key_column || ' >= DATE ''' || TO_CHAR(l_low_date, 'YYYY-MM-DD') || '''';
253  	 END IF;
254  
255  	 p_rows_loaded := PKG_REPLICA_SQL.fn_run_sql(p_log_id, l_sql, p_execute);
256    END prc_load_exchange_staging;
257  
258    PROCEDURE prc_load_exchange_staging_subpartition
259    (
260  	 p_source_db_link	       IN VARCHAR2,
261  	 p_source_owner 	       IN VARCHAR2,
262  	 p_source_table 	       IN VARCHAR2,
263  	 p_target_owner 	       IN VARCHAR2,
264  	 p_target_table 	       IN VARCHAR2,
265  	 p_staging_table_name	       IN VARCHAR2,
266  	 p_partition_high_value        IN VARCHAR2,
267  	 p_prev_partition_high_value   IN VARCHAR2 DEFAULT NULL,
268  	 p_subpartition_high_value     IN VARCHAR2,
269  	 p_execute		       IN VARCHAR2 DEFAULT 'Y',
270  	 p_log_id		       IN NUMBER DEFAULT NULL,
271  	 p_parallel_degree	       IN NUMBER DEFAULT 4,
272  	 p_rows_loaded		       OUT NUMBER
273    )
274    IS
275  	 l_sql		   CLOB;
276  	 l_part_key_column VARCHAR2(128);
277  	 l_sub_key_column  VARCHAR2(128);
278  	 l_high_date	   DATE;
279  	 l_low_date	   DATE;
280    BEGIN
281  	 l_part_key_column := fn_first_partition_key_column(p_target_owner, p_target_table);
282  	 l_sub_key_column := fn_first_subpartition_key_column(p_target_owner, p_target_table);
283  	 l_high_date := fn_high_value_to_date(p_partition_high_value);
284  	 l_low_date := fn_high_value_to_date(p_prev_partition_high_value);
285  
286  	 IF l_high_date IS NULL THEN
287  	   RAISE_APPLICATION_ERROR(-20049, 'REPLICA EXCHANGE SUBPARTITION requires a DATE partition high value');
288  	 END IF;
289  
290  	 IF p_subpartition_high_value IS NULL OR TRIM(p_subpartition_high_value) = '#' THEN
291  	   RAISE_APPLICATION_ERROR(-20050, 'REPLICA EXCHANGE SUBPARTITION requires a list subpartition high value');
292  	 END IF;
293  
294  	 l_sql := 'INSERT /*+ APPEND PARALLEL(' || p_parallel_degree || ') */ INTO ' ||
295  		  fn_qualified_table(p_target_owner, p_staging_table_name) ||
296  		  ' SELECT * FROM ' ||
297  		  fn_qualified_source_table(p_source_owner, p_source_table, p_source_db_link) ||
298  		  ' WHERE ' || l_part_key_column || ' < DATE ''' || TO_CHAR(l_high_date, 'YYYY-MM-DD') || '''' ||
299  		  ' AND ' || l_sub_key_column || ' IN (' || p_subpartition_high_value || ')';
300  
301  	 IF l_low_date IS NOT NULL THEN
302  	   l_sql := l_sql || ' AND ' || l_part_key_column || ' >= DATE ''' || TO_CHAR(l_low_date, 'YYYY-MM-DD') || '''';
303  	 END IF;
304  
305  	 p_rows_loaded := PKG_REPLICA_SQL.fn_run_sql(p_log_id, l_sql, p_execute);
306    END prc_load_exchange_staging_subpartition;
307  
308    PROCEDURE prc_exchange_partition
309    (
310  	 p_target_owner       IN VARCHAR2,
311  	 p_target_table       IN VARCHAR2,
312  	 p_partition_name     IN VARCHAR2,
313  	 p_staging_table_name IN VARCHAR2,
314  	 p_execute	      IN VARCHAR2 DEFAULT 'Y',
315  	 p_log_id	      IN NUMBER DEFAULT NULL
316    )
317    IS
318  	 l_sql		CLOB;
319  	 l_sql_rowcount NUMBER;
320    BEGIN
321  	 l_sql := 'ALTER TABLE ' ||
322  		  fn_qualified_table(p_target_owner, p_target_table) ||
323  		  ' EXCHANGE PARTITION ' ||
324  		  PKG_REPLICA_SQL.fn_assert_simple_name(p_partition_name) ||
325  		  ' WITH TABLE ' ||
326  		  fn_qualified_table(p_target_owner, p_staging_table_name) ||
327  		  ' INCLUDING INDEXES WITHOUT VALIDATION';
328  
329  	 l_sql_rowcount := PKG_REPLICA_SQL.fn_run_sql(p_log_id, l_sql, p_execute);
330    END prc_exchange_partition;
331  
332    PROCEDURE prc_exchange_subpartition
333    (
334  	 p_target_owner       IN VARCHAR2,
335  	 p_target_table       IN VARCHAR2,
336  	 p_subpartition_name  IN VARCHAR2,
337  	 p_staging_table_name IN VARCHAR2,
338  	 p_execute	      IN VARCHAR2 DEFAULT 'Y',
339  	 p_log_id	      IN NUMBER DEFAULT NULL
340    )
341    IS
342  	 l_sql		CLOB;
343  	 l_sql_rowcount NUMBER;
344    BEGIN
345  	 l_sql := 'ALTER TABLE ' ||
346  		  fn_qualified_table(p_target_owner, p_target_table) ||
347  		  ' EXCHANGE SUBPARTITION ' ||
348  		  PKG_REPLICA_SQL.fn_assert_simple_name(p_subpartition_name) ||
349  		  ' WITH TABLE ' ||
350  		  fn_qualified_table(p_target_owner, p_staging_table_name) ||
351  		  ' INCLUDING INDEXES WITHOUT VALIDATION';
352  
353  	 l_sql_rowcount := PKG_REPLICA_SQL.fn_run_sql(p_log_id, l_sql, p_execute);
354    END prc_exchange_subpartition;
355  
356    PROCEDURE prc_drop_staging
357    (
358  	 p_staging_owner      IN VARCHAR2,
359  	 p_staging_table_name IN VARCHAR2,
360  	 p_execute	      IN VARCHAR2 DEFAULT 'Y',
361  	 p_log_id	      IN NUMBER DEFAULT NULL
362    )
363    IS
364  	 l_sql		CLOB;
365  	 l_sql_rowcount NUMBER;
366    BEGIN
367  	 l_sql := 'DROP TABLE ' ||
368  		  fn_qualified_table(p_staging_owner, p_staging_table_name) ||
369  		  ' PURGE';
370  
371  	 l_sql_rowcount := PKG_REPLICA_SQL.fn_run_sql(p_log_id, l_sql, p_execute);
372    END prc_drop_staging;
373  
374    PROCEDURE prc_cleanup_orphan_staging
375    (
376  	 p_retention_days IN NUMBER DEFAULT 30,
377  	 p_execute	  IN VARCHAR2 DEFAULT 'N',
378  	 p_log_id	  IN NUMBER DEFAULT NULL
379    )
380    IS
381  	 l_execute_flag VARCHAR2(1);
382    BEGIN
383  	 l_execute_flag := fn_normalize_execute(p_execute);
384  
385  	 DBMS_OUTPUT.PUT_LINE('CLEANUP orphan staging tables older than ' || p_retention_days || ' days');
386  
387  	 FOR r IN (
388  	   SELECT o.object_name AS table_name, o.created
389  	     FROM all_objects o
390  	    WHERE o.owner = SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA')
391  	      AND o.object_type = 'TABLE'
392  	      AND o.object_name LIKE 'STG\_TMP\_REPLICA\_%' ESCAPE '\'
393  	      AND o.created < SYSDATE - NVL(p_retention_days, 30)
394  	    ORDER BY o.object_name
395  	 ) LOOP
396  	   DBMS_OUTPUT.PUT_LINE('[CLEANUP] Candidate: ' || r.table_name ||
397  				' (created: ' || TO_CHAR(r.created, 'YYYY-MM-DD HH24:MI:SS') || ')');
398  
399  	   IF l_execute_flag = 'Y' THEN
400  	     prc_drop_staging(
401  	       p_staging_owner	    => SYS_CONTEXT('USERENV', 'CURRENT_SCHEMA'),
402  	       p_staging_table_name => r.table_name,
403  	       p_execute	    => 'Y',
404  	       p_log_id 	    => p_log_id
405  	     );
406  	     DBMS_OUTPUT.PUT_LINE('[CLEANUP] Dropped: ' || r.table_name);
407  	   END IF;
408  	 END LOOP;
409  
410  	 IF l_execute_flag = 'N' THEN
411  	   DBMS_OUTPUT.PUT_LINE('[CLEANUP] Preview mode - no tables dropped');
412  	 END IF;
413    END prc_cleanup_orphan_staging;
414  END PKG_REPLICA_PARTITION;
415  /

