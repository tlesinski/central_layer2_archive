SQL> CREATE OR REPLACE VIEW VW_REPLICA_DISCOVERY_PARTITIONS
  2  AS
  3  SELECT s.source_db_link,
  4  	    s.source_owner,
  5  	    s.source_table_name,
  6  	    s.target_owner,
  7  	    s.target_table_name,
  8  	    s.days_online,
  9  	    s.base_date,
 10  	    s.cutoff_date,
 11  	    s.archive_unit_type,
 12  	    s.source_partition_name,
 13  	    s.source_subpartition_name,
 14  	    s.partition_name,
 15  	    s.subpartition_name,
 16  	    s.partition_high_value,
 17  	    s.subpartition_high_value,
 18  	    s.prev_partition_high_value,
 19  	    s.partition_high_value_date
 20    FROM vw_replica_source_partitions s
 21   WHERE NOT EXISTS (
 22  	    SELECT 1
 23  	      FROM tbl_replica_partitions p
 24  	     WHERE p.source_db_link = s.source_db_link
 25  	       AND p.source_owner = s.source_owner
 26  	       AND p.source_table_name = s.source_table_name
 27  	       AND p.partition_high_value = s.partition_high_value
 28  	       AND p.subpartition_high_value = s.subpartition_high_value
 29  	    );

