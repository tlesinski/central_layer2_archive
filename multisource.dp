  6  	 Date	      : 2026-06-01
  7  	 Purpose      : Discover layer 2 archive partitions for layer 3 replica -
  8  			add missing target partitions and insert metadata into
  9  			TBL_REPLICA_PARTITIONS
 10  
 11  	 Prerequisite : PKG_REPLICA_SQL, PKG_REPLICA_LOG, VW_REPLICA_DISCOVERY_PARTITIONS
 12  
 13  	 Change History:
 14  	 ------------------------------------------------------------------------------
 15  	 Version    Date	 Programmer	    Description
 16  	 ------------------------------------------------------------------------------
 17  	  1.0	     2026-06-01   Tomasz Lesinski    Initial version
 18    */
 19    PROCEDURE prc_discover
 20    (
 21  	 p_execute	     IN VARCHAR2 DEFAULT 'N',
 22  	 p_target_owner      IN VARCHAR2 DEFAULT NULL,
 23  	 p_target_table_name IN VARCHAR2 DEFAULT NULL
 24    );
 25  END PKG_REPLICA_DISCOVERY;
