SQL> CREATE OR REPLACE PACKAGE PKG_REPLICA_RUNNER
  2  AS
  3    PROCEDURE prc_run
  4    (
  5  	 p_execute	     IN VARCHAR2 DEFAULT 'N',
  6  	 p_stop_after_step   IN VARCHAR2 DEFAULT NULL,
  7  	 p_purge_execute     IN VARCHAR2 DEFAULT 'N',
  8  	 p_target_owner      IN VARCHAR2 DEFAULT NULL,
  9  	 p_target_table_name IN VARCHAR2 DEFAULT NULL
 10    );
