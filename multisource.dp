SQL> @layer3_replica/packages/pkg_replica_purge.body.sql
SQL> CREATE OR REPLACE PACKAGE BODY PKG_REPLICA_PURGE
  2  AS
  3    FUNCTION fn_normalize_execute(p_execute IN VARCHAR2) RETURN VARCHAR2 IS
  4    BEGIN
  5  	 RETURN CASE WHEN UPPER(NVL(TRIM(p_execute), 'N')) = 'Y' THEN 'Y' ELSE 'N' END;
  6    END;
  7  
  8    FUNCTION fn_normalize_name(p_name IN VARCHAR2) RETURN VARCHAR2 IS
  9    BEGIN
 10  	 IF p_name IS NULL OR TRIM(p_name) IS NULL THEN
 11  	   RETURN NULL;
 12  	 END IF;
 13  	 RETURN PKG_REPLICA_SQL.fn_assert_simple_name(p_name);
 14    END;
 15  
 16    FUNCTION fn_qualified_table(p_owner IN VARCHAR2, p_table IN VARCHAR2) RETURN VARCHAR2 IS
 17    BEGIN
 18  	 RETURN PKG_REPLICA_SQL.fn_assert_simple_name(p_owner) || '.' || PKG_REPLICA_SQL.fn_assert_simple_name(p_table);
 19    END;
 20  
 21    PROCEDURE prc_purge
 22    (
 23  	 p_execute	     IN VARCHAR2 DEFAULT 'N',
 24  	 p_target_owner      IN VARCHAR2 DEFAULT NULL,
 25  	 p_target_table_name IN VARCHAR2 DEFAULT NULL
 26    )
 27    IS
 28  	 l_run_id	     NUMBER;
 29  	 l_log_id	     NUMBER;
 30  	 l_execute_flag      VARCHAR2(1);
 31  	 l_target_owner      VARCHAR2(128);
 32  	 l_target_table      VARCHAR2(128);
 33  	 l_sql		     CLOB;
 34  	 l_rows_available    NUMBER := 0;
 35  	 l_units	     NUMBER := 0;
 36  	 l_purged	     NUMBER := 0;
 37  	 l_summary	     CLOB := NULL;
 38  	 l_table_summary     CLOB;
 39  	 l_partition_columns VARCHAR2(1000) :=
 40  	   'NOTE|SOURCE_PARTITION_NAME|SOURCE_SUBPARTITION_NAME|PARTITION_NAME|SUBPARTITION_NAME|PARTITION_HIGH_VALUE|SUBPARTITION_HIGH_VALUE|REPLICA_STATUS|QUALITY_STATUS|PURGE_STATUS|SOURCE_ROW_COUNT|TARGET_ROW_COUNT';
 41    BEGIN
 42  	 l_execute_flag := fn_normalize_execute(p_execute);
 43  	 l_target_owner := fn_normalize_name(p_target_owner);
 44  	 l_target_table := fn_normalize_name(p_target_table_name);
 45  	 l_run_id := PKG_REPLICA_LOG.fn_create_run('PURGE', NULL, NULL, NULL, l_execute_flag);
 46  	 l_log_id := PKG_REPLICA_LOG.fn_get_log_id(l_run_id);
 47  
 48  	 PKG_REPLICA_LOG.prc_log_message(l_run_id, 'Started REPLICA PURGE execute=' || l_execute_flag);
 49  
 50  	 l_sql :=
 51  	   'SELECT COUNT(*) FROM VW_REPLICA_PURGE_PARTITIONS ' ||
 52  	   'WHERE (:1 IS NULL OR target_owner = :1) AND (:2 IS NULL OR target_table_name = :2)';
 53  
 54  	 l_rows_available := PKG_REPLICA_SQL.fn_run_into_sql_in_bind
 55  	 (
 56  	   p_log_id	=> l_log_id,
 57  	   p_sql	=> l_sql,
 58  	   p_array_bind => SYS.ODCIVARCHAR2LIST(l_target_owner, l_target_table),
 59  	   p_execute	=> 'Y'
 60  	 );
 61  
 62  	 FOR t IN (
 63  	   SELECT DISTINCT source_db_link, source_owner, source_table_name, target_owner, target_table_name
 64  	     FROM vw_replica_purge_partitions
 65  	    WHERE (l_target_owner IS NULL OR target_owner = l_target_owner)
 66  	      AND (l_target_table IS NULL OR target_table_name = l_target_table)
 67  	    ORDER BY source_db_link, source_owner, source_table_name
 68  	 ) LOOP
 69  	   l_table_summary := NULL;
 70  
 71  	   FOR r IN (
 72  	     SELECT *
 73  	       FROM vw_replica_purge_partitions
 74  	      WHERE source_db_link = t.source_db_link
 75  		AND source_owner = t.source_owner
 76  		AND source_table_name = t.source_table_name
 77  		AND target_owner = t.target_owner
 78  		AND target_table_name = t.target_table_name
 79  	      ORDER BY partition_high_value, subpartition_high_value
 80  	   ) LOOP
 81  	     l_units := l_units + 1;
 82  
 83  	     IF r.archive_unit_type = 'SUBPARTITION' THEN
 84  	       l_sql := 'ALTER TABLE ' || fn_qualified_table(r.target_owner, r.target_table_name) ||
 85  			' TRUNCATE SUBPARTITION ' || PKG_REPLICA_SQL.fn_assert_simple_name(r.subpartition_name);
 86  	     ELSE
 87  	       l_sql := 'ALTER TABLE ' || fn_qualified_table(r.target_owner, r.target_table_name) ||
 88  			' TRUNCATE PARTITION ' || PKG_REPLICA_SQL.fn_assert_simple_name(r.partition_name);
 89  	     END IF;
 90  
 91  	     DBMS_OUTPUT.PUT_LINE('REPLICA_PURGE target=' || r.target_owner || '.' || r.target_table_name ||
 92  				  ' ' || r.partition_name ||
 93  				  CASE WHEN r.subpartition_name <> '#' THEN '.' || r.subpartition_name END ||
 94  				  ' cutoff=' || TO_CHAR(r.cutoff_date, 'YYYY-MM-DD') ||
 95  				  ' execute=' || l_execute_flag);
 96  
 97  	     l_purged := l_purged + PKG_REPLICA_SQL.fn_run_sql(l_log_id, l_sql, l_execute_flag);
 98  
 99  	     IF l_execute_flag = 'Y' THEN
100  	       UPDATE tbl_replica_partitions
101  		  SET purge_status = 'Y',
102  		      last_run_id = l_run_id,
103  		      error_message = NULL,
104  		      updated_at = SYSTIMESTAMP
105  		WHERE source_db_link = r.source_db_link
106  		  AND source_owner = r.source_owner
107  		  AND source_table_name = r.source_table_name
108  		  AND partition_high_value = r.partition_high_value
109  		  AND subpartition_high_value = r.subpartition_high_value;
110  
111  	       l_purged := l_purged + SQL%ROWCOUNT;
112  	       COMMIT;
113  	     END IF;
114  
115  	     l_table_summary := l_table_summary ||
116  	       TO_CLOB(PKG_REPLICA_LOG.fn_summary_cell(CASE WHEN l_execute_flag = 'Y' THEN 'PURGED' ELSE 'PREVIEW' END)) || '|' ||
117  	       PKG_REPLICA_LOG.fn_summary_cell(r.source_partition_name) || '|' ||
118  	       PKG_REPLICA_LOG.fn_summary_cell(r.source_subpartition_name) || '|' ||
119  	       PKG_REPLICA_LOG.fn_summary_cell(r.partition_name) || '|' ||
120  	       PKG_REPLICA_LOG.fn_summary_cell(r.subpartition_name) || '|' ||
121  	       PKG_REPLICA_LOG.fn_summary_cell(r.partition_high_value) || '|' ||
122  	       PKG_REPLICA_LOG.fn_summary_cell(r.subpartition_high_value) || '|' ||
123  	       PKG_REPLICA_LOG.fn_summary_cell(r.replica_status) || '|' ||
124  	       PKG_REPLICA_LOG.fn_summary_cell(r.quality_status) || '|' ||
125  	       PKG_REPLICA_LOG.fn_summary_cell(CASE WHEN l_execute_flag = 'Y' THEN 'Y' ELSE r.purge_status END) || '|' ||
126  	       PKG_REPLICA_LOG.fn_summary_cell(TO_CHAR(r.source_row_count)) || '|' ||
127  	       PKG_REPLICA_LOG.fn_summary_cell(TO_CHAR(r.target_row_count)) || CHR(10);
128  	   END LOOP;
129  
130  	   IF l_table_summary IS NOT NULL THEN
131  	     l_summary := l_summary ||
132  	       '=== TABLE: ' || t.source_db_link || '.' || t.source_owner || '.' || t.source_table_name || ' ===' || CHR(10) || CHR(10) ||
133  	       PKG_REPLICA_SQL.fn_format_table
134  	       (
135  		 p_columns => 'SOURCE_DB_LINK|TABLE_OWNER|TABLE_NAME|EXECUTE',
136  		 p_rows    => PKG_REPLICA_LOG.fn_summary_cell(t.source_db_link) || '|' ||
137  			      PKG_REPLICA_LOG.fn_summary_cell(t.source_owner) || '|' ||
138  			      PKG_REPLICA_LOG.fn_summary_cell(t.source_table_name) || '|' ||
139  			      PKG_REPLICA_LOG.fn_summary_cell(l_execute_flag) || CHR(10)
140  	       ) || CHR(10) ||
141  	       PKG_REPLICA_SQL.fn_format_table(l_partition_columns, l_table_summary) || CHR(10);
142  	   END IF;
143  	 END LOOP;
144  
145  	 DBMS_OUTPUT.PUT_LINE('REPLICA_PURGE units=' || l_units || ' found=' || l_rows_available ||
146  			      ' purged=' || l_purged || ' execute=' || l_execute_flag);
147  
148  	 IF l_summary IS NOT NULL THEN
149  	   PKG_REPLICA_LOG.prc_log_message(l_run_id, l_summary, 'SUMMARY');
150  	 END IF;
151  
152  	 PKG_REPLICA_LOG.prc_finish_run(l_run_id, 'SUCCESS');
153    EXCEPTION
154  	 WHEN OTHERS THEN
155  	   IF l_run_id IS NOT NULL THEN
156  	     PKG_REPLICA_LOG.prc_log_error_stack(l_run_id);
157  	     PKG_REPLICA_LOG.prc_finish_run(l_run_id, 'ERROR', SQLERRM);
158  	   END IF;
159  	   RAISE;
160    END prc_purge;
161  END PKG_REPLICA_PURGE;
162  /

