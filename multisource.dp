SQL> MERGE INTO TBL_REPLICA_TABLES dst
  2  USING (
  3    SELECT UPPER('&1') AS source_db_link,
  4  	      UPPER('&&APPLICATION_SCHEMA') AS source_owner,
  5  	      'TBL_ARCHIVER_ORDERS_SRC' AS source_table_name,
  6  	      UPPER('&&APPLICATION_SCHEMA') AS target_owner,
  7  	      'TBL_REPLICA_ORDERS_SRC' AS target_table_name,
