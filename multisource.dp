SQL> CREATE OR REPLACE VIEW VW_ARCHIVER_IMPORT_PARTITIONS
  2  AS
  3  SELECT p.source_db_link,
  4  	    t.source_agent_schema,
  5  	    p.source_owner,
  6  	    p.source_table_name,
  7  	    p.target_owner,
  8  	    p.target_table_name,
  9  	    p.archive_unit_type,
 10  	    p.source_partition_name,
 11  	    p.source_subpartition_name,
 12  	    p.partition_name,
 13  	    p.subpartition_name,
 14  	    p.partition_high_value,
 15  	    p.subpartition_high_value,
 16  	    p.prev_partition_high_value,
 17  	    p.archive_status,
 18  	    p.quality_status,
 19  	    p.truncate_status,
 20  	    p.source_row_count,
 21  	    p.target_row_count,
 22  	    t.LAST_BUSINESS_DATE,
 23  	    FN_ARCHIVER_HIGH_VALUE_DATE(t.LAST_BUSINESS_DATE) eod_date_calc,
 24  	    FN_ARCHIVER_HIGH_VALUE_DATE(partition_high_value) partition_high_date
 25    FROM TBL_ARCHIVER_PARTITIONS p
 26    JOIN TBL_ARCHIVER_TABLES t
 27  	 ON t.source_db_link = p.source_db_link
 28  	AND t.source_owner = p.source_owner
 29  	AND t.source_table_name = p.source_table_name
