SQL> @layer3_replica/packages/pkg_replica_runner.body.sql
SQL> CREATE OR REPLACE PACKAGE BODY PKG_REPLICA_RUNNER
  2  AS
  3    FUNCTION fn_normalize_execute(p_execute IN VARCHAR2) RETURN VARCHAR2 IS
  4    BEGIN
  5  	 RETURN CASE WHEN UPPER(NVL(TRIM(p_execute), 'N')) = 'Y' THEN 'Y' ELSE 'N' END;
  6    END;
  7  
  8    FUNCTION fn_stop_after(p_stop_after_step IN VARCHAR2) RETURN VARCHAR2 IS
  9  	 l_step VARCHAR2(30);
 10    BEGIN
 11  	 l_step := UPPER(TRIM(p_stop_after_step));
 12  
 13  	 IF l_step IS NULL THEN
 14  	   RETURN NULL;
 15  	 END IF;
 16  
 17  	 IF l_step NOT IN ('DISCOVER', 'REPLICATE', 'QUALITY', 'PURGE') THEN
 18  	   RAISE_APPLICATION_ERROR(-20220, 'Invalid L3 stop_after_step: ' || p_stop_after_step);
 19  	 END IF;
 20  
 21  	 RETURN l_step;
 22    END;
 23  
 24    PROCEDURE prc_run
 25    (
 26  	 p_execute	     IN VARCHAR2 DEFAULT 'N',
 27  	 p_stop_after_step   IN VARCHAR2 DEFAULT NULL,
 28  	 p_purge_execute     IN VARCHAR2 DEFAULT 'N',
 29  	 p_target_owner      IN VARCHAR2 DEFAULT NULL,
 30  	 p_target_table_name IN VARCHAR2 DEFAULT NULL
 31    )
 32    IS
 33  	 l_execute_flag VARCHAR2(1);
 34  	 l_purge_flag	VARCHAR2(1);
 35  	 l_stop_after	VARCHAR2(30);
 36    BEGIN
 37  	 l_execute_flag := fn_normalize_execute(p_execute);
 38  	 l_purge_flag := fn_normalize_execute(p_purge_execute);
 39  	 l_stop_after := fn_stop_after(p_stop_after_step);
 40  
 41  	 DBMS_OUTPUT.PUT_LINE('REPLICA_RUNNER execute=' || l_execute_flag ||
 42  			      ' purge_execute=' || l_purge_flag ||
 43  			      ' stop_after=' || NVL(l_stop_after, '<FULL>') ||
 44  			      ' target_owner=' || NVL(p_target_owner, '<ALL>') ||
 45  			      ' target_table=' || NVL(p_target_table_name, '<ALL>'));
 46  
 47  	 PKG_REPLICA_DISCOVERY.prc_discover
 48  	 (
 49  	   p_execute	       => l_execute_flag,
 50  	   p_target_owner      => p_target_owner,
 51  	   p_target_table_name => p_target_table_name
 52  	 );
 53  
 54  	 IF l_stop_after = 'DISCOVER' THEN
 55  	   RETURN;
 56  	 END IF;
 57  
 58  	 PKG_REPLICA_REPLICATE.prc_replicate
 59  	 (
 60  	   p_execute	       => l_execute_flag,
 61  	   p_target_owner      => p_target_owner,
 62  	   p_target_table_name => p_target_table_name
 63  	 );
 64  
 65  	 IF l_stop_after = 'REPLICATE' THEN
 66  	   RETURN;
 67  	 END IF;
 68  
 69  	 PKG_REPLICA_QUALITY.prc_quality
 70  	 (
 71  	   p_execute	       => l_execute_flag,
 72  	   p_target_owner      => p_target_owner,
 73  	   p_target_table_name => p_target_table_name
 74  	 );
 75  
 76  	 IF l_stop_after = 'QUALITY' THEN
 77  	   RETURN;
 78  	 END IF;
 79  
 80  	 PKG_REPLICA_PURGE.prc_purge
 81  	 (
 82  	   p_execute	       => l_purge_flag,
 83  	   p_target_owner      => p_target_owner,
 84  	   p_target_table_name => p_target_table_name
 85  	 );
 86    END prc_run;
 87  END PKG_REPLICA_RUNNER;
 88  /

Package body created.

