SQL> CREATE OR REPLACE PACKAGE PKG_ARCHIVER_TRUNCATE
  2  AS
  3    /*
  4  	 Package      : PKG_ARCHIVER_TRUNCATE
  5  	 Developer    : Tomasz Lesinski
  6  	 Date	      : 2026-05-28
  7  	 Purpose      : Source truncate - request source truncate through layer 1 agent
  8  			after quality success, respecting RETENTION_RULE
  9  
 10  	 Prerequisite : PKG_ARCHIVER_SQL, PKG_ARCHIVER_LOG, PKG_AGENT_ARCHIVE,
 11  			VW_ARCHIVER_TRUNCATE_PARTITIONS
 12  
 13  	 Change History:
 14  	 ------------------------------------------------------------------------------
 15  	 Version    Date	 Programmer	    Description
 16  	 ------------------------------------------------------------------------------
 17  	  1.0	     2026-05-28   Tomasz Lesinski    Initial version
 18  	  1.1	     2026-05-31   Tomasz Lesinski    Compact per-table summary, ORA-40478 fix
 19    */
 20    PROCEDURE prc_truncate
 21    (
 22  	 p_execute	     IN VARCHAR2 DEFAULT 'N',
 23  	 p_target_owner      IN VARCHAR2 DEFAULT NULL,
 24  	 p_target_table_name IN VARCHAR2 DEFAULT NULL
 25    );
 26  END PKG_ARCHIVER_TRUNCATE;
