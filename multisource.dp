SQL> @layer3_replica/views/vw_replica_source_partitions.sql
SQL> CREATE OR REPLACE VIEW VW_REPLICA_SOURCE_PARTITIONS
  2  AS
  3  WITH l2_units AS (
  4    SELECT rt.source_db_link,
  5  	      rt.source_owner,
  6  	      rt.source_table_name,
  7  	      rt.target_owner,
  8  	      rt.target_table_name,
  9  	      rt.days_online,
 10  	      rt.enabled_flag,
 11  	      p.archive_unit_type,
 12  	      p.partition_name AS source_partition_name,
 13  	      p.subpartition_name AS source_subpartition_name,
 14  	      p.partition_name,
 15  	      p.subpartition_name,
 16  	      p.partition_high_value,
 17  	      p.subpartition_high_value,
 18  	      p.prev_partition_high_value,
 19  	      FN_REPLICA_HIGH_VALUE_DATE(p.partition_high_value) AS partition_high_value_date
 20  	 FROM tbl_replica_tables rt
 21  	 JOIN REPLICA_ARCHIVER_PARTITIONS_SRC p
 22  	   ON p.target_owner = rt.source_owner
 23  	  AND p.target_table_name = rt.source_table_name
 24  	  AND p.archive_status = 'Y'
 25  	  AND p.quality_status = 'Y'
 26  	WHERE rt.enabled_flag = 'Y'
 27  	  AND UPPER(TRIM(p.partition_high_value)) <> 'MAXVALUE'
 28  ),
 29  base_dates AS (
 30    SELECT source_db_link,
 31  	      source_owner,
 32  	      source_table_name,
 33  	      MAX(partition_high_value_date) AS base_date
 34  	 FROM l2_units
 35  	GROUP BY source_db_link, source_owner, source_table_name
 36  )
 37  SELECT u.source_db_link,
 38  	    u.source_owner,
 39  	    u.source_table_name,
 40  	    u.target_owner,
 41  	    u.target_table_name,
 42  	    u.days_online,
 43  	    b.base_date,
 44  	    b.base_date - u.days_online AS cutoff_date,
 45  	    u.archive_unit_type,
 46  	    u.source_partition_name,
 47  	    u.source_subpartition_name,
 48  	    u.partition_name,
 49  	    u.subpartition_name,
 50  	    u.partition_high_value,
 51  	    u.subpartition_high_value,
 52  	    u.prev_partition_high_value,
 53  	    u.partition_high_value_date
 54    FROM l2_units u
 55    JOIN base_dates b
 56  	 ON b.source_db_link = u.source_db_link
 57  	AND b.source_owner = u.source_owner
 58  	AND b.source_table_name = u.source_table_name;

