SQL> CREATE OR REPLACE PACKAGE BODY PKG_REPLICA_SQL
  2  AS
  3    /*
  4  	 Package      : PKG_REPLICA_SQL
  5  	 Developer    : Tomasz Lesinski
  6  	 Date	      : 2026-05-28
  7  	 Purpose      : SQL helper package - name validation, dynamic SQL execution,
  8  			bind variable handling, SQL logging
  9  
 10  	 Prerequisite : PKG_REPLICA_TL_LOGGING, TBL_REPLICA_PROCESS_LOG
 11  
 12  	 Change History:
 13  	 ------------------------------------------------------------------------------
 14  	 Version    Date	 Programmer	    Description
 15  	 ------------------------------------------------------------------------------
 16  	  1.0	     2026-05-28   Tomasz Lesinski    Initial version
 17  	  1.1	     2026-05-31   Tomasz Lesinski    ORA-40478 fix in fn_format_table (TO_CLOB guard)
 18    */
 19    FUNCTION fn_normalize_execute
 20    (
 21  	 p_execute IN VARCHAR2
 22    )
 23    RETURN VARCHAR2
 24    IS
 25    BEGIN
 26  	 IF UPPER(NVL(TRIM(p_execute), 'N')) = 'Y' THEN
 27  	   RETURN 'Y';
 28  	 END IF;
 29  
 30  	 RETURN 'N';
 31    END fn_normalize_execute;
 32  
 33    FUNCTION fn_format_sql_for_log
 34    (
 35  	 p_sql IN CLOB
 36    )
 37    RETURN CLOB
 38    IS
 39  	 l_sql CLOB;
 40    BEGIN
 41  	 IF p_sql IS NULL THEN
 42  	   RETURN NULL;
 43  	 END IF;
 44  
 45  	 l_sql := REGEXP_REPLACE(p_sql, '[[:space:]]+', ' ');
 46  	 l_sql := TRIM(l_sql);
 47  
 48  	 l_sql := REGEXP_REPLACE(l_sql, '[[:space:]]+(SELECT[[:space:]])', CHR(10) || 'SELECT ', 1, 0, 'i');
 49  	 l_sql := REGEXP_REPLACE(l_sql, '[[:space:]]+(FROM[[:space:]])', CHR(10) || 'FROM ', 1, 0, 'i');
 50  	 l_sql := REGEXP_REPLACE(l_sql, '[[:space:]]+(WHERE[[:space:]])', CHR(10) || 'WHERE ', 1, 0, 'i');
 51  	 l_sql := REGEXP_REPLACE(l_sql, '[[:space:]]+(AND[[:space:]])', CHR(10) || '  AND ', 1, 0, 'i');
 52  	 l_sql := REGEXP_REPLACE(l_sql, '[[:space:]]+(OR[[:space:]])', CHR(10) || '  OR ', 1, 0, 'i');
 53  	 l_sql := REGEXP_REPLACE(l_sql, '[[:space:]]+(WHEN[[:space:]])', CHR(10) || 'WHEN ', 1, 0, 'i');
 54  	 l_sql := REGEXP_REPLACE(l_sql, '[[:space:]]+(VALUES[[:space:]])', CHR(10) || 'VALUES ', 1, 0, 'i');
 55  	 l_sql := REGEXP_REPLACE(l_sql, '[[:space:]]+(PARTITION[[:space:]])', CHR(10) || 'PARTITION ', 1, 0, 'i');
 56  	 l_sql := REGEXP_REPLACE(l_sql, '[[:space:]]+(SUBPARTITION[[:space:]])', CHR(10) || 'SUBPARTITION ', 1, 0, 'i');
 57  	 l_sql := REGEXP_REPLACE(l_sql, '[[:space:]]+(FOR[[:space:]]+EXCHANGE[[:space:]])', CHR(10) || 'FOR EXCHANGE ', 1, 0, 'i');
 58  	 l_sql := REGEXP_REPLACE(l_sql, '[[:space:]]+(WITH[[:space:]]+TABLE[[:space:]])', CHR(10) || 'WITH TABLE ', 1, 0, 'i');
 59  	 l_sql := REGEXP_REPLACE(l_sql, '[[:space:]]+(INCLUDING[[:space:]]+INDEXES)', CHR(10) || 'INCLUDING INDEXES', 1, 0, 'i');
 60  	 l_sql := REGEXP_REPLACE(l_sql, '[[:space:]]+(EXCLUDING[[:space:]]+INDEXES)', CHR(10) || 'EXCLUDING INDEXES', 1, 0, 'i');
 61  	 l_sql := REGEXP_REPLACE(l_sql, '[[:space:]]+(WITHOUT[[:space:]]+VALIDATION)', CHR(10) || 'WITHOUT VALIDATION', 1, 0, 'i');
 62  	 l_sql := REGEXP_REPLACE(l_sql, '[[:space:]]+(UPDATE[[:space:]]+GLOBAL[[:space:]]+INDEXES)', CHR(10) || 'UPDATE GLOBAL INDEXES', 1, 0, 'i');
 63  
 64  	 RETURN l_sql;
 65    END fn_format_sql_for_log;
 66  
 67    PROCEDURE prc_log_sql
 68    (
 69  	 p_log_id  IN NUMBER,
 70  	 p_sql	   IN CLOB,
 71  	 p_execute IN VARCHAR2
 72    )
 73    IS
 74  	 l_log_sql CLOB;
 75    BEGIN
 76  	 IF p_log_id IS NOT NULL THEN
 77  	   l_log_sql := fn_format_sql_for_log(p_sql);
 78  
 79  	   PKG_REPLICA_TL_LOGGING.prc_log
 80  	   (
 81  	     p_log_id	 => p_log_id,
 82  	     p_log_msg	 => CASE fn_normalize_execute(p_execute)
 83  			      WHEN 'Y' THEN TO_CLOB('Executing SQL:') || CHR(10)
 84  			      ELSE TO_CLOB('Preview SQL:') || CHR(10)
 85  			    END || l_log_sql,
 86  	     p_log_sttus => PKG_REPLICA_TL_LOGGING.g_sttus_running_const,
 87  	     p_log_type  => 'SQL'
 88  	   );
 89  	 END IF;
 90    END prc_log_sql;
 91  
 92    FUNCTION fn_assert_simple_name
 93    (
 94  	 p_name IN VARCHAR2
 95    )
 96    RETURN VARCHAR2
 97    IS
 98    BEGIN
 99  	 RETURN DBMS_ASSERT.SIMPLE_SQL_NAME(UPPER(TRIM(p_name)));
100    END fn_assert_simple_name;
101  
102    FUNCTION fn_assert_qualified_name
103    (
104  	 p_name IN VARCHAR2
105    )
106    RETURN VARCHAR2
107    IS
108    BEGIN
109  	 RETURN DBMS_ASSERT.QUALIFIED_SQL_NAME(UPPER(TRIM(p_name)));
110    END fn_assert_qualified_name;
111  
112    FUNCTION fn_run_into_sql
113    (
114  	 p_log_id  IN NUMBER,
115  	 p_sql	   IN CLOB,
116  	 p_execute IN VARCHAR2 DEFAULT 'Y'
117    )
118    RETURN NUMBER
119    IS
120  	 l_result NUMBER;
121  	 l_sql	  VARCHAR2(32767);
122    BEGIN
123  	 IF p_sql IS NULL THEN
124  	   raise_application_error(-20001, 'SQL text is required');
125  	 END IF;
126  
127  	 prc_log_sql(p_log_id => p_log_id, p_sql => p_sql, p_execute => p_execute);
128  
129  	 IF fn_normalize_execute(p_execute) = 'N' THEN
130  	   RETURN NULL;
131  	 END IF;
132  
133  	 l_sql := DBMS_LOB.SUBSTR(p_sql, 32767, 1);
134  	 EXECUTE IMMEDIATE l_sql INTO l_result;
135  
136  	 RETURN l_result;
137    END fn_run_into_sql;
138  
139    FUNCTION fn_run_sql
140    (
141  	 p_log_id  IN NUMBER,
142  	 p_sql	   IN CLOB,
143  	 p_execute IN VARCHAR2 DEFAULT 'Y'
144    )
145    RETURN NUMBER
146    IS
147  	 l_sql VARCHAR2(32767);
148    BEGIN
149  	 IF p_sql IS NULL THEN
150  	   raise_application_error(-20001, 'SQL text is required');
151  	 END IF;
152  
153  	 prc_log_sql(p_log_id => p_log_id, p_sql => p_sql, p_execute => p_execute);
154  
155  	 IF fn_normalize_execute(p_execute) = 'N' THEN
156  	   RETURN 0;
157  	 END IF;
158  
159  	 l_sql := DBMS_LOB.SUBSTR(p_sql, 32767, 1);
160  	 EXECUTE IMMEDIATE l_sql;
161  
162  	 RETURN SQL%ROWCOUNT;
163    END fn_run_sql;
164  
165    FUNCTION fn_run_sql_in_bind
166    (
167  	 p_log_id     IN NUMBER,
168  	 p_sql	      IN CLOB,
169  	 p_array_bind IN SYS.ODCIVARCHAR2LIST,
170  	 p_execute    IN VARCHAR2 DEFAULT 'Y'
171    )
172    RETURN NUMBER
173    IS
174  	 l_cursor_id INTEGER;
175  	 l_rows      INTEGER;
176  	 l_attempt   NUMBER := 0;
177    BEGIN
178  	 IF p_sql IS NULL THEN
179  	   raise_application_error(-20001, 'SQL text is required');
180  	 END IF;
181  
182  	 prc_log_sql(p_log_id => p_log_id, p_sql => p_sql, p_execute => p_execute);
183  
184  	 IF p_log_id IS NOT NULL AND p_array_bind IS NOT NULL THEN
185  	   PKG_REPLICA_TL_LOGGING.prc_log
186  	   (
187  	     p_log_id	 => p_log_id,
188  	     p_log_msg	 => 'Bind count: ' || p_array_bind.COUNT,
189  	     p_log_sttus => PKG_REPLICA_TL_LOGGING.g_sttus_running_const,
190  	     p_log_type  => 'SQL_BIND'
191  	   );
192  
193  	   FOR i IN 1 .. p_array_bind.COUNT LOOP
194  	     PKG_REPLICA_TL_LOGGING.prc_log
195  	     (
196  	       p_log_id    => p_log_id,
197  	       p_log_msg   => 'Bind ' || i || ': ' || NVL(p_array_bind(i), '<NULL>'),
198  	       p_log_sttus => PKG_REPLICA_TL_LOGGING.g_sttus_running_const,
199  	       p_log_type  => 'SQL_BIND'
200  	     );
201  	   END LOOP;
202  	 END IF;
203  
204  	 IF fn_normalize_execute(p_execute) = 'N' THEN
205  	   RETURN 0;
206  	 END IF;
207  
208  	 LOOP
209  	   l_attempt := l_attempt + 1;
210  
211  	   BEGIN
212  	     l_cursor_id := DBMS_SQL.OPEN_CURSOR;
213  	     DBMS_SQL.PARSE(l_cursor_id, p_sql, DBMS_SQL.NATIVE);
214  
215  	     IF p_array_bind IS NOT NULL THEN
216  	       FOR i IN 1 .. p_array_bind.COUNT LOOP
217  		 DBMS_SQL.BIND_VARIABLE(l_cursor_id, ':' || i, p_array_bind(i));
218  	       END LOOP;
219  	     END IF;
220  
221  	     l_rows := DBMS_SQL.EXECUTE(l_cursor_id);
222  	     DBMS_SQL.CLOSE_CURSOR(l_cursor_id);
223  
224  	     RETURN l_rows;
225  	   EXCEPTION
226  	     WHEN OTHERS THEN
227  	       IF DBMS_SQL.IS_OPEN(l_cursor_id) THEN
228  		 DBMS_SQL.CLOSE_CURSOR(l_cursor_id);
229  	       END IF;
230  
231  	       IF SQLCODE IN (-4061, -4062, -4068) AND l_attempt = 1 THEN
232  		 IF p_log_id IS NOT NULL THEN
233  		   PKG_REPLICA_TL_LOGGING.prc_log
234  		   (
235  		     p_log_id	 => p_log_id,
236  		     p_log_msg	 => 'Retrying SQL after remote package state changed: ' || SQLERRM,
237  		     p_log_sttus => PKG_REPLICA_TL_LOGGING.g_sttus_running_const,
238  		     p_log_type  => 'SQL_RETRY'
239  		   );
240  		 END IF;
241  	       ELSE
242  		 RAISE;
243  	       END IF;
244  	   END;
245  	 END LOOP;
246    END fn_run_sql_in_bind;
247  
248    FUNCTION fn_run_into_sql_in_bind
249    (
250  	 p_log_id     IN NUMBER,
251  	 p_sql	      IN CLOB,
252  	 p_array_bind IN SYS.ODCIVARCHAR2LIST,
253  	 p_execute    IN VARCHAR2 DEFAULT 'Y'
254    )
255    RETURN NUMBER
256    IS
257  	 l_cursor_id INTEGER;
258  	 l_rows      INTEGER;
259  	 l_result    NUMBER;
260  	 l_attempt   NUMBER := 0;
261    BEGIN
262  	 IF p_sql IS NULL THEN
263  	   raise_application_error(-20001, 'SQL text is required');
264  	 END IF;
265  
266  	 prc_log_sql(p_log_id => p_log_id, p_sql => p_sql, p_execute => p_execute);
267  
268  	 IF p_log_id IS NOT NULL AND p_array_bind IS NOT NULL THEN
269  	   PKG_REPLICA_TL_LOGGING.prc_log
270  	   (
271  	     p_log_id	 => p_log_id,
272  	     p_log_msg	 => 'Bind count: ' || p_array_bind.COUNT,
273  	     p_log_sttus => PKG_REPLICA_TL_LOGGING.g_sttus_running_const,
274  	     p_log_type  => 'SQL_BIND'
275  	   );
276  
277  	   FOR i IN 1 .. p_array_bind.COUNT LOOP
278  	     PKG_REPLICA_TL_LOGGING.prc_log
279  	     (
280  	       p_log_id    => p_log_id,
281  	       p_log_msg   => 'Bind ' || i || ': ' || NVL(p_array_bind(i), '<NULL>'),
282  	       p_log_sttus => PKG_REPLICA_TL_LOGGING.g_sttus_running_const,
283  	       p_log_type  => 'SQL_BIND'
284  	     );
285  	   END LOOP;
286  	 END IF;
287  
288  	 IF fn_normalize_execute(p_execute) = 'N' THEN
289  	   RETURN NULL;
290  	 END IF;
291  
292  	 LOOP
293  	   l_attempt := l_attempt + 1;
294  
295  	   BEGIN
296  	     l_cursor_id := DBMS_SQL.OPEN_CURSOR;
297  	     DBMS_SQL.PARSE(l_cursor_id, p_sql, DBMS_SQL.NATIVE);
298  
299  	     IF p_array_bind IS NOT NULL THEN
300  	       FOR i IN 1 .. p_array_bind.COUNT LOOP
301  		 DBMS_SQL.BIND_VARIABLE(l_cursor_id, ':' || i, p_array_bind(i));
302  	       END LOOP;
303  	     END IF;
304  
305  	     DBMS_SQL.DEFINE_COLUMN(l_cursor_id, 1, l_result);
306  	     l_rows := DBMS_SQL.EXECUTE(l_cursor_id);
307  
308  	     IF DBMS_SQL.FETCH_ROWS(l_cursor_id) > 0 THEN
309  	       DBMS_SQL.COLUMN_VALUE(l_cursor_id, 1, l_result);
310  	     END IF;
311  
312  	     DBMS_SQL.CLOSE_CURSOR(l_cursor_id);
313  
314  	     RETURN l_result;
315  	   EXCEPTION
316  	     WHEN OTHERS THEN
317  	       IF DBMS_SQL.IS_OPEN(l_cursor_id) THEN
318  		 DBMS_SQL.CLOSE_CURSOR(l_cursor_id);
319  	       END IF;
320  
321  	       IF SQLCODE IN (-4061, -4062, -4068) AND l_attempt = 1 THEN
322  		 IF p_log_id IS NOT NULL THEN
323  		   PKG_REPLICA_TL_LOGGING.prc_log
324  		   (
325  		     p_log_id	 => p_log_id,
326  		     p_log_msg	 => 'Retrying SQL after remote package state changed: ' || SQLERRM,
327  		     p_log_sttus => PKG_REPLICA_TL_LOGGING.g_sttus_running_const,
328  		     p_log_type  => 'SQL_RETRY'
329  		   );
330  		 END IF;
331  	       ELSE
332  		 RAISE;
333  	       END IF;
334  	   END;
335  	 END LOOP;
336    END fn_run_into_sql_in_bind;
337  
338    FUNCTION fn_col_count
339    (
340  	 p_line IN VARCHAR2,
341  	 p_sep	IN VARCHAR2 DEFAULT '|'
342    )
343    RETURN PLS_INTEGER
344    IS
345  	 l_count PLS_INTEGER := 1;
346  	 l_pos	 PLS_INTEGER := 0;
347    BEGIN
348  	 IF p_line IS NULL THEN
349  	   RETURN 0;
350  	 END IF;
351  
352  	 LOOP
353  	   l_pos := INSTR(p_line, p_sep, l_pos + 1);
354  	   EXIT WHEN l_pos = 0;
355  	   l_count := l_count + 1;
356  	 END LOOP;
357  
358  	 RETURN l_count;
359    END fn_col_count;
360  
361    FUNCTION fn_col_value
362    (
363  	 p_line   IN VARCHAR2,
364  	 p_col_no IN PLS_INTEGER,
365  	 p_sep	  IN VARCHAR2 DEFAULT '|'
366    )
367    RETURN VARCHAR2
368    IS
369  	 l_text      VARCHAR2(32767) := p_line;
370  	 l_start_pos PLS_INTEGER := 1;
371  	 l_end_pos   PLS_INTEGER;
372    BEGIN
373  	 FOR i IN 1 .. p_col_no LOOP
374  	   l_end_pos := INSTR(l_text, p_sep, l_start_pos);
375  
376  	   IF i = p_col_no THEN
377  	     IF l_end_pos = 0 THEN
378  	       RETURN SUBSTR(l_text, l_start_pos);
379  	     ELSE
380  	       RETURN SUBSTR(l_text, l_start_pos, l_end_pos - l_start_pos);
381  	     END IF;
382  	   END IF;
383  
384  	   IF l_end_pos = 0 THEN
385  	     RETURN NULL;
386  	   END IF;
387  
388  	   l_start_pos := l_end_pos + 1;
389  	 END LOOP;
390  
391  	 RETURN NULL;
392    END fn_col_value;
393  
394    FUNCTION fn_next_line
395    (
396  	 p_clob IN CLOB,
397  	 p_pos	IN OUT PLS_INTEGER
398    )
399    RETURN VARCHAR2
400    IS
401  	 l_end_pos PLS_INTEGER;
402  	 l_line    VARCHAR2(32767);
403    BEGIN
404  	 IF p_clob IS NULL OR p_pos > DBMS_LOB.GETLENGTH(p_clob) THEN
405  	   RETURN NULL;
406  	 END IF;
407  
408  	 l_end_pos := DBMS_LOB.INSTR(p_clob, CHR(10), p_pos);
409  
410  	 IF l_end_pos = 0 THEN
411  	   l_line := DBMS_LOB.SUBSTR(p_clob, 32767, p_pos);
412  	   p_pos := DBMS_LOB.GETLENGTH(p_clob) + 1;
413  	 ELSE
414  	   l_line := DBMS_LOB.SUBSTR(p_clob, l_end_pos - p_pos, p_pos);
415  	   p_pos := l_end_pos + 1;
416  	 END IF;
417  
418  	 RETURN l_line;
419    END fn_next_line;
420  
421    FUNCTION fn_sanitize
422    (
423  	 p_value    IN VARCHAR2,
424  	 p_null_text IN VARCHAR2 DEFAULT '-',
425  	 p_sep	    IN VARCHAR2 DEFAULT '|'
426    )
427    RETURN VARCHAR2
428    IS
429    BEGIN
430  	 IF p_value IS NULL OR TRIM(p_value) IS NULL THEN
431  	   RETURN p_null_text;
432  	 END IF;
433  
434  	 RETURN REPLACE(REPLACE(REPLACE(TRIM(p_value), CHR(13), ' '), CHR(10), ' '), p_sep, ' ');
435    END fn_sanitize;
436  
437    FUNCTION fn_format_table
438    (
439  	 p_columns	 IN VARCHAR2,
440  	 p_rows 	 IN CLOB,
441  	 p_col_align	 IN VARCHAR2 DEFAULT NULL,
442  	 p_separator	 IN VARCHAR2 DEFAULT '|',
443  	 p_null_text	 IN VARCHAR2 DEFAULT '-',
444  	 p_max_col_width IN NUMBER   DEFAULT 120,
445  	 p_box_style	 IN VARCHAR2 DEFAULT 'SIMPLE'
446    )
447    RETURN CLOB
448    IS
449  	 TYPE t_widths IS TABLE OF PLS_INTEGER INDEX BY PLS_INTEGER;
450  
451  	 l_widths	t_widths;
452  	 l_col_count	PLS_INTEGER;
453  	 l_max_width	PLS_INTEGER := LEAST(GREATEST(NVL(p_max_col_width, 120), 8), 300);
454  	 l_pos		PLS_INTEGER;
455  	 l_line 	VARCHAR2(32767);
456  	 l_value	VARCHAR2(32767);
457  	 l_sanitized	VARCHAR2(32767);
458  	 l_result	CLOB;
459  	 l_rows_count	NUMBER := 0;
460  	 l_box		VARCHAR2(20);
461  	 l_is_right	BOOLEAN;
462    BEGIN
463  	 l_box := UPPER(NVL(TRIM(p_box_style), 'SIMPLE'));
464  
465  	 IF l_box NOT IN ('NONE', 'SIMPLE') THEN
466  	   l_box := 'SIMPLE';
467  	 END IF;
468  
469  	 l_col_count := fn_col_count(p_columns, p_separator);
470  
471  	 IF l_col_count = 0 THEN
472  	   RETURN 'FORMAT_TABLE: no columns' || CHR(10);
473  	 END IF;
474  
475  	 -- pass 1: measure max widths per column
476  	 FOR i IN 1 .. l_col_count LOOP
477  	   l_value := fn_col_value(p_columns, i, p_separator);
478  	   l_widths(i) := LEAST(GREATEST(LENGTH(NVL(l_value, '-')), 1), l_max_width);
479  	 END LOOP;
480  
481  	 l_pos := 1;
482  
483  	 LOOP
484  	   l_line := fn_next_line(p_rows, l_pos);
485  	   EXIT WHEN l_line IS NULL;
486  	   CONTINUE WHEN TRIM(l_line) IS NULL;
487  
488  	   l_rows_count := l_rows_count + 1;
489  
490  	   FOR i IN 1 .. l_col_count LOOP
491  	     l_value := fn_col_value(l_line, i, p_separator);
492  	     l_sanitized := fn_sanitize(l_value, p_null_text, p_separator);
493  	     l_widths(i) := LEAST(GREATEST(l_widths(i), LENGTH(l_sanitized)), l_max_width);
494  	   END LOOP;
495  	 END LOOP;
496  
497  	 -- pass 2: build output
498  	 l_result := TO_CLOB('FORMAT_TABLE:' || CHR(10));
499  	 l_result := l_result || 'Columns : ' || l_col_count || CHR(10);
500  	 l_result := l_result || 'Rows	  : ' || l_rows_count || CHR(10) || CHR(10);
501  
502  	 -- header + top border
503  	 IF l_box = 'SIMPLE' THEN
504  	   l_result := l_result || '+';
505  	   FOR i IN 1 .. l_col_count LOOP
506  	     l_result := l_result || RPAD('-', l_widths(i) + 2, '-') || '+';
507  	   END LOOP;
508  	   l_result := l_result || CHR(10) || '|';
509  
510  	   FOR i IN 1 .. l_col_count LOOP
511  	     l_value := fn_col_value(p_columns, i, p_separator);
512  	     l_result := l_result || ' ' || RPAD(NVL(l_value, '-'), l_widths(i)) || ' |';
513  	   END LOOP;
514  
515  	   l_result := l_result || CHR(10) || '+';
516  	   FOR i IN 1 .. l_col_count LOOP
517  	     l_result := l_result || RPAD('-', l_widths(i) + 2, '-') || '+';
518  	   END LOOP;
519  	   l_result := l_result || CHR(10);
520  	 ELSE
521  	   FOR i IN 1 .. l_col_count LOOP
522  	     l_value := fn_col_value(p_columns, i, p_separator);
523  	     l_result := l_result || RPAD(NVL(l_value, '-'), l_widths(i));
524  	     l_result := l_result || CASE WHEN i < l_col_count THEN '  ' END;
525  	   END LOOP;
526  
527  	   l_result := l_result || CHR(10);
528  
529  	   FOR i IN 1 .. l_col_count LOOP
530  	     l_result := l_result || RPAD('-', l_widths(i), '-');
531  	     l_result := l_result || CASE WHEN i < l_col_count THEN '  ' END;
532  	   END LOOP;
533  
534  	   l_result := l_result || CHR(10);
535  	 END IF;
536  
537  	 -- data rows
538  	 l_pos := 1;
539  
540  	 LOOP
541  	   l_line := fn_next_line(p_rows, l_pos);
542  	   EXIT WHEN l_line IS NULL;
543  	   CONTINUE WHEN TRIM(l_line) IS NULL;
544  
545  	   IF l_box = 'SIMPLE' THEN
546  	     l_result := l_result || '|';
547  	   END IF;
548  
549  	   FOR i IN 1 .. l_col_count LOOP
550  	     l_value := fn_col_value(l_line, i, p_separator);
551  	     l_sanitized := fn_sanitize(l_value, p_null_text, p_separator);
552  	     l_is_right := p_col_align IS NOT NULL AND LENGTH(p_col_align) >= i AND SUBSTR(p_col_align, i, 1) = '>';
553  
554  	     IF l_box = 'SIMPLE' THEN
555  	       l_result := l_result || ' ' ||
556  		 CASE WHEN l_is_right THEN LPAD(l_sanitized, l_widths(i)) ELSE RPAD(l_sanitized, l_widths(i)) END ||
557  		 ' |';
558  	     ELSE
559  	       l_result := l_result ||
560  		 CASE WHEN l_is_right THEN LPAD(l_sanitized, l_widths(i)) ELSE RPAD(l_sanitized, l_widths(i)) END;
561  	       l_result := l_result || CASE WHEN i < l_col_count THEN '  ' END;
562  	     END IF;
563  	   END LOOP;
564  
565  	   l_result := l_result || CHR(10);
566  	 END LOOP;
567  
568  	 -- bottom border
569  	 IF l_box = 'SIMPLE' AND l_rows_count > 0 THEN
570  	   l_result := l_result || '+';
571  	   FOR i IN 1 .. l_col_count LOOP
572  	     l_result := l_result || RPAD('-', l_widths(i) + 2, '-') || '+';
573  	   END LOOP;
574  	   l_result := l_result || CHR(10);
575  	 END IF;
576  
577  	 RETURN l_result;
578    END fn_format_table;
579  END PKG_REPLICA_SQL;
580  /

