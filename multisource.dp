  8  	     "END_DATE" DATE,
  9  	     "INTERVAL_TIME" INTERVAL DAY (2) TO SECOND (6) GENERATED ALWAYS AS (NUMTODSINTERVAL("END_DATE"-"START_DATE",'DAY')) VIRTUAL ,
 10  	     "LOG_MSG" CLOB NOT NULL ENABLE,
 11  	     "LOG_JSON" CLOB,
 12  	     "LAST_ERR_CODE" VARCHAR2(30),
 13  	     "LAST_ERR_DESC" VARCHAR2(256),
 14  	     "INST_ID" NUMBER,
 15  	     "SID" NUMBER,
 16  	     "SERIAL#" NUMBER,
 17  	     "CLIENT_INFO" VARCHAR2(128),
 18  	     "MODULE" VARCHAR2(128),
 19  	     "CRTN_DT" DATE DEFAULT SYSDATE NOT NULL ENABLE,
 20  	     "CRTN_BY" VARCHAR2(128) DEFAULT sys_context('USERENV','SESSION_USER') NOT NULL ENABLE,
 21  	     "LAST_UPDT_DT" DATE DEFAULT SYSDATE NOT NULL ENABLE,
 22  	     "LAST_UPDT_BY" VARCHAR2(128) DEFAULT sys_context('USERENV','SESSION_USER') NOT NULL ENABLE
 23  	)
 24    PARTITION BY RANGE ("START_DATE") INTERVAL (NUMTOYMINTERVAL(1, 'MONTH'))
 25   (PARTITION "P_START"  VALUES LESS THAN (TO_DATE(' 2019-01-01 00:00:00', 'SYYYY-MM-DD HH24:MI:SS', 'NLS_CALENDAR=GREGORIAN')) ) ;

