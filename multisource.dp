  FUNCTION fn_get_row_count
  (
    p_owner             IN VARCHAR2,
    p_table_name        IN VARCHAR2,
    p_partition_name    IN VARCHAR2,
    p_subpartition_name IN VARCHAR2 DEFAULT NULL
  )
  RETURN NUMBER;

  PROCEDURE prc_cleanup_unit
  (
    p_owner             IN VARCHAR2,
    p_table_name        IN VARCHAR2,
    p_partition_name    IN VARCHAR2,
    p_subpartition_name IN VARCHAR2 DEFAULT NULL,
    p_mode              IN VARCHAR2 DEFAULT 'TRUNCATE',
