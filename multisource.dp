113    FUNCTION fn_sanitize_summary_cell
114    (
115  	 p_value IN VARCHAR2
116    )
117    RETURN VARCHAR2
118    IS
119    BEGIN
120  	 IF p_value IS NULL OR p_value = '#' THEN
121  	   RETURN '-';
122  	 END IF;
123  
124  	 RETURN REPLACE(REPLACE(REPLACE(TRIM(p_value), CHR(13), ' '), CHR(10), ' '), '|', '/');
125    END fn_sanitize_summary_cell;
126  
127    FUNCTION fn_summary_cell
128    (
129  	 p_value IN VARCHAR2
130    )
131    RETURN VARCHAR2
132    IS
133    BEGIN
134  	 RETURN fn_sanitize_summary_cell(p_value);
135    END fn_summary_cell;
136  
137  	FUNCTION fn_summary_row
138  	(
139  	  p_note		    IN VARCHAR2 DEFAULT NULL,
140  	  p_source_db_link	    IN VARCHAR2,
141  	  p_table_owner 	    IN VARCHAR2,
142  	  p_table_name		    IN VARCHAR2,
143  	  p_partition_name	    IN VARCHAR2,
144  	  p_subpartition_name	    IN VARCHAR2,
145  	  p_partition_high_value    IN VARCHAR2,
146  	  p_subpartition_high_value IN VARCHAR2,
147  	  p_archive_status	    IN VARCHAR2,
148  	  p_quality_status	    IN VARCHAR2,
149  	  p_truncate_status	    IN VARCHAR2,
150  	  p_source_row_count	    IN NUMBER DEFAULT NULL,
151  	  p_target_row_count	    IN NUMBER DEFAULT NULL
152  	)
153  	RETURN CLOB
154  	IS
155  	BEGIN
156  	  RETURN fn_sanitize_summary_cell(p_note) || '|' ||
157  		 fn_sanitize_summary_cell(p_source_db_link) || '|' ||
158  		 fn_sanitize_summary_cell(p_table_owner) || '|' ||
159  		 fn_sanitize_summary_cell(p_table_name) || '|' ||
160  		 fn_sanitize_summary_cell(p_partition_name) || '|' ||
161  		 fn_sanitize_summary_cell(p_subpartition_name) || '|' ||
162  		 fn_sanitize_summary_cell(p_partition_high_value) || '|' ||
163  		 fn_sanitize_summary_cell(p_subpartition_high_value) || '|' ||
164  		 fn_sanitize_summary_cell(p_archive_status) || '|' ||
165  		 fn_sanitize_summary_cell(p_quality_status) || '|' ||
166  		 fn_sanitize_summary_cell(p_truncate_status) || '|' ||
167  		 fn_sanitize_summary_cell(TO_CHAR(p_source_row_count)) || '|' ||
168  		 fn_sanitize_summary_cell(TO_CHAR(p_target_row_count)) || CHR(10);
169  	END fn_summary_row;
170  
171    PROCEDURE prc_log_summary
172    (
173  	 p_run_id	 IN NUMBER,
174  	 p_process_name  IN VARCHAR2,
175  	 p_columns	 IN VARCHAR2,
176  	 p_rows 	 IN CLOB,
177  	 p_max_col_width IN NUMBER DEFAULT 120
178    )
179    IS
180  	 l_msg CLOB;
181    BEGIN
182  	 IF p_rows IS NULL THEN
183  	   RETURN;
184  	 END IF;
185  
186  	 l_msg := 'SUMMARY:' || CHR(10) ||
187  		  'Process : ' || NVL(p_process_name, '-') || CHR(10) || CHR(10) ||
188  		  PKG_ARCHIVER_SQL.fn_format_table
189  		  (
190  		    p_columns	    => p_columns,
191  		    p_rows	    => p_rows,
192  		    p_null_text     => '-',
193  		    p_max_col_width => p_max_col_width,
194  		    p_box_style     => 'SIMPLE'
195  		  );
196  
197  	 prc_log_message
198  	 (
199  	   p_run_id   => p_run_id,
200  	   p_log_msg  => l_msg,
201  	   p_log_type => 'SUMMARY'
202  	 );
203    END prc_log_summary;
204  
205    PROCEDURE prc_finish_run
206    (
207  	 p_run_id	 IN NUMBER,
208  	 p_status	 IN VARCHAR2,
209  	 p_error_message IN VARCHAR2 DEFAULT NULL
210    )
211    IS
212  	 l_log_id   NUMBER;
213  	 l_run_type TBL_ARCHIVER_RUNS.RUN_TYPE%TYPE;
214    BEGIN
215  	 SELECT MSTR_LOG_ID, RUN_TYPE
216  	   INTO l_log_id, l_run_type
217  	   FROM TBL_ARCHIVER_RUNS
218  	  WHERE RUN_ID = p_run_id;
219  
220  	 UPDATE TBL_ARCHIVER_RUNS
221  	    SET RUN_STATUS = p_status,
222  		ENDED_AT = SYSTIMESTAMP,
223  		ERROR_MESSAGE = SUBSTR(p_error_message, 1, 4000),
224  		UPDATED_AT = SYSTIMESTAMP
225  	  WHERE RUN_ID = p_run_id;
226  
227  	 PKG_ARCHIVER_TL_LOGGING.prc_log
228  	 (
229  	   p_log_id	     => l_log_id,
230  	   p_mstr_log_id     => l_log_id,
231  	   p_log_categ	     => l_run_type,
232  	   p_mstr_fun	     => 'PKG_ARCHIVER_' || l_run_type,
233  	   p_log_sttus	     => p_status,
234  	   p_end_date	     => SYSDATE,
235  	   p_last_err_code   => CASE WHEN p_status = 'ERROR' THEN TO_CHAR(SQLCODE) END,
236  	   p_last_err_desc   => CASE WHEN p_status = 'ERROR' THEN SUBSTR(p_error_message, 1, 256) END,
237  	   p_log_type	     => CASE WHEN p_status = 'ERROR' THEN 'ERROR' ELSE 'TEXT' END,
238  	   p_log_msg	     => 'Finished ' || l_run_type || ' with status ' || p_status ||
239  				CASE WHEN p_error_message IS NOT NULL THEN ': ' || SUBSTR(p_error_message, 1, 3000) END
240  	 );
241    END prc_finish_run;
242  END PKG_ARCHIVER_LOG;
243  /

