SQL> @layer3_replica/packages/pkg_replica_log.body.sql
SQL> CREATE OR REPLACE PACKAGE BODY PKG_REPLICA_LOG
  2  AS
  3    /*
  4  	 Package      : PKG_REPLICA_LOG
  5  	 Developer    : Tomasz Lesinski
  6  	 Date	      : 2026-06-01
  7  	 Purpose      : Replica process logging - creates runs, logs messages,
  8  			handles errors, finishes runs
  9  
 10  	 Prerequisite : PKG_REPLICA_TL_LOGGING, TBL_REPLICA_RUNS, REPLICA_PROCESS_LOG_SEQ
 11  
 12  	 Change History:
 13  	 ------------------------------------------------------------------------------
 14  	 Version    Date	 Programmer	    Description
 15  	 ------------------------------------------------------------------------------
 16  	  1.0	     2026-06-01   Tomasz Lesinski    Initial version
 17    */
 18    FUNCTION fn_normalize_execute(p_execute IN VARCHAR2) RETURN VARCHAR2 IS
 19    BEGIN
 20  	 RETURN CASE WHEN UPPER(NVL(TRIM(p_execute), 'N')) = 'Y' THEN 'Y' ELSE 'N' END;
 21    END;
 22  
 23    FUNCTION fn_create_run
 24    (
 25  	 p_run_type	  IN VARCHAR2,
 26  	 p_source_db_link IN VARCHAR2,
 27  	 p_source_owner   IN VARCHAR2,
 28  	 p_source_table   IN VARCHAR2,
 29  	 p_execute	  IN VARCHAR2
 30    )
 31    RETURN NUMBER
 32    IS
 33  	 l_run_id	NUMBER;
 34  	 l_log_id	NUMBER;
 35  	 l_run_type	VARCHAR2(30);
 36  	 l_execute_flag VARCHAR2(1);
 37  	 l_source_db_link VARCHAR2(128);
 38  	 l_source_link_count PLS_INTEGER;
 39    BEGIN
 40  	 l_run_type := UPPER(TRIM(p_run_type));
 41  	 l_execute_flag := fn_normalize_execute(p_execute);
 42  	 l_log_id := REPLICA_PROCESS_LOG_SEQ.NEXTVAL;
 43  	 l_source_db_link := UPPER(TRIM(p_source_db_link));
 44  
 45  	 IF l_source_db_link IS NULL THEN
 46  	   SELECT MIN(source_db_link),
 47  		  COUNT(DISTINCT source_db_link)
 48  	     INTO l_source_db_link,
 49  		  l_source_link_count
 50  	     FROM TBL_REPLICA_TABLES
 51  	    WHERE enabled_flag = 'Y';
 52  
 53  	   IF l_source_link_count <> 1 THEN
 54  	     RAISE_APPLICATION_ERROR(
 55  	       -20066,
 56  	       'REPLICA aggregate runs require exactly one enabled ARCHIVER DB link; found ' || l_source_link_count
 57  	     );
 58  	   END IF;
 59  	 END IF;
 60  
 61  	 INSERT INTO TBL_REPLICA_RUNS
 62  	   (RUN_TYPE, RUN_STATUS, SOURCE_DB_LINK, SOURCE_OWNER, SOURCE_TABLE_NAME, MSTR_LOG_ID, EXECUTE_FLAG)
 63  	 VALUES
 64  	   (l_run_type, 'RUNNING', l_source_db_link, UPPER(p_source_owner), UPPER(p_source_table), l_log_id, l_execute_flag)
 65  	 RETURNING RUN_ID INTO l_run_id;
 66  
 67  	 RETURN l_run_id;
 68    END fn_create_run;
 69  
 70    FUNCTION fn_get_log_id
 71    (
 72  	 p_run_id IN NUMBER
 73    )
 74    RETURN NUMBER
 75    IS
 76  	 l_log_id NUMBER;
 77    BEGIN
 78  	 SELECT MSTR_LOG_ID
 79  	   INTO l_log_id
 80  	   FROM TBL_REPLICA_RUNS
 81  	  WHERE RUN_ID = p_run_id;
 82  
 83  	 RETURN l_log_id;
 84    END fn_get_log_id;
 85  
 86    PROCEDURE prc_log_message
 87    (
 88  	 p_run_id    IN NUMBER,
 89  	 p_log_msg   IN CLOB,
 90  	 p_log_type  IN VARCHAR2 DEFAULT 'TEXT',
 91  	 p_log_sttus IN VARCHAR2 DEFAULT PKG_REPLICA_TL_LOGGING.g_sttus_running_const
 92    )
 93    IS
 94  	 l_log_id NUMBER;
 95    BEGIN
 96  	 IF p_run_id IS NULL THEN
 97  	   RETURN;
 98  	 END IF;
 99  
100  	 l_log_id := fn_get_log_id(p_run_id);
101  
102  	 PKG_REPLICA_TL_LOGGING.prc_log
103  	 (
104  	   p_log_id	 => l_log_id,
105  	   p_mstr_log_id => l_log_id,
106  	   p_log_msg	 => p_log_msg,
107  	   p_log_sttus	 => p_log_sttus,
108  	   p_log_type	 => p_log_type
109  	 );
110    END prc_log_message;
111  
112    PROCEDURE prc_log_error_stack
113    (
114  	 p_run_id IN NUMBER
115    )
116    IS
117  	 l_log_id NUMBER;
118    BEGIN
119  	 IF p_run_id IS NULL THEN
120  	   RETURN;
121  	 END IF;
122  
123  	 l_log_id := fn_get_log_id(p_run_id);
124  	 PKG_REPLICA_TL_LOGGING.prc_error_stack
125  	 (
126  	   p_log_id	 => l_log_id,
127  	   p_mstr_log_id => l_log_id
128  	 );
129    END prc_log_error_stack;
130  
131    FUNCTION fn_summary_cell
132    (
133  	 p_value IN VARCHAR2
134    )
135    RETURN VARCHAR2
136    IS
137    BEGIN
138  	 IF p_value IS NULL OR p_value = '#' THEN
139  	   RETURN '-';
140  	 END IF;
141  
142  	 RETURN REPLACE(REPLACE(REPLACE(TRIM(p_value), CHR(13), ' '), CHR(10), ' '), '|', '/');
143    END fn_summary_cell;
144  
145    PROCEDURE prc_finish_run
146    (
147  	 p_run_id	 IN NUMBER,
148  	 p_status	 IN VARCHAR2,
149  	 p_error_message IN VARCHAR2 DEFAULT NULL
150    )
151    IS
152  	 l_log_id   NUMBER;
153  	 l_run_type TBL_REPLICA_RUNS.RUN_TYPE%TYPE;
154    BEGIN
155  	 SELECT MSTR_LOG_ID, RUN_TYPE
156  	   INTO l_log_id, l_run_type
157  	   FROM TBL_REPLICA_RUNS
158  	  WHERE RUN_ID = p_run_id;
159  
160  	 UPDATE TBL_REPLICA_RUNS
161  	    SET RUN_STATUS = p_status,
162  		ENDED_AT = SYSTIMESTAMP,
163  		ERROR_MESSAGE = SUBSTR(p_error_message, 1, 4000),
164  		UPDATED_AT = SYSTIMESTAMP
165  	  WHERE RUN_ID = p_run_id;
166  
167  	 PKG_REPLICA_TL_LOGGING.prc_log
168  	 (
169  	   p_log_id	     => l_log_id,
170  	   p_mstr_log_id     => l_log_id,
171  	   p_log_categ	     => l_run_type,
172  	   p_mstr_fun	     => 'PKG_REPLICA_' || l_run_type,
173  	   p_log_sttus	     => p_status,
174  	   p_end_date	     => SYSDATE,
175  	   p_last_err_code   => CASE WHEN p_status = 'ERROR' THEN TO_CHAR(SQLCODE) END,
176  	   p_last_err_desc   => CASE WHEN p_status = 'ERROR' THEN SUBSTR(p_error_message, 1, 256) END,
177  	   p_log_type	     => CASE WHEN p_status = 'ERROR' THEN 'ERROR' ELSE 'TEXT' END,
178  	   p_log_msg	     => 'Finished ' || l_run_type || ' with status ' || p_status ||
179  				CASE WHEN p_error_message IS NOT NULL THEN ': ' || SUBSTR(p_error_message, 1, 3000) END
180  	 );
181    END prc_finish_run;
182  END PKG_REPLICA_LOG;
183  /

