    (CLIENT_C, "Source business schemas"),
    (AGENT_C, "Layer 1: source-side helper"),
    (ARCH_C, "Layer 2: central control plane"),
    (REPL_C, "Layer 3: downstream replica"),
])
add_bullets(slide, Inches(4.0), Inches(5.0), Inches(8.5), Inches(1.8), [
