SQL> MERGE INTO TBL_ARCHIVER_TABLES dst
  2  USING (
  3    SELECT UPPER('&1') AS source_db_link,
  4  	      'CLIENT1' AS source_owner,
  5  	      'ORDERS_ARCH_SRC' AS source_table_name,
  6  	      UPPER('&&APPLICATION_SCHEMA') AS source_agent_schema,
  7  	      UPPER('&&APPLICATION_SCHEMA') AS target_owner,
  8  	      'TBL_ARCHIVER_ORDERS_SRC' AS target_table_name,
  9  	      'TRUNCATE' AS truncate_mode,
 10  	      4 AS parallel_degree,
 11  	      UPPER('&&DEFAULT_TABLESPACE') AS tablespace_name,
 12  	      'DATE ''2026-06-01''' AS last_business_date,
 13  	      30 AS days_online,
 14  	      'Y' AS enabled_flag
 15  	 FROM dual
 16  ) src
 17  ON (
 18    dst.source_db_link = src.source_db_link
 19    AND dst.source_owner = src.source_owner
 20    AND dst.source_table_name = src.source_table_name
 21  )
 22  WHEN MATCHED THEN UPDATE SET
 23    dst.source_agent_schema = src.source_agent_schema,
 24    dst.target_owner = src.target_owner,
 25    dst.target_table_name = src.target_table_name,
 26    dst.truncate_mode = src.truncate_mode,
