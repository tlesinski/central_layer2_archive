 30  
 31    FUNCTION fn_run_into_sql
 32    (
 33  	 p_log_id  IN NUMBER,
 34  	 p_sql	   IN CLOB,
 35  	 p_execute IN VARCHAR2 DEFAULT 'Y'
 36    )
 37    RETURN NUMBER;
 38  
 39    FUNCTION fn_run_sql
 40    (
 41  	 p_log_id  IN NUMBER,
 42  	 p_sql	   IN CLOB,
 43  	 p_execute IN VARCHAR2 DEFAULT 'Y'
 44    )
 45    RETURN NUMBER;
 46  
 47    FUNCTION fn_run_sql_in_bind
 48    (
 49  	 p_log_id     IN NUMBER,
 50  	 p_sql	      IN CLOB,
 51  	 p_array_bind IN SYS.ODCIVARCHAR2LIST,
 52  	 p_execute    IN VARCHAR2 DEFAULT 'Y'
 53    )
 54    RETURN NUMBER;
 55  
 56    FUNCTION fn_run_into_sql_in_bind
 57    (
 58  	 p_log_id     IN NUMBER,
 59  	 p_sql	      IN CLOB,
 60  	 p_array_bind IN SYS.ODCIVARCHAR2LIST,
 61  	 p_execute    IN VARCHAR2 DEFAULT 'Y'
 62    )
 63    RETURN NUMBER;
