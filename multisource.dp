Package created.

SQL> @layer3_replica/packages/pkg_replica_quality.body.sql
SQL> CREATE OR REPLACE PACKAGE BODY PKG_REPLICA_QUALITY
  2  AS
  3    FUNCTION fn_normalize_execute(p_execute IN VARCHAR2) RETURN VARCHAR2 IS
  4    BEGIN
  5  	 RETURN CASE WHEN UPPER(NVL(TRIM(p_execute), 'N')) = 'Y' THEN 'Y' ELSE 'N' END;
  6    END;
  7  
  8    FUNCTION fn_normalize_name(p_name IN VARCHAR2) RETURN VARCHAR2 IS
  9    BEGIN
 10  	 IF p_name IS NULL OR TRIM(p_name) IS NULL THEN
 11  	   RETURN NULL;
 12  	 END IF;
 13  	 RETURN PKG_REPLICA_SQL.fn_assert_simple_name(p_name);
 14    END;
 15  
 16    FUNCTION fn_qualified_table(p_owner IN VARCHAR2, p_table IN VARCHAR2) RETURN VARCHAR2 IS
 17    BEGIN
 18  	 RETURN PKG_REPLICA_SQL.fn_assert_simple_name(p_owner) || '.' || PKG_REPLICA_SQL.fn_assert_simple_name(p_table);
 19    END;
 20  
 21    FUNCTION fn_source_table
 22    (
 23  	 p_source_db_link    IN VARCHAR2,
 24  	 p_source_owner      IN VARCHAR2,
 25  	 p_source_table_name IN VARCHAR2
 26    )
 27    RETURN VARCHAR2
 28    IS
 29  	 l_table VARCHAR2(4000);
 30    BEGIN
 31  	 IF p_source_db_link IS NULL OR TRIM(p_source_db_link) IS NULL THEN
 32  	   RAISE_APPLICATION_ERROR(-20047, 'SOURCE_DB_LINK is required for layer 3 source row counts');
 33  	 END IF;
 34  
 35  	 l_table := fn_qualified_table(p_source_owner, p_source_table_name);
 36  
 37  	 l_table := l_table || '@' || PKG_REPLICA_SQL.fn_assert_simple_name(p_source_db_link);
 38  
 39  	 RETURN l_table;
 40    END;
 41  
 42    FUNCTION fn_high_value_to_date(p_high_value IN VARCHAR2) RETURN DATE IS
 43  	 l_date DATE;
 44    BEGIN
 45  	 IF p_high_value IS NULL OR UPPER(TRIM(p_high_value)) = 'MAXVALUE' THEN
 46  	   RETURN NULL;
 47  	 END IF;
 48  
 49  	 EXECUTE IMMEDIATE 'SELECT ' || p_high_value || ' FROM dual' INTO l_date;
 50  	 RETURN l_date;
 51    EXCEPTION
 52  	 WHEN OTHERS THEN
 53  	   RETURN NULL;
 54    END fn_high_value_to_date;
 55  
 56    FUNCTION fn_first_partition_key_column
 57    (
 58  	 p_owner IN VARCHAR2,
 59  	 p_table IN VARCHAR2
 60    )
 61    RETURN VARCHAR2
 62    IS
 63  	 l_column_name VARCHAR2(128);
 64    BEGIN
 65  	 SELECT column_name
 66  	   INTO l_column_name
 67  	   FROM all_part_key_columns
 68  	  WHERE owner = UPPER(p_owner)
 69  	    AND name = UPPER(p_table)
 70  	    AND object_type = 'TABLE'
 71  	    AND column_position = 1;
 72  
 73  	 RETURN PKG_REPLICA_SQL.fn_assert_simple_name(l_column_name);
 74    END fn_first_partition_key_column;
 75  
 76    FUNCTION fn_first_subpartition_key_column
 77    (
 78  	 p_owner IN VARCHAR2,
 79  	 p_table IN VARCHAR2
 80    )
 81    RETURN VARCHAR2
 82    IS
 83  	 l_column_name VARCHAR2(128);
 84    BEGIN
 85  	 SELECT column_name
 86  	   INTO l_column_name
 87  	   FROM all_subpart_key_columns
 88  	  WHERE owner = UPPER(p_owner)
 89  	    AND name = UPPER(p_table)
 90  	    AND object_type = 'TABLE'
 91  	    AND column_position = 1;
 92  
 93  	 RETURN PKG_REPLICA_SQL.fn_assert_simple_name(l_column_name);
 94    END fn_first_subpartition_key_column;
 95  
 96    PROCEDURE prc_quality
 97    (
 98  	 p_execute	     IN VARCHAR2 DEFAULT 'N',
 99  	 p_target_owner      IN VARCHAR2 DEFAULT NULL,
100  	 p_target_table_name IN VARCHAR2 DEFAULT NULL
101    )
102    IS
103  	 l_run_id	     NUMBER;
104  	 l_log_id	     NUMBER;
105  	 l_execute_flag      VARCHAR2(1);
106  	 l_target_owner      VARCHAR2(128);
107  	 l_target_table      VARCHAR2(128);
108  	 l_sql		     CLOB;
109  	 l_rows_available    NUMBER := 0;
110  	 l_source_rows	     NUMBER;
111  	 l_target_rows	     NUMBER;
112  	 l_units	     NUMBER := 0;
113  	 l_ok		     NUMBER := 0;
114  	 l_failed	     NUMBER := 0;
115  	 l_quality_status    VARCHAR2(1);
116  	 l_part_key_column   VARCHAR2(128);
117  	 l_sub_key_column    VARCHAR2(128);
118  	 l_high_date	     DATE;
119  	 l_low_date	     DATE;
120  	 l_summary	     CLOB := NULL;
121  	 l_table_summary     CLOB;
122  	 l_partition_columns VARCHAR2(1000) :=
123  	   'NOTE|SOURCE_PARTITION_NAME|SOURCE_SUBPARTITION_NAME|PARTITION_NAME|SUBPARTITION_NAME|PARTITION_HIGH_VALUE|SUBPARTITION_HIGH_VALUE|REPLICA_STATUS|QUALITY_STATUS|PURGE_STATUS|SOURCE_ROW_COUNT|TARGET_ROW_COUNT';
124    BEGIN
125  	 l_execute_flag := fn_normalize_execute(p_execute);
126  	 l_target_owner := fn_normalize_name(p_target_owner);
127  	 l_target_table := fn_normalize_name(p_target_table_name);
128  	 l_run_id := PKG_REPLICA_LOG.fn_create_run('QUALITY', NULL, NULL, NULL, l_execute_flag);
129  	 l_log_id := PKG_REPLICA_LOG.fn_get_log_id(l_run_id);
130  
131  	 PKG_REPLICA_LOG.prc_log_message(l_run_id, 'Started REPLICA QUALITY execute=' || l_execute_flag);
132  
133  	 l_sql :=
134  	   'SELECT COUNT(*) FROM VW_REPLICA_QUALITY_PARTITIONS ' ||
135  	   'WHERE (:1 IS NULL OR target_owner = :1) AND (:2 IS NULL OR target_table_name = :2)';
136  
137  	 l_rows_available := PKG_REPLICA_SQL.fn_run_into_sql_in_bind
138  	 (
139  	   p_log_id	=> l_log_id,
140  	   p_sql	=> l_sql,
141  	   p_array_bind => SYS.ODCIVARCHAR2LIST(l_target_owner, l_target_table),
142  	   p_execute	=> 'Y'
143  	 );
144  
145  	 FOR t IN (
146  	   SELECT DISTINCT source_db_link, source_owner, source_table_name, target_owner, target_table_name
147  	     FROM vw_replica_quality_partitions
148  	    WHERE (l_target_owner IS NULL OR target_owner = l_target_owner)
149  	      AND (l_target_table IS NULL OR target_table_name = l_target_table)
150  	    ORDER BY source_db_link, source_owner, source_table_name
151  	 ) LOOP
152  	   l_table_summary := NULL;
153  
154  	   FOR r IN (
155  	     SELECT *
156  	       FROM vw_replica_quality_partitions
157  	      WHERE source_db_link = t.source_db_link
158  		AND source_owner = t.source_owner
159  		AND source_table_name = t.source_table_name
160  		AND target_owner = t.target_owner
161  		AND target_table_name = t.target_table_name
162  	      ORDER BY partition_high_value, subpartition_high_value
163  	   ) LOOP
164  	     l_units := l_units + 1;
165  
166  	     l_part_key_column := fn_first_partition_key_column(r.target_owner, r.target_table_name);
167  	     l_high_date := fn_high_value_to_date(r.partition_high_value);
168  	     l_low_date := fn_high_value_to_date(r.prev_partition_high_value);
169  
170  	     IF l_high_date IS NULL THEN
171  	       RAISE_APPLICATION_ERROR(-20051, 'REPLICA QUALITY requires a DATE partition high value');
172  	     END IF;
173  
174  	     l_sql := 'SELECT COUNT(*) FROM ' ||
175  		      fn_source_table(r.source_db_link, r.source_owner, r.source_table_name) ||
176  		      ' WHERE ' || l_part_key_column || ' < DATE ''' || TO_CHAR(l_high_date, 'YYYY-MM-DD') || '''';
177  
178  	     IF l_low_date IS NOT NULL THEN
179  	       l_sql := l_sql || ' AND ' || l_part_key_column || ' >= DATE ''' || TO_CHAR(l_low_date, 'YYYY-MM-DD') || '''';
180  	     END IF;
181  
182  	     IF r.archive_unit_type = 'SUBPARTITION' THEN
183  	       l_sub_key_column := fn_first_subpartition_key_column(r.target_owner, r.target_table_name);
184  	       IF r.subpartition_high_value IS NULL OR TRIM(r.subpartition_high_value) = '#' THEN
185  		 RAISE_APPLICATION_ERROR(-20052, 'REPLICA QUALITY requires a list subpartition high value');
186  	       END IF;
187  	       l_sql := l_sql || ' AND ' || l_sub_key_column || ' IN (' || r.subpartition_high_value || ')';
188  	     END IF;
189  
190  	     l_source_rows := PKG_REPLICA_SQL.fn_run_into_sql(l_log_id, l_sql, 'Y');
191  
192  	     IF r.archive_unit_type = 'SUBPARTITION' THEN
193  	       l_sql := 'SELECT COUNT(*) FROM ' || fn_qualified_table(r.target_owner, r.target_table_name) ||
194  			' SUBPARTITION (' || PKG_REPLICA_SQL.fn_assert_simple_name(r.subpartition_name) || ')';
195  	     ELSE
196  	       l_sql := 'SELECT COUNT(*) FROM ' || fn_qualified_table(r.target_owner, r.target_table_name) ||
197  			' PARTITION (' || PKG_REPLICA_SQL.fn_assert_simple_name(r.partition_name) || ')';
198  	     END IF;
199  
200  	     l_target_rows := PKG_REPLICA_SQL.fn_run_into_sql(l_log_id, l_sql, 'Y');
201  	     l_quality_status := CASE WHEN l_source_rows = l_target_rows THEN 'Y' ELSE 'N' END;
202  
203  	     IF l_quality_status = 'Y' THEN
204  	       l_ok := l_ok + 1;
205  	     ELSE
206  	       l_failed := l_failed + 1;
207  	     END IF;
208  
209  	     DBMS_OUTPUT.PUT_LINE('REPLICA_QUALITY ' || r.source_db_link || '.' || r.source_owner || '.' ||
210  				  r.source_table_name || ' source=' || r.source_partition_name ||
211  				  CASE WHEN r.source_subpartition_name <> '#' THEN '.' || r.source_subpartition_name END ||
212  				  ' target=' || r.partition_name ||
213  				  CASE WHEN r.subpartition_name <> '#' THEN '.' || r.subpartition_name END ||
214  				  ' source_rows=' || l_source_rows ||
215  				  ' target_rows=' || l_target_rows ||
216  				  ' status=' || l_quality_status ||
217  				  ' execute=' || l_execute_flag);
218  
219  	     IF l_execute_flag = 'Y' THEN
220  	       UPDATE tbl_replica_partitions
221  		  SET source_row_count = l_source_rows,
222  		      target_row_count = l_target_rows,
223  		      quality_status = l_quality_status,
224  		      last_run_id = l_run_id,
225  		      error_message = CASE WHEN l_quality_status = 'Y' THEN NULL ELSE 'Source row count does not match target row count' END,
226  		      updated_at = SYSTIMESTAMP
227  		WHERE source_db_link = r.source_db_link
228  		  AND source_owner = r.source_owner
229  		  AND source_table_name = r.source_table_name
230  		  AND partition_high_value = r.partition_high_value
231  		  AND subpartition_high_value = r.subpartition_high_value;
232  
233  	       COMMIT;
234  	     END IF;
235  
236  	     l_table_summary := l_table_summary ||
237  	       TO_CLOB(PKG_REPLICA_LOG.fn_summary_cell(CASE WHEN l_quality_status = 'Y' THEN 'OK' ELSE 'MISMATCH' END)) || '|' ||
238  	       PKG_REPLICA_LOG.fn_summary_cell(r.source_partition_name) || '|' ||
239  	       PKG_REPLICA_LOG.fn_summary_cell(r.source_subpartition_name) || '|' ||
240  	       PKG_REPLICA_LOG.fn_summary_cell(r.partition_name) || '|' ||
241  	       PKG_REPLICA_LOG.fn_summary_cell(r.subpartition_name) || '|' ||
242  	       PKG_REPLICA_LOG.fn_summary_cell(r.partition_high_value) || '|' ||
243  	       PKG_REPLICA_LOG.fn_summary_cell(r.subpartition_high_value) || '|' ||
244  	       PKG_REPLICA_LOG.fn_summary_cell(r.replica_status) || '|' ||
245  	       PKG_REPLICA_LOG.fn_summary_cell(l_quality_status) || '|' ||
246  	       PKG_REPLICA_LOG.fn_summary_cell(r.purge_status) || '|' ||
247  	       PKG_REPLICA_LOG.fn_summary_cell(TO_CHAR(l_source_rows)) || '|' ||
248  	       PKG_REPLICA_LOG.fn_summary_cell(TO_CHAR(l_target_rows)) || CHR(10);
249  	   END LOOP;
250  
251  	   IF l_table_summary IS NOT NULL THEN
252  	     l_summary := l_summary ||
253  	       '=== TABLE: ' || t.source_db_link || '.' || t.source_owner || '.' || t.source_table_name || ' ===' || CHR(10) || CHR(10) ||
254  	       PKG_REPLICA_SQL.fn_format_table
255  	       (
256  		 p_columns => 'SOURCE_DB_LINK|TABLE_OWNER|TABLE_NAME|EXECUTE',
257  		 p_rows    => PKG_REPLICA_LOG.fn_summary_cell(t.source_db_link) || '|' ||
258  			      PKG_REPLICA_LOG.fn_summary_cell(t.source_owner) || '|' ||
259  			      PKG_REPLICA_LOG.fn_summary_cell(t.source_table_name) || '|' ||
260  			      PKG_REPLICA_LOG.fn_summary_cell(l_execute_flag) || CHR(10)
261  	       ) || CHR(10) ||
262  	       PKG_REPLICA_SQL.fn_format_table(l_partition_columns, l_table_summary) || CHR(10);
263  	   END IF;
264  	 END LOOP;
265  
266  	 DBMS_OUTPUT.PUT_LINE('REPLICA_QUALITY units=' || l_units || ' found=' || l_rows_available ||
267  			      ' ok=' || l_ok || ' failed=' || l_failed || ' execute=' || l_execute_flag);
268  
269  	 IF l_summary IS NOT NULL THEN
270  	   PKG_REPLICA_LOG.prc_log_message(l_run_id, l_summary, 'SUMMARY');
271  	 END IF;
272  
273  	 PKG_REPLICA_LOG.prc_finish_run(l_run_id, CASE WHEN l_failed > 0 THEN 'WARNING' ELSE 'SUCCESS' END);
274    EXCEPTION
275  	 WHEN OTHERS THEN
276  	   IF l_run_id IS NOT NULL THEN
277  	     PKG_REPLICA_LOG.prc_log_error_stack(l_run_id);
278  	     PKG_REPLICA_LOG.prc_finish_run(l_run_id, 'ERROR', SQLERRM);
279  	   END IF;
280  	   RAISE;
281    END prc_quality;
282  END PKG_REPLICA_QUALITY;
283  /

