SQL> @layer2_core/views/vw_archiver_source_partitions.sql
SQL> CREATE OR REPLACE VIEW VW_ARCHIVER_SOURCE_PARTITIONS
  2  AS
  3  WITH cfg AS (
  4    SELECT source_db_link,
  5  	      source_agent_schema,
  6  	      source_owner,
  7  	      source_table_name,
  8  	      target_owner,
  9  	      target_table_name
 10  	 FROM TBL_ARCHIVER_TABLES
 11  	WHERE enabled_flag = 'Y'
 12  ),
 13  src AS (
 14    SELECT c.source_db_link,
 15  	      c.source_agent_schema,
 16  	      c.source_owner,
 17  	      c.source_table_name,
 18  	      c.target_owner,
 19  	      c.target_table_name,
 20  	      CASE
 21  		WHEN x.subpartition_name IS NULL THEN 'PARTITION'
 22  		ELSE 'SUBPARTITION'
 23  	      END AS archive_unit_type,
 24  	      x.partition_name AS source_partition_name,
 25  	      NVL(x.subpartition_name, '#') AS source_subpartition_name,
 26  	      x.partition_name AS partition_name,
 27  	      NVL(x.subpartition_name, '#') AS subpartition_name,
 28  	      x.partition_high_value,
 29  	       NVL(x.subpartition_high_value, '#') AS subpartition_high_value,
 30  	       x.prev_partition_high_value,
 31  	       x.partition_position,
 32  	      NVL(x.subpartition_position, 0) AS subpartition_position
 33  	 FROM cfg c,
 34  	      XMLTABLE(
 35  		'/ROWSET/ROW'
 36  		PASSING DBMS_XMLGEN.GETXMLTYPE(
 37  		  'SELECT * FROM ' ||
 38  		  DBMS_ASSERT.SIMPLE_SQL_NAME(c.source_agent_schema) ||
 39  		  '.VW_AGENT_PARTITION_INFO' ||
 40  		  '@' || DBMS_ASSERT.SIMPLE_SQL_NAME(c.source_db_link) ||
 41  		  ' WHERE schema_name = ''' || REPLACE(UPPER(c.source_owner), '''', '''''') || '''' ||
 42  		  ' AND table_name = ''' || REPLACE(UPPER(c.source_table_name), '''', '''''') || ''''
 43  		)
 44  		COLUMNS
 45  		  schema_name		   VARCHAR2(128)  PATH 'SCHEMA_NAME',
 46  		  table_name		   VARCHAR2(128)  PATH 'TABLE_NAME',
 47  		  partition_name	   VARCHAR2(128)  PATH 'PARTITION_NAME',
 48  		  subpartition_name	   VARCHAR2(128)  PATH 'SUBPARTITION_NAME',
 49  		   partition_high_value     VARCHAR2(4000) PATH 'PARTITION_HIGH_VALUE',
 50  		   subpartition_high_value  VARCHAR2(4000) PATH 'SUBPARTITION_HIGH_VALUE',
 51  		   prev_partition_high_value VARCHAR2(4000) PATH 'PREV_PARTITION_HIGH_VALUE',
 52  		   partition_position	    NUMBER	   PATH 'PARTITION_POSITION',
 53  		   subpartition_position    NUMBER	   PATH 'SUBPARTITION_POSITION'
 54  	       ) x
 55  	 WHERE UPPER(TRIM(x.partition_high_value)) <> 'MAXVALUE'
 56  )
 57  SELECT source_db_link,
 58  	    source_agent_schema,
 59  	    source_owner,
 60  	    source_table_name,
 61  	    target_owner,
 62  	    target_table_name,
 63  	    archive_unit_type,
 64  	    source_partition_name,
 65  	    source_subpartition_name,
 66  	    partition_name,
 67  	    subpartition_name,
 68  	    partition_high_value,
 69  	    subpartition_high_value,
 70  	    prev_partition_high_value,
 71  	    partition_position,
 72  	    subpartition_position
 73    FROM src;

View created.

