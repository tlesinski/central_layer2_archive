SQL> MERGE INTO TBL_REPLICA_TABLES dst
  2  USING (
  3    SELECT UPPER('&1') AS source_db_link,
  4  	      UPPER('&&APPLICATION_SCHEMA') AS source_owner,
  5  	      'TBL_ARCHIVER_ORDERS_SRC' AS source_table_name,
  6  	      UPPER('&&APPLICATION_SCHEMA') AS target_owner,
  7  	      'TBL_REPLICA_ORDERS_SRC' AS target_table_name,
  8  	      4 AS parallel_degree,
  9  	      UPPER('&&DEFAULT_TABLESPACE') AS tablespace_name,
 10  	      365 AS days_online,
 11  	      'Y' AS enabled_flag
 12  	 FROM dual
 13  ) src
 14  ON (
 15    dst.source_db_link = src.source_db_link
 16    AND dst.source_owner = src.source_owner
 17    AND dst.source_table_name = src.source_table_name
 18  )
 19  WHEN MATCHED THEN UPDATE SET
 20    dst.target_owner = src.target_owner,
 21    dst.target_table_name = src.target_table_name,
 22    dst.parallel_degree = src.parallel_degree,
 23    dst.tablespace_name = src.tablespace_name,
 24    dst.days_online = src.days_online,
 25    dst.enabled_flag = src.enabled_flag,
 26    dst.updated_at = SYSTIMESTAMP
 27  WHEN NOT MATCHED THEN INSERT
 28    (source_db_link, source_owner, source_table_name, target_owner, target_table_name,
 29  	parallel_degree, tablespace_name, days_online, enabled_flag)
 30  VALUES
 31    (src.source_db_link, src.source_owner, src.source_table_name, src.target_owner, src.target_table_name,
 32  	src.parallel_degree, src.tablespace_name, src.days_online, src.enabled_flag);

