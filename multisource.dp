SQL> CREATE OR REPLACE PACKAGE PKG_REPLICA_QUALITY
  2  AS
  3    PROCEDURE prc_quality
  4    (
  5  	 p_execute	     IN VARCHAR2 DEFAULT 'N',
  6  	 p_target_owner      IN VARCHAR2 DEFAULT NULL,
  7  	 p_target_table_name IN VARCHAR2 DEFAULT NULL
  8    );
  9  END PKG_REPLICA_QUALITY;
