 19  	    p.source_row_count,
 20  	    p.target_row_count
 21    FROM tbl_replica_partitions p
 22    JOIN tbl_replica_tables t
 23  	 ON t.source_db_link = p.source_db_link
 24  	AND t.source_owner = p.source_owner
 25  	AND t.source_table_name = p.source_table_name
 26  	AND t.enabled_flag = 'Y'
 27   WHERE p.replica_status = 'Y'
 28  	AND p.quality_status = 'N';

