 34    JOIN tbl_replica_tables t
 35  	 ON t.source_db_link = p.source_db_link
 36  	AND t.source_owner = p.source_owner
 37  	AND t.source_table_name = p.source_table_name
 38  	AND t.enabled_flag = 'Y'
 39    JOIN base_dates b
 40  	 ON b.source_db_link = p.source_db_link
 41  	AND b.source_owner = p.source_owner
 42  	AND b.source_table_name = p.source_table_name
 43   WHERE p.replica_status = 'Y'
 44  	AND p.quality_status = 'Y'
 45  	AND p.purge_status = 'N'
 46  	AND FN_REPLICA_HIGH_VALUE_DATE(p.partition_high_value) <= b.base_date - t.days_online;

View created.

