SQL> CREATE TABLE TBL_REPLICA_PROCESS_LOG
  2  	(    "MSTR_LOG_ID" NUMBER NOT NULL ENABLE,
  3  	     "LOG_ID" NUMBER NOT NULL ENABLE,
  4  	     "LOG_CATEG" VARCHAR2(256),
  5  	     "MSTR_FUN" VARCHAR2(128),
  6  	     "LOG_STTUS" VARCHAR2(30) NOT NULL ENABLE,
