Package created.

SQL> @layer2_core/packages/pkg_archiver_truncate.body.sql
SQL> CREATE OR REPLACE PACKAGE BODY PKG_ARCHIVER_TRUNCATE
  2  AS
  3    /*
  4  	 Package      : PKG_ARCHIVER_TRUNCATE
  5  	 Developer    : Tomasz Lesinski
  6  	 Date	      : 2026-05-28
  7  	 Purpose      : Source truncate - request source truncate through layer 1 agent
  8  			after quality success, respecting RETENTION_RULE
  9  
 10  	 Prerequisite : PKG_ARCHIVER_SQL, PKG_ARCHIVER_LOG, PKG_AGENT_ARCHIVE,
 11  			VW_ARCHIVER_TRUNCATE_PARTITIONS
 12  
 13  	 Change History:
 14  	 ------------------------------------------------------------------------------
 15  	 Version    Date	 Programmer	    Description
 16  	 ------------------------------------------------------------------------------
 17  	 1.0	    2026-05-28	 Tomasz Lesinski    Initial version
 18  	 1.1	    2026-05-28	 Tomasz Lesinski    Add process summary logging
 19  	 1.2	    2026-05-29	 Tomasz Lesinski    Abort on invalid RETENTION_RULE
 20  	 1.3	    2026-05-29	 Tomasz Lesinski    Abort on invalid PRESERVE_RULE
 21  	  1.4	     2026-05-31   Tomasz Lesinski    Skip truncate when preserve_date IS NOT NULL;
 22  						      log as PRESERVED in summary with MAX_PRESERVE_DATE
 23  	  1.5	     2026-05-31   Tomasz Lesinski    Compact per-table summary, ORA-40478 fix
 24    */
 25    FUNCTION fn_normalize_execute(p_execute IN VARCHAR2) RETURN VARCHAR2 IS
 26    BEGIN
 27  	 RETURN CASE WHEN UPPER(NVL(TRIM(p_execute), 'N')) = 'Y' THEN 'Y' ELSE 'N' END;
 28    END;
 29  
 30    FUNCTION fn_normalize_name(p_name IN VARCHAR2) RETURN VARCHAR2 IS
 31    BEGIN
 32  	 IF p_name IS NULL OR TRIM(p_name) IS NULL THEN
 33  	   RETURN NULL;
 34  	 END IF;
 35  
 36  	 RETURN PKG_ARCHIVER_SQL.fn_assert_simple_name(p_name);
 37    END;
 38  
 39    FUNCTION fn_qualified_agent_procedure(p_agent_schema IN VARCHAR2, p_source_db_link IN VARCHAR2) RETURN VARCHAR2 IS
 40  	 l_name VARCHAR2(400);
 41    BEGIN
 42  	 l_name := PKG_ARCHIVER_SQL.fn_assert_simple_name(p_agent_schema) || '.PKG_AGENT_ARCHIVE.PRC_CLEANUP_UNIT';
 43  	 l_name := l_name || '@' || PKG_ARCHIVER_SQL.fn_assert_simple_name(p_source_db_link);
 44  	 RETURN l_name;
 45    END;
 46  
 47    PROCEDURE prc_truncate
 48    (
 49  	 p_execute	     IN VARCHAR2 DEFAULT 'N',
 50  	 p_target_owner      IN VARCHAR2 DEFAULT NULL,
 51  	 p_target_table_name IN VARCHAR2 DEFAULT NULL
 52    )
 53    IS
 54  	 l_run_id	   NUMBER;
 55  	 l_log_id	   NUMBER;
 56  	 l_execute_flag    VARCHAR2(1);
 57  	 l_target_owner    VARCHAR2(128);
 58  	 l_target_table    VARCHAR2(128);
 59  	 l_sql		   CLOB;
 60  	 l_rows_available  NUMBER := 0;
 61  	 l_agent_procedure VARCHAR2(400);
 62  	 l_units	   NUMBER := 0;
 63  	 l_truncated	   NUMBER := 0;
 64  	 l_preserved	   NUMBER := 0;
 65  	 l_tables	   NUMBER := 0;
 66  	 l_sql_rows	   NUMBER;
 67  	 l_summary	   CLOB := NULL;
 68  	 l_table_summary   CLOB;
 69  	 l_bad_tables	   NUMBER := 0;
 70  	 l_last_business_date_calc VARCHAR2(30);
 71  	 l_days_online		   VARCHAR2(30);
 72  	 l_cutoff_date		   VARCHAR2(30);
 73    BEGIN
 74  	 l_execute_flag := fn_normalize_execute(p_execute);
 75  	 l_target_owner := fn_normalize_name(p_target_owner);
 76  	 l_target_table := fn_normalize_name(p_target_table_name);
 77  	 l_run_id := PKG_ARCHIVER_LOG.fn_create_run('TRUNCATE', NULL, NULL, NULL, l_execute_flag);
 78  	 l_log_id := PKG_ARCHIVER_LOG.fn_get_log_id(l_run_id);
 79  
 80  	 PKG_ARCHIVER_LOG.prc_log_message
 81  	 (
 82  	   p_run_id  => l_run_id,
 83  	   p_log_msg => 'Started TRUNCATE with parameters:' || CHR(10) ||
 84  			'  p_execute	       => ' || l_execute_flag || CHR(10) ||
 85  			'  p_target_owner      => ' || NVL(l_target_owner, '<ALL>') || CHR(10) ||
 86  			'  p_target_table_name => ' || NVL(l_target_table, '<ALL>')
 87  	 );
 88  
 89  	 -- FOR bad IN (
 90  	 --   SELECT source_db_link, source_owner, source_table_name, retention_rule, retention_calc
 91  	 --	FROM TBL_ARCHIVER_TABLES
 92  	 --    WHERE retention_calc LIKE 'ERROR:%'
 93  	 --	 AND (l_target_owner IS NULL OR target_owner = l_target_owner)
 94  	 --	 AND (l_target_table IS NULL OR target_table_name = l_target_table)
 95  	 -- ) LOOP
 96  	 --   PKG_ARCHIVER_LOG.prc_log_message
 97  	 --   (
 98  	 --	p_run_id  => l_run_id,
 99  	 --	p_log_msg => 'ERROR: table ' || bad.source_owner || '.' || bad.source_table_name ||
100  	 --		     ' retention_rule "' || bad.retention_rule || '" - ' || bad.retention_calc
101  	 --   );
102  	 --   l_bad_tables := l_bad_tables + 1;
103  	 -- END LOOP;
104  
105  	 FOR bad IN (
106  	   SELECT source_db_link, source_owner, source_table_name, preserve_rule, preserve_calc
107  	     FROM TBL_ARCHIVER_TABLES
108  	    WHERE preserve_calc LIKE 'ERROR:%'
109  	      AND (l_target_owner IS NULL OR target_owner = l_target_owner)
110  	      AND (l_target_table IS NULL OR target_table_name = l_target_table)
111  	 ) LOOP
112  	   PKG_ARCHIVER_LOG.prc_log_message
113  	   (
114  	     p_run_id  => l_run_id,
115  	     p_log_msg => 'ERROR: table ' || bad.source_owner || '.' || bad.source_table_name ||
116  			  ' preserve_rule "' || bad.preserve_rule || '" - ' || bad.preserve_calc
117  	   );
118  	   l_bad_tables := l_bad_tables + 1;
119  	 END LOOP;
120  
121  	 IF l_bad_tables > 0 THEN
122  	   PKG_ARCHIVER_LOG.prc_log_message
123  	   (
124  	     p_run_id  => l_run_id,
125  	     p_log_msg => 'ERROR: ' || l_bad_tables || ' table(s) with invalid retention or preserve rule - aborting TRUNCATE'
126  	   );
127  	   PKG_ARCHIVER_LOG.prc_finish_run(l_run_id, 'ERROR', l_bad_tables || ' table(s) with invalid retention or preserve rule');
128  	   RAISE_APPLICATION_ERROR(-20001, l_bad_tables || ' table(s) with invalid retention or preserve rule. Fix before retrying.');
129  	 END IF;
130  
131  	 l_sql :=
132  	   'SELECT COUNT(*) ' ||
133  	   '  FROM VW_ARCHIVER_TRUNCATE_PARTITIONS ' ||
134  	   ' WHERE (:1 IS NULL OR target_owner = :1) ' ||
135  	   '   AND (:2 IS NULL OR target_table_name = :2)';
136  
137  	 l_rows_available := PKG_ARCHIVER_SQL.fn_run_into_sql_in_bind
138  	 (
139  	   p_log_id	=> l_log_id,
140  	   p_sql	=> l_sql,
141  	   p_array_bind => SYS.ODCIVARCHAR2LIST(l_target_owner, l_target_table),
142  	   p_execute	=> 'Y'
143  	 );
144  
145  	 FOR t IN (
146  	   SELECT DISTINCT source_db_link,
147  		  source_agent_schema,
148  		  source_owner,
149  		  source_table_name,
150  		  target_owner,
151  		  target_table_name
152  	     FROM VW_ARCHIVER_TRUNCATE_PARTITIONS
153  	    WHERE (l_target_owner IS NULL OR target_owner = l_target_owner)
154  	      AND (l_target_table IS NULL OR target_table_name = l_target_table)
155  	    ORDER BY source_db_link, source_owner, source_table_name
156  	 ) LOOP
157  	   l_tables := l_tables + 1;
158  	   l_table_summary := NULL;
159  	   l_agent_procedure := fn_qualified_agent_procedure(t.source_agent_schema, t.source_db_link);
160  	   l_sql := 'BEGIN ' || l_agent_procedure || '(:1, :2, :3, :4, :5, :6); END;';
161  
162  	   SELECT TO_CHAR(FN_ARCHIVER_HIGH_VALUE_DATE(a.last_business_date)),
163  		  TO_CHAR(a.days_online),
164  		  TO_CHAR(FN_ARCHIVER_HIGH_VALUE_DATE(a.last_business_date) - a.days_online)
165  	     INTO l_last_business_date_calc, l_days_online, l_cutoff_date
166  	     FROM TBL_ARCHIVER_TABLES a
167  	    WHERE a.source_db_link = t.source_db_link
168  	      AND a.source_owner = t.source_owner
169  	      AND a.source_table_name = t.source_table_name;
170  
171  	   FOR r IN (
172  	     SELECT p.*
173  	       FROM VW_ARCHIVER_TRUNCATE_PARTITIONS p
174  	      WHERE p.source_db_link = t.source_db_link
175  		AND p.source_owner = t.source_owner
176  		AND p.source_table_name = t.source_table_name
177  		AND p.target_owner = t.target_owner
178  		AND p.target_table_name = t.target_table_name
179  	      ORDER BY p.partition_high_value, p.subpartition_high_value
180  	   ) LOOP
181  	     l_units := l_units + 1;
182  
183  	     IF r.preserve_date IS NOT NULL THEN
184  	       DBMS_OUTPUT.PUT_LINE('PRESERVE ' || r.SOURCE_DB_LINK || '.' || r.SOURCE_OWNER || '.' ||
185  				    r.SOURCE_TABLE_NAME || ' source=' || r.SOURCE_PARTITION_NAME ||
186  				    CASE WHEN r.SOURCE_SUBPARTITION_NAME <> '#' THEN '.' || r.SOURCE_SUBPARTITION_NAME ELSE NULL END ||
187  				    ' target=' || r.PARTITION_NAME ||
188  				    CASE WHEN r.SUBPARTITION_NAME <> '#' THEN '.' || r.SUBPARTITION_NAME ELSE NULL END ||
189  				    ' preserve_date=' || TO_CHAR(r.preserve_date, 'YYYY-MM-DD') ||
190  				    ' execute=' || l_execute_flag);
191  	       l_preserved := l_preserved + 1;
192  	     ELSE
193  	       DBMS_OUTPUT.PUT_LINE('TRUNCATE ' || r.SOURCE_DB_LINK || '.' || r.SOURCE_OWNER || '.' ||
194  				    r.SOURCE_TABLE_NAME || ' source=' || r.SOURCE_PARTITION_NAME ||
195  				    CASE WHEN r.SOURCE_SUBPARTITION_NAME <> '#' THEN '.' || r.SOURCE_SUBPARTITION_NAME ELSE NULL END ||
196  				    ' target=' || r.PARTITION_NAME ||
197  				    CASE WHEN r.SUBPARTITION_NAME <> '#' THEN '.' || r.SUBPARTITION_NAME ELSE NULL END ||
198  				    ' cutoff=' || TO_CHAR(r.CUTOFF_DATE, 'YYYY-MM-DD') ||
199  				    ' execute=' || l_execute_flag);
200  
201  	       l_sql_rows := PKG_ARCHIVER_SQL.fn_run_sql_in_bind
202  	       (
203  		 p_log_id     => l_log_id,
204  		 p_sql	      => l_sql,
205  		 p_array_bind => SYS.ODCIVARCHAR2LIST
206  				 (
207  				   r.SOURCE_OWNER,
208  				   r.SOURCE_TABLE_NAME,
209  				   r.SOURCE_PARTITION_NAME,
210  				   CASE WHEN r.SOURCE_SUBPARTITION_NAME = '#' THEN NULL ELSE r.SOURCE_SUBPARTITION_NAME END,
211  				   'TRUNCATE',
212  				   l_execute_flag
213  				 ),
214  		 p_execute    => l_execute_flag
215  	       );
216  
217  	       IF l_execute_flag = 'Y' THEN
218  		 UPDATE TBL_ARCHIVER_PARTITIONS
219  		    SET TRUNCATE_STATUS = 'Y',
220  			LAST_RUN_ID = l_run_id,
221  			ERROR_MESSAGE = NULL,
222  			UPDATED_AT = SYSTIMESTAMP
223  		  WHERE SOURCE_DB_LINK = r.SOURCE_DB_LINK
224  		    AND SOURCE_OWNER = r.SOURCE_OWNER
225  		    AND SOURCE_TABLE_NAME = r.SOURCE_TABLE_NAME
226  		    AND PARTITION_HIGH_VALUE = r.PARTITION_HIGH_VALUE
227  		    AND SUBPARTITION_HIGH_VALUE = r.SUBPARTITION_HIGH_VALUE;
228  
229  		 l_truncated := l_truncated + SQL%ROWCOUNT;
230  		 COMMIT;
231  	       END IF;
232  	     END IF;
233  
234  	     l_table_summary := l_table_summary ||
235  	       TO_CLOB(PKG_ARCHIVER_LOG.fn_summary_cell(CASE WHEN r.preserve_date IS NOT NULL THEN
236  		 'PRESERVED per MAX_preserve_date=' || TO_CHAR(r.preserve_date, 'YYYY-MM-DD')
237  	       ELSE
238  		 CASE WHEN l_execute_flag = 'Y' THEN 'TRUNCATED' ELSE 'SKIP' END
239  END)) || '|' ||
240  	       PKG_ARCHIVER_LOG.fn_summary_cell(r.source_partition_name) || '|' ||
241  	       PKG_ARCHIVER_LOG.fn_summary_cell(r.source_subpartition_name) || '|' ||
242  	       PKG_ARCHIVER_LOG.fn_summary_cell(r.partition_name) || '|' ||
243  	       PKG_ARCHIVER_LOG.fn_summary_cell(r.subpartition_name) || '|' ||
244  	       PKG_ARCHIVER_LOG.fn_summary_cell(r.partition_high_value) || '|' ||
245  	       PKG_ARCHIVER_LOG.fn_summary_cell(r.subpartition_high_value) || '|' ||
246  	       PKG_ARCHIVER_LOG.fn_summary_cell(r.archive_status) || '|' ||
247  	       PKG_ARCHIVER_LOG.fn_summary_cell(r.quality_status) || '|' ||
248  	       PKG_ARCHIVER_LOG.fn_summary_cell(CASE WHEN l_execute_flag = 'Y' THEN 'Y' ELSE 'N' END) || '|' ||
249  	       PKG_ARCHIVER_LOG.fn_summary_cell(TO_CHAR(r.source_row_count)) || '|' ||
250  	       PKG_ARCHIVER_LOG.fn_summary_cell(TO_CHAR(r.target_row_count)) || '|' ||
251  	       PKG_ARCHIVER_LOG.fn_summary_cell(TO_CHAR(r.preserve_date, 'YYYY-MM-DD')) ||
252  	       CHR(10);
253  	   END LOOP; -- FOR r
254  
255  	   IF l_table_summary IS NOT NULL THEN
256  	     l_summary := l_summary ||
257  	       '=== TABLE: ' || t.source_db_link || '.' || t.source_owner || '.' || t.source_table_name || ' ===' || CHR(10) || CHR(10) ||
258  	       PKG_ARCHIVER_SQL.fn_format_table(
259  		 p_columns => 'SOURCE_DB_LINK|TABLE_OWNER|TABLE_NAME|EXECUTE|LAST_BUSINESS_DATE|DAYS_ONLINE|CUTOFF_DATE',
260  		 p_rows    => PKG_ARCHIVER_LOG.fn_summary_cell(t.source_db_link) || '|' ||
261  			      PKG_ARCHIVER_LOG.fn_summary_cell(t.source_owner) || '|' ||
262  			      PKG_ARCHIVER_LOG.fn_summary_cell(t.source_table_name) || '|' ||
263  			      PKG_ARCHIVER_LOG.fn_summary_cell(l_execute_flag) || '|' ||
264  			      PKG_ARCHIVER_LOG.fn_summary_cell(l_last_business_date_calc) || '|' ||
265  			      PKG_ARCHIVER_LOG.fn_summary_cell(l_days_online) || '|' ||
266  			      PKG_ARCHIVER_LOG.fn_summary_cell(l_cutoff_date) || CHR(10)
267  	       ) || CHR(10) ||
268  	       PKG_ARCHIVER_SQL.fn_format_table(
269  		 p_columns    => 'NOTE|SOURCE_PARTITION_NAME|SOURCE_SUBPARTITION_NAME|PARTITION_NAME|SUBPARTITION_NAME|PARTITION_HIGH_VALUE|SUBPARTITION_HIGH_VALUE|ARCHIVE_STATUS|QUALITY_STATUS|TRUNCATE_STATUS|SOURCE_ROW_COUNT|TARGET_ROW_COUNT|MAX_PRESERVE_DATE',
270  		 p_rows       => l_table_summary
271  	       ) || CHR(10);
272  	   END IF;
273  	 END LOOP; -- FOR t
274  
275  	 DBMS_OUTPUT.PUT_LINE(
276  	   'TRUNCATE tables=' || l_tables ||
277  	   ' units=' || l_units ||
278  	   ' found=' || l_rows_available ||
279  	   ' truncated=' || l_truncated ||
280  	   ' preserved=' || l_preserved ||
281  	   ' target_owner=' || NVL(l_target_owner, '<ALL>') ||
282  	   ' target_table=' || NVL(l_target_table, '<ALL>') ||
283  	   ' execute=' || l_execute_flag
284  	 );
285  
286  	 IF l_summary IS NOT NULL THEN
287  	   PKG_ARCHIVER_LOG.prc_log_message(l_run_id, l_summary, 'SUMMARY');
288  	 END IF;
289  
290  	 PKG_ARCHIVER_LOG.prc_finish_run(l_run_id, 'SUCCESS');
291    EXCEPTION
292  	 WHEN OTHERS THEN
293  	   IF l_run_id IS NOT NULL THEN
294  	     PKG_ARCHIVER_LOG.prc_log_error_stack(l_run_id);
295  	     PKG_ARCHIVER_LOG.prc_finish_run(l_run_id, 'ERROR', SQLERRM);
296  	   END IF;
297  	   RAISE;
298    END prc_truncate;
299  END PKG_ARCHIVER_TRUNCATE;
300  /

