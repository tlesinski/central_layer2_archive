SQL> CREATE OR REPLACE PACKAGE BODY PKG_ARCHIVER_LOG
  2  AS
  3    /*
  4  	 Package      : PKG_ARCHIVER_LOG
  5  	 Developer    : Tomasz Lesinski
  6  	 Date	      : 2026-05-28
  7  	 Purpose      : Archive process logging - creates runs, logs messages,
  8  			handles errors, finishes runs
  9  
 10  	 Prerequisite : PKG_ARCHIVER_TL_LOGGING, TBL_ARCHIVER_RUNS, ARCHIVER_PROCESS_LOG_SEQ
 11  
 12  	 Change History:
 13  	 ------------------------------------------------------------------------------
 14  	 Version    Date	 Programmer	    Description
 15  	 ------------------------------------------------------------------------------
 16  	  1.0	     2026-05-28   Tomasz Lesinski    Initial version
 17  	  1.1	     2026-05-31   Tomasz Lesinski    NOTE-first in fn_summary_row, fn_summary_cell added
 18    */
 19    FUNCTION fn_normalize_execute(p_execute IN VARCHAR2) RETURN VARCHAR2 IS
 20    BEGIN
 21  	 RETURN CASE WHEN UPPER(NVL(TRIM(p_execute), 'N')) = 'Y' THEN 'Y' ELSE 'N' END;
 22    END;
 23  
 24    FUNCTION fn_create_run
 25    (
 26  	 p_run_type	  IN VARCHAR2,
 27  	 p_source_db_link IN VARCHAR2,
 28  	 p_source_owner   IN VARCHAR2,
 29  	 p_source_table   IN VARCHAR2,
 30  	 p_execute	  IN VARCHAR2
 31    )
 32    RETURN NUMBER
 33    IS
 34  	 l_run_id	NUMBER;
 35  	 l_log_id	NUMBER;
 36  	 l_run_type	VARCHAR2(30);
 37  	 l_execute_flag VARCHAR2(1);
 38    BEGIN
 39  	 l_run_type := UPPER(TRIM(p_run_type));
 40  	 l_execute_flag := fn_normalize_execute(p_execute);
 41  	 l_log_id := ARCHIVER_PROCESS_LOG_SEQ.NEXTVAL;
 42  
 43  	 INSERT INTO TBL_ARCHIVER_RUNS
 44  	   (RUN_TYPE, RUN_STATUS, SOURCE_DB_LINK, SOURCE_OWNER, SOURCE_TABLE_NAME, MSTR_LOG_ID, EXECUTE_FLAG)
 45  	 VALUES
 46  	   (l_run_type, 'RUNNING', UPPER(p_source_db_link), UPPER(p_source_owner), UPPER(p_source_table), l_log_id, l_execute_flag)
 47  	 RETURNING RUN_ID INTO l_run_id;
 48  
 49  	 RETURN l_run_id;
 50    END fn_create_run;
 51  
 52    FUNCTION fn_get_log_id
 53    (
 54  	 p_run_id IN NUMBER
 55    )
 56    RETURN NUMBER
 57    IS
 58  	 l_log_id NUMBER;
 59    BEGIN
 60  	 SELECT MSTR_LOG_ID
 61  	   INTO l_log_id
 62  	   FROM TBL_ARCHIVER_RUNS
 63  	  WHERE RUN_ID = p_run_id;
 64  
 65  	 RETURN l_log_id;
 66    END fn_get_log_id;
 67  
 68    PROCEDURE prc_log_message
 69    (
 70  	 p_run_id    IN NUMBER,
 71  	 p_log_msg   IN CLOB,
 72  	 p_log_type  IN VARCHAR2 DEFAULT 'TEXT',
 73  	 p_log_sttus IN VARCHAR2 DEFAULT PKG_ARCHIVER_TL_LOGGING.g_sttus_running_const
 74    )
 75    IS
 76  	 l_log_id NUMBER;
 77    BEGIN
 78  	 IF p_run_id IS NULL THEN
 79  	   RETURN;
 80  	 END IF;
 81  
 82  	 l_log_id := fn_get_log_id(p_run_id);
 83  
 84  	 PKG_ARCHIVER_TL_LOGGING.prc_log
 85  	 (
 86  	   p_log_id	 => l_log_id,
 87  	   p_mstr_log_id => l_log_id,
 88  	   p_log_msg	 => p_log_msg,
 89  	   p_log_sttus	 => p_log_sttus,
 90  	   p_log_type	 => p_log_type
 91  	 );
 92    END prc_log_message;
 93  
 94    PROCEDURE prc_log_error_stack
 95    (
 96  	 p_run_id IN NUMBER
 97    )
 98    IS
 99  	 l_log_id NUMBER;
100    BEGIN
101  	 IF p_run_id IS NULL THEN
102  	   RETURN;
103  	 END IF;
104  
105  	 l_log_id := fn_get_log_id(p_run_id);
106  	 PKG_ARCHIVER_TL_LOGGING.prc_error_stack
107  	 (
108  	   p_log_id	 => l_log_id,
109  	   p_mstr_log_id => l_log_id
110  	 );
111    END prc_log_error_stack;
