SQL> CREATE OR REPLACE PACKAGE PKG_REPLICA_LOG
  2  AS
  3    /*
  4  	 Package      : PKG_REPLICA_LOG
  5  	 Developer    : Tomasz Lesinski
  6  	 Date	      : 2026-06-01
  7  	 Purpose      : Replica process logging - creates runs, logs messages,
  8  			handles errors, finishes runs
  9  
 10  	 Prerequisite : PKG_REPLICA_TL_LOGGING, TBL_REPLICA_RUNS, REPLICA_PROCESS_LOG_SEQ
 11  
 12  	 Change History:
 13  	 ------------------------------------------------------------------------------
 14  	 Version    Date	 Programmer	    Description
 15  	 ------------------------------------------------------------------------------
 16  	  1.0	     2026-06-01   Tomasz Lesinski    Initial version
 17    */
 18    FUNCTION fn_create_run
 19    (
 20  	 p_run_type	  IN VARCHAR2,
 21  	 p_source_db_link IN VARCHAR2,
 22  	 p_source_owner   IN VARCHAR2,
 23  	 p_source_table   IN VARCHAR2,
 24  	 p_execute	  IN VARCHAR2
 25    )
 26    RETURN NUMBER;
 27  
 28    FUNCTION fn_get_log_id
 29    (
 30  	 p_run_id IN NUMBER
 31    )
 32    RETURN NUMBER;
 33  
 34    PROCEDURE prc_log_message
 35    (
 36  	 p_run_id    IN NUMBER,
 37  	 p_log_msg   IN CLOB,
 38  	 p_log_type  IN VARCHAR2 DEFAULT 'TEXT',
 39  	 p_log_sttus IN VARCHAR2 DEFAULT PKG_REPLICA_TL_LOGGING.g_sttus_running_const
 40    );
 41  
 42    PROCEDURE prc_log_error_stack
 43    (
 44  	 p_run_id IN NUMBER
 45    );
 46  
 47    FUNCTION fn_summary_cell
 48    (
 49  	 p_value IN VARCHAR2
 50    )
 51    RETURN VARCHAR2;
 52  
 53    PROCEDURE prc_finish_run
 54    (
 55  	 p_run_id	 IN NUMBER,
 56  	 p_status	 IN VARCHAR2,
 57  	 p_error_message IN VARCHAR2 DEFAULT NULL
 58    );
 59  END PKG_REPLICA_LOG;
