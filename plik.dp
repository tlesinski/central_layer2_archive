@@seed_archiver_metadata.sql &&CLIENT1_SCHEMA ORDERS_LIST_NUMBER_SRC TBL_ARCHIVER_CLIENT1_LIST_NUMBER
@@seed_archiver_metadata.sql &&CLIENT1_SCHEMA ORDERS_LIST_VARCHAR_SRC TBL_ARCHIVER_CLIENT1_LIST_VARCHAR

