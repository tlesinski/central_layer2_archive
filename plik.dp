    "  'ARCHIVER_LINK',\n"
    "  'PARTMGR_ARCHIVER',\n"
    "  'TBL_ARCHIVER_CLIENT1_SUBPART',\n"
    "  'PARTMGR_REPLICA',\n"
    "  'TBL_REPLICA_CLIENT1_SUBPART',\n"
    "  4,\n"
    "  'RANGE',\n"
    "  'LIST',\n"
    "  '<partition_high_value> >= DATE ''2026-01-01'''\n"
    ");",
