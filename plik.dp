DIRPCK_20260702_152721_[FILE] seed/seed_client/seed_client_daily_interval_source.sql
DIRPCK_20260702_152721_[SIZE] 2277
DIRPCK_20260702_152721_[BEGIN]
SET DEFINE ON
SET SERVEROUTPUT ON
WHENEVER SQLERROR EXIT SQL.SQLCODE

BEGIN
  EXECUTE IMMEDIATE 'DROP TABLE ORDERS_DAILY_INT_SRC PURGE';
EXCEPTION
  WHEN OTHERS THEN
    IF SQLCODE != -942 THEN RAISE; END IF;
END;
/

CREATE TABLE ORDERS_DAILY_INT_SRC
(
  ORDER_ID NUMBER NOT NULL, CUSTOMER_ID NUMBER NOT NULL, ORDER_DATE DATE NOT NULL,
  STATUS_CODE VARCHAR2(20) NOT NULL, REGION_CODE VARCHAR2(10) NOT NULL,
  AMOUNT NUMBER(12,2) NOT NULL, CREATED_AT TIMESTAMP DEFAULT SYSTIMESTAMP NOT NULL
)
PARTITION BY RANGE (ORDER_DATE)
INTERVAL (NUMTODSINTERVAL(1, 'DAY'))
SUBPARTITION BY LIST (STATUS_CODE)
SUBPARTITION TEMPLATE
(
  SUBPARTITION SP_OPEN VALUES ('NEW', 'PAID'),
  SUBPARTITION SP_DONE VALUES ('SHIPPED', 'CLOSED')
)
(
  PARTITION P_ERROR VALUES LESS THAN
    (TO_DATE(' 1800-01-01 00:00:00', 'SYYYY-MM-DD HH24:MI:SS', 'NLS_CALENDAR=GREGORIAN')),
  PARTITION P20240501 VALUES LESS THAN (DATE '2024-05-02')
);

CREATE INDEX ORDERS_DAILY_INT_SRC_IDX1 ON ORDERS_DAILY_INT_SRC (CUSTOMER_ID, ORDER_DATE) LOCAL;
CREATE INDEX ORDERS_DAILY_INT_SRC_IDX2 ON ORDERS_DAILY_INT_SRC (REGION_CODE, ORDER_DATE) LOCAL;

INSERT INTO ORDERS_DAILY_INT_SRC
  (ORDER_ID, CUSTOMER_ID, ORDER_DATE, STATUS_CODE, REGION_CODE, AMOUNT)
SELECT LEVEL,
       &1 + MOD(LEVEL, 19),
       DATE '2024-05-01' + MOD(LEVEL - 1, 4),
       CASE MOD(LEVEL, 4) WHEN 0 THEN 'NEW' WHEN 1 THEN 'PAID' WHEN 2 THEN 'SHIPPED' ELSE 'CLOSED' END,
       CASE MOD(LEVEL, 3) WHEN 0 THEN 'N' WHEN 1 THEN 'S' ELSE 'W' END,
       ROUND(&2 + (LEVEL * &3), 2)
  FROM dual
CONNECT BY LEVEL <= 96;

COMMIT;

DECLARE
  l_new_name VARCHAR2(128);
BEGIN
  FOR r IN (
    SELECT PARTITION_NAME, PARTITION_POSITION
      FROM USER_TAB_PARTITIONS
     WHERE TABLE_NAME = 'ORDERS_DAILY_INT_SRC'
       AND PARTITION_NAME <> 'P_ERROR'
     ORDER BY PARTITION_POSITION
  ) LOOP
    l_new_name := 'P' || TO_CHAR(DATE '2024-05-01' + r.PARTITION_POSITION - 2, 'YYYYMMDD');
    IF r.PARTITION_NAME <> l_new_name THEN
      EXECUTE IMMEDIATE 'ALTER TABLE ORDERS_DAILY_INT_SRC RENAME PARTITION ' ||
                        DBMS_ASSERT.SIMPLE_SQL_NAME(r.PARTITION_NAME) || ' TO ' ||
                        DBMS_ASSERT.SIMPLE_SQL_NAME(l_new_name);
    END IF;
  END LOOP;
END;
/
DIRPCK_20260702_152721_[END]
DIRPCK_20260702_152721_[FILE] seed/seed_client/seed_client_list_date_source.sql
DIRPCK_20260702_152721_[SIZE] 891
DIRPCK_20260702_152721_[BEGIN]
BEGIN
  EXECUTE IMMEDIATE 'DROP TABLE ORDERS_LIST_DATE_SRC PURGE';
EXCEPTION
  WHEN OTHERS THEN
    IF SQLCODE != -942 THEN RAISE; END IF;
END;
/

CREATE TABLE ORDERS_LIST_DATE_SRC
(
  ORDER_ID    NUMBER NOT NULL,
  ORDER_DATE  DATE NOT NULL,
  STATUS_CODE VARCHAR2(20) NOT NULL,
  AMOUNT      NUMBER(12,2) NOT NULL,
  CREATED_AT  TIMESTAMP DEFAULT SYSTIMESTAMP NOT NULL
)
PARTITION BY LIST (ORDER_DATE)
(
  PARTITION P_ERROR VALUES (DATE '1800-01-01'),
  PARTITION P_DATE_1 VALUES (DATE '2024-01-15'),
  PARTITION P_DATE_2 VALUES (DATE '2024-02-15')
);

INSERT INTO ORDERS_LIST_DATE_SRC (ORDER_ID, ORDER_DATE, STATUS_CODE, AMOUNT)
SELECT LEVEL,
       CASE MOD(LEVEL, 2) WHEN 0 THEN DATE '2024-01-15' ELSE DATE '2024-02-15' END,
       CASE MOD(LEVEL, 2) WHEN 0 THEN 'PAID' ELSE 'CLOSED' END,
       LEVEL * 1.25
  FROM dual
CONNECT BY LEVEL <= 40;

COMMIT;
DIRPCK_20260702_152721_[END]
DIRPCK_20260702_152721_[FILE] seed/seed_client/seed_client_list_number_source.sql
DIRPCK_20260702_152721_[SIZE] 877
DIRPCK_20260702_152721_[BEGIN]
BEGIN
  EXECUTE IMMEDIATE 'DROP TABLE ORDERS_LIST_NUMBER_SRC PURGE';
EXCEPTION
  WHEN OTHERS THEN
    IF SQLCODE != -942 THEN RAISE; END IF;
END;
/

CREATE TABLE ORDERS_LIST_NUMBER_SRC
(
  ORDER_ID    NUMBER NOT NULL,
  BUCKET_ID   NUMBER NOT NULL,
  STATUS_CODE VARCHAR2(20) NOT NULL,
  AMOUNT      NUMBER(12,2) NOT NULL,
  CREATED_AT  TIMESTAMP DEFAULT SYSTIMESTAMP NOT NULL
)
PARTITION BY LIST (BUCKET_ID)
(
  PARTITION P_ERROR VALUES (-999999999),
  PARTITION P_BUCKET_LOW VALUES (10, 11),
  PARTITION P_BUCKET_HIGH VALUES (20, 21)
);

INSERT INTO ORDERS_LIST_NUMBER_SRC (ORDER_ID, BUCKET_ID, STATUS_CODE, AMOUNT)
SELECT LEVEL,
       CASE MOD(LEVEL, 4) WHEN 0 THEN 10 WHEN 1 THEN 11 WHEN 2 THEN 20 ELSE 21 END,
       CASE MOD(LEVEL, 2) WHEN 0 THEN 'PAID' ELSE 'CLOSED' END,
       LEVEL * 2.50
  FROM dual
CONNECT BY LEVEL <= 40;

COMMIT;
DIRPCK_20260702_152721_[END]
DIRPCK_20260702_152721_[FILE] seed/seed_client/seed_client_list_varchar_source.sql
DIRPCK_20260702_152721_[SIZE] 1100
DIRPCK_20260702_152721_[BEGIN]
BEGIN
  EXECUTE IMMEDIATE 'DROP TABLE ORDERS_LIST_VARCHAR_SRC PURGE';
EXCEPTION
  WHEN OTHERS THEN
    IF SQLCODE != -942 THEN RAISE; END IF;
END;
/

CREATE TABLE ORDERS_LIST_VARCHAR_SRC
(
  ORDER_ID    NUMBER NOT NULL,
  REGION_CODE VARCHAR2(10) NOT NULL,
  STATUS_CODE VARCHAR2(20) NOT NULL,
  AMOUNT      NUMBER(12,2) NOT NULL,
  CREATED_AT  TIMESTAMP DEFAULT SYSTIMESTAMP NOT NULL
)
PARTITION BY LIST (REGION_CODE)
SUBPARTITION BY LIST (STATUS_CODE)
SUBPARTITION TEMPLATE
(
  SUBPARTITION SP_OPEN VALUES ('NEW', 'PAID'),
  SUBPARTITION SP_DONE VALUES ('SHIPPED', 'CLOSED')
)
(
  PARTITION P_ERROR VALUES ('#ERROR#'),
  PARTITION P_REGION_NS VALUES ('N', 'S'),
  PARTITION P_REGION_WE VALUES ('W', 'E')
);

INSERT INTO ORDERS_LIST_VARCHAR_SRC (ORDER_ID, REGION_CODE, STATUS_CODE, AMOUNT)
SELECT LEVEL,
       CASE MOD(LEVEL, 4) WHEN 0 THEN 'N' WHEN 1 THEN 'S' WHEN 2 THEN 'W' ELSE 'E' END,
       CASE MOD(LEVEL, 4) WHEN 0 THEN 'NEW' WHEN 1 THEN 'PAID' WHEN 2 THEN 'SHIPPED' ELSE 'CLOSED' END,
       LEVEL * 3.75
  FROM dual
CONNECT BY LEVEL <= 80;

COMMIT;
DIRPCK_20260702_152721_[END]
DIRPCK_20260702_152721_[FILE] seed/seed_client/seed_client_source.sql
DIRPCK_20260702_152721_[SIZE] 2361
DIRPCK_20260702_152721_[BEGIN]
SET DEFINE ON
SET SERVEROUTPUT ON
WHENEVER SQLERROR EXIT SQL.SQLCODE

BEGIN
  EXECUTE IMMEDIATE 'DROP TABLE ORDERS_ARCH_SRC PURGE';
EXCEPTION
  WHEN OTHERS THEN
    IF SQLCODE != -942 THEN
      RAISE;
    END IF;
END;
/

CREATE TABLE ORDERS_ARCH_SRC
(
  ORDER_ID     NUMBER NOT NULL,
  CUSTOMER_ID  NUMBER NOT NULL,
  ORDER_DATE   DATE NOT NULL,
  STATUS_CODE  VARCHAR2(20) NOT NULL,
  AMOUNT       NUMBER(12,2) NOT NULL,
  CREATED_AT   TIMESTAMP DEFAULT SYSTIMESTAMP NOT NULL,
  CONSTRAINT ORDERS_ARCH_SRC_PK PRIMARY KEY (ORDER_ID, ORDER_DATE)
)
PARTITION BY RANGE (ORDER_DATE)
(
  PARTITION P_ERROR VALUES LESS THAN
    (TO_DATE(' 1800-01-01 00:00:00', 'SYYYY-MM-DD HH24:MI:SS', 'NLS_CALENDAR=GREGORIAN')),
  PARTITION P202401 VALUES LESS THAN (DATE '2024-02-01'),
  PARTITION P202402 VALUES LESS THAN (DATE '2024-03-01'),
  PARTITION P202403 VALUES LESS THAN (DATE '2024-04-01'),
  PARTITION P202404 VALUES LESS THAN (DATE '2024-05-01'),
  PARTITION P202512 VALUES LESS THAN (DATE '2026-01-01'),
  PARTITION P202601 VALUES LESS THAN (DATE '2026-02-01'),
  PARTITION P202602 VALUES LESS THAN (DATE '2026-03-01'),
  PARTITION P202603 VALUES LESS THAN (DATE '2026-04-01'),
  PARTITION P202604 VALUES LESS THAN (DATE '2026-05-01'),
  PARTITION P202605 VALUES LESS THAN (DATE '2026-06-01'),
  PARTITION PMAX VALUES LESS THAN (MAXVALUE)
);

CREATE INDEX ORDERS_ARCH_SRC_IDX1 ON ORDERS_ARCH_SRC (CUSTOMER_ID, ORDER_DATE) LOCAL;
CREATE INDEX ORDERS_ARCH_SRC_IDX2 ON ORDERS_ARCH_SRC (STATUS_CODE, ORDER_DATE) LOCAL;

INSERT INTO ORDERS_ARCH_SRC (ORDER_ID, CUSTOMER_ID, ORDER_DATE, STATUS_CODE, AMOUNT)
SELECT LEVEL,
       1000 + MOD(LEVEL, 17),
       CASE
         WHEN LEVEL <= 250 THEN DATE '2024-01-01' + MOD(LEVEL - 1, 115)
         WHEN LEVEL <= 280 THEN DATE '2025-12-01' + (LEVEL - 251)
         WHEN LEVEL <= 310 THEN DATE '2026-01-01' + (LEVEL - 281)
         WHEN LEVEL <= 338 THEN DATE '2026-02-01' + (LEVEL - 311)
         WHEN LEVEL <= 369 THEN DATE '2026-03-01' + (LEVEL - 339)
         WHEN LEVEL <= 399 THEN DATE '2026-04-01' + (LEVEL - 370)
         ELSE DATE '2026-05-01' + (LEVEL - 400)
       END,
       CASE MOD(LEVEL, 4) WHEN 0 THEN 'NEW' WHEN 1 THEN 'PAID' WHEN 2 THEN 'SHIPPED' ELSE 'CLOSED' END,
       ROUND(10 + (LEVEL * 1.37), 2)
  FROM dual
CONNECT BY LEVEL <= &1;

COMMIT;
DIRPCK_20260702_152721_[END]
DIRPCK_20260702_152721_[FILE] seed/seed_client/seed_client_subpart_source.sql
DIRPCK_20260702_152721_[SIZE] 2562
DIRPCK_20260702_152721_[BEGIN]
SET DEFINE ON
SET SERVEROUTPUT ON
WHENEVER SQLERROR EXIT SQL.SQLCODE

BEGIN
  EXECUTE IMMEDIATE 'DROP TABLE ORDERS_SUBPART_SRC PURGE';
EXCEPTION
  WHEN OTHERS THEN
    IF SQLCODE != -942 THEN RAISE; END IF;
END;
/

CREATE TABLE ORDERS_SUBPART_SRC
(
  ORDER_ID NUMBER NOT NULL, CUSTOMER_ID NUMBER NOT NULL, ORDER_DATE DATE NOT NULL,
  STATUS_CODE VARCHAR2(20) NOT NULL, REGION_CODE VARCHAR2(10) NOT NULL,
  AMOUNT NUMBER(12,2) NOT NULL, CREATED_AT TIMESTAMP DEFAULT SYSTIMESTAMP NOT NULL
)
PARTITION BY RANGE (ORDER_DATE)
SUBPARTITION BY LIST (STATUS_CODE)
SUBPARTITION TEMPLATE
(
  SUBPARTITION SP_OPEN VALUES ('NEW', 'PAID'),
  SUBPARTITION SP_DONE VALUES ('SHIPPED', 'CLOSED')
)
(
  PARTITION P_ERROR VALUES LESS THAN
    (TO_DATE(' 1800-01-01 00:00:00', 'SYYYY-MM-DD HH24:MI:SS', 'NLS_CALENDAR=GREGORIAN')),
  PARTITION P202401 VALUES LESS THAN (DATE '2024-02-01'),
  PARTITION P202402 VALUES LESS THAN (DATE '2024-03-01'),
  PARTITION P202403 VALUES LESS THAN (DATE '2024-04-01'),
  PARTITION P202404 VALUES LESS THAN (DATE '2024-05-01'),
  PARTITION P202512 VALUES LESS THAN (DATE '2026-01-01'),
  PARTITION P202601 VALUES LESS THAN (DATE '2026-02-01'),
  PARTITION P202602 VALUES LESS THAN (DATE '2026-03-01'),
  PARTITION P202603 VALUES LESS THAN (DATE '2026-04-01'),
  PARTITION P202604 VALUES LESS THAN (DATE '2026-05-01'),
  PARTITION P202605 VALUES LESS THAN (DATE '2026-06-01'),
  PARTITION PMAX VALUES LESS THAN (MAXVALUE)
);

CREATE INDEX ORDERS_SUBPART_SRC_IDX1 ON ORDERS_SUBPART_SRC (CUSTOMER_ID, ORDER_DATE) LOCAL;
CREATE INDEX ORDERS_SUBPART_SRC_IDX2 ON ORDERS_SUBPART_SRC (REGION_CODE, ORDER_DATE) LOCAL;

INSERT INTO ORDERS_SUBPART_SRC
  (ORDER_ID, CUSTOMER_ID, ORDER_DATE, STATUS_CODE, REGION_CODE, AMOUNT)
SELECT LEVEL,
       &1 + MOD(LEVEL, 23),
       CASE
         WHEN LEVEL <= 360 THEN DATE '2024-01-01' + MOD(LEVEL - 1, 115)
         WHEN LEVEL <= 390 THEN DATE '2025-12-01' + (LEVEL - 361)
         WHEN LEVEL <= 420 THEN DATE '2026-01-01' + (LEVEL - 391)
         WHEN LEVEL <= 448 THEN DATE '2026-02-01' + (LEVEL - 421)
         WHEN LEVEL <= 479 THEN DATE '2026-03-01' + (LEVEL - 449)
         WHEN LEVEL <= 509 THEN DATE '2026-04-01' + (LEVEL - 480)
         ELSE DATE '2026-05-01' + (LEVEL - 510)
       END,
       CASE MOD(LEVEL, 4) WHEN 0 THEN 'NEW' WHEN 1 THEN 'PAID' WHEN 2 THEN 'SHIPPED' ELSE 'CLOSED' END,
       CASE MOD(LEVEL, 3) WHEN 0 THEN 'N' WHEN 1 THEN 'S' ELSE 'W' END,
       ROUND(&3 + (LEVEL * &4), 2)
  FROM dual
CONNECT BY LEVEL <= &2;

COMMIT;
DIRPCK_20260702_152721_[END]
