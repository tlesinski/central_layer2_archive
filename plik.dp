DIRPCK_20260702_152721_[FILE] tests/test_replica/001_metadata.sql
DIRPCK_20260702_152721_[SIZE] 2203
DIRPCK_20260702_152721_[BEGIN]
PROMPT REPLICA 001 - metadata

CONNECT &&ACTIVE_REPLICA_SCHEMA/"&&ACTIVE_REPLICA_PASSWORD"@&&ACTIVE_REPLICA_CONNECT

DECLARE
  l_count NUMBER;
BEGIN
  SELECT COUNT(*)
    INTO l_count
    FROM TBL_REPLICA_TABLES
   WHERE SOURCE_OWNER = UPPER('&&ACTIVE_ARCHIVER_SCHEMA')
     AND SOURCE_TABLE_NAME IN
         ('TBL_ARCHIVER_CLIENT1_ORDERS', 'TBL_ARCHIVER_CLIENT1_SUBPART', 'TBL_ARCHIVER_CLIENT1_DAILY_INT',
          'TBL_ARCHIVER_CLIENT2_ORDERS', 'TBL_ARCHIVER_CLIENT2_SUBPART', 'TBL_ARCHIVER_CLIENT2_DAILY_INT',
          'TBL_ARCHIVER_CLIENT1_LIST_DATE', 'TBL_ARCHIVER_CLIENT1_LIST_NUMBER', 'TBL_ARCHIVER_CLIENT1_LIST_VARCHAR');

  IF l_count != 9 THEN
    RAISE_APPLICATION_ERROR(-20580, 'REPLICA expected 9 seeded table configs, got ' || l_count);
  END IF;

  SELECT COUNT(*)
    INTO l_count
    FROM TBL_REPLICA_TABLES
   WHERE SOURCE_DB_LINK IS NULL
      OR UPPER(TRIM(SOURCE_DB_LINK)) IN ('LOCAL', 'NONE');

  IF l_count != 0 THEN
    RAISE_APPLICATION_ERROR(-20581, 'REPLICA has invalid SOURCE_DB_LINK rows: ' || l_count);
  END IF;

  SELECT COUNT(*)
    INTO l_count
    FROM TBL_REPLICA_PARTITIONS
   WHERE SOURCE_OWNER = UPPER('&&ACTIVE_ARCHIVER_SCHEMA')
     AND SOURCE_TABLE_NAME IN
          ('TBL_ARCHIVER_CLIENT1_ORDERS', 'TBL_ARCHIVER_CLIENT1_SUBPART', 'TBL_ARCHIVER_CLIENT1_DAILY_INT',
          'TBL_ARCHIVER_CLIENT2_ORDERS', 'TBL_ARCHIVER_CLIENT2_SUBPART', 'TBL_ARCHIVER_CLIENT2_DAILY_INT',
          'TBL_ARCHIVER_CLIENT1_LIST_DATE', 'TBL_ARCHIVER_CLIENT1_LIST_NUMBER', 'TBL_ARCHIVER_CLIENT1_LIST_VARCHAR')
     AND (SOURCE_PARTITION_NAME = 'P_ERROR' OR UPPER(TRIM(PARTITION_HIGH_VALUE)) = 'MAXVALUE')
     AND REPLICA_STATUS = 'Y' AND QUALITY_STATUS = 'Y' AND PURGE_STATUS = 'Y';

  IF l_count != 20 THEN
    RAISE_APPLICATION_ERROR(-20582, 'REPLICA expected 20 seeded technical rows, got ' || l_count);
  END IF;

  SELECT COUNT(*) INTO l_count
    FROM TBL_REPLICA_TABLES
   WHERE PARTITION_METHOD = 'LIST'
     AND REPLICATE_EXPRESSION IS NOT NULL;

  IF l_count != 3 THEN
    RAISE_APPLICATION_ERROR(-20583, 'REPLICA expected 3 LIST configurations, got ' || l_count);
  END IF;
END;
/

PROMPT REPLICA 001 completed
DIRPCK_20260702_152721_[END]
DIRPCK_20260702_152721_[FILE] tests/test_replica/002_db_link.sql
DIRPCK_20260702_152721_[SIZE] 1091
DIRPCK_20260702_152721_[BEGIN]
PROMPT REPLICA 002 - ARCHIVER DB link

CONNECT &&ACTIVE_REPLICA_SCHEMA/"&&ACTIVE_REPLICA_PASSWORD"@&&ACTIVE_REPLICA_CONNECT

DECLARE
  l_count NUMBER;
BEGIN
  SELECT COUNT(*)
    INTO l_count
    FROM USER_DB_LINKS
   WHERE DB_LINK = UPPER('&&ACTIVE_ARCHIVER_LINK');

  IF l_count != 1 THEN
    RAISE_APPLICATION_ERROR(-20590, 'REPLICA ARCHIVER DB link not found: &&ACTIVE_ARCHIVER_LINK');
  END IF;

  SELECT COUNT(*)
    INTO l_count
    FROM USER_SYNONYMS
   WHERE SYNONYM_NAME = 'REPLICA_ARCHIVER_PARTITIONS_SRC';

  IF l_count != 0 THEN
    RAISE_APPLICATION_ERROR(-20591, 'Obsolete REPLICA ARCHIVER metadata synonym exists');
  END IF;

  EXECUTE IMMEDIATE 'SELECT COUNT(*) FROM dual@' || DBMS_ASSERT.SIMPLE_SQL_NAME('&&ACTIVE_ARCHIVER_LINK')
    INTO l_count;

  EXECUTE IMMEDIATE
    'SELECT COUNT(*) FROM ' ||
    DBMS_ASSERT.SIMPLE_SQL_NAME('&&ACTIVE_ARCHIVER_SCHEMA') ||
    '.TBL_ARCHIVER_PARTITIONS@' ||
    DBMS_ASSERT.SIMPLE_SQL_NAME('&&ACTIVE_ARCHIVER_LINK') ||
    ' WHERE 1 = 0'
    INTO l_count;
END;
/

PROMPT REPLICA 002 completed
DIRPCK_20260702_152721_[END]
DIRPCK_20260702_152721_[FILE] tests/test_replica/003_replica_flow.sql
DIRPCK_20260702_152721_[SIZE] 2593
DIRPCK_20260702_152721_[BEGIN]
PROMPT REPLICA 003 - replica flow

CONNECT &&ACTIVE_REPLICA_SCHEMA/"&&ACTIVE_REPLICA_PASSWORD"@&&ACTIVE_REPLICA_CONNECT

BEGIN
  PKG_REPLICA_RUNNER.prc_run
  (
    p_execute       => 'Y',
    p_stop_after_step => 'PURGE',
    p_purge_execute => 'N'
  );
END;
/

DECLARE
  l_count NUMBER;
  l_total_rows NUMBER := 0;
  l_sql VARCHAR2(4000);
BEGIN
  SELECT COUNT(*)
    INTO l_count
    FROM TBL_REPLICA_PARTITIONS
   WHERE SOURCE_OWNER = UPPER('&&ACTIVE_ARCHIVER_SCHEMA')
     AND SOURCE_TABLE_NAME IN
         ('TBL_ARCHIVER_CLIENT1_ORDERS', 'TBL_ARCHIVER_CLIENT1_SUBPART', 'TBL_ARCHIVER_CLIENT1_DAILY_INT',
          'TBL_ARCHIVER_CLIENT2_ORDERS', 'TBL_ARCHIVER_CLIENT2_SUBPART', 'TBL_ARCHIVER_CLIENT2_DAILY_INT',
          'TBL_ARCHIVER_CLIENT1_LIST_DATE', 'TBL_ARCHIVER_CLIENT1_LIST_NUMBER', 'TBL_ARCHIVER_CLIENT1_LIST_VARCHAR')
     AND REPLICA_STATUS = 'Y'
     AND QUALITY_STATUS = 'Y'
     AND NVL(SOURCE_ROW_COUNT, -1) = NVL(TARGET_ROW_COUNT, -2)
     AND NVL(TARGET_ROW_COUNT, 0) > 0;

  IF l_count = 0 THEN
    RAISE_APPLICATION_ERROR(-20600, 'REPLICA flow did not produce any positive quality rows');
  END IF;

  FOR r IN (
    SELECT DISTINCT TARGET_OWNER, TARGET_TABLE_NAME
      FROM TBL_REPLICA_TABLES
     WHERE SOURCE_OWNER = UPPER('&&ACTIVE_ARCHIVER_SCHEMA')
       AND SOURCE_TABLE_NAME IN
           ('TBL_ARCHIVER_CLIENT1_ORDERS', 'TBL_ARCHIVER_CLIENT1_SUBPART', 'TBL_ARCHIVER_CLIENT1_DAILY_INT',
            'TBL_ARCHIVER_CLIENT2_ORDERS', 'TBL_ARCHIVER_CLIENT2_SUBPART', 'TBL_ARCHIVER_CLIENT2_DAILY_INT',
            'TBL_ARCHIVER_CLIENT1_LIST_DATE', 'TBL_ARCHIVER_CLIENT1_LIST_NUMBER', 'TBL_ARCHIVER_CLIENT1_LIST_VARCHAR')
  ) LOOP
    l_sql := 'SELECT COUNT(*) FROM ' ||
             DBMS_ASSERT.SIMPLE_SQL_NAME(r.TARGET_OWNER) || '.' ||
             DBMS_ASSERT.SIMPLE_SQL_NAME(r.TARGET_TABLE_NAME);
    EXECUTE IMMEDIATE l_sql INTO l_count;
    l_total_rows := l_total_rows + l_count;
  END LOOP;

  IF l_total_rows = 0 THEN
    RAISE_APPLICATION_ERROR(-20601, 'REPLICA targets are empty after replica flow');
  END IF;

  SELECT COUNT(*) INTO l_count
    FROM TBL_REPLICA_PARTITIONS
   WHERE SOURCE_TABLE_NAME IN
         ('TBL_ARCHIVER_CLIENT1_LIST_DATE', 'TBL_ARCHIVER_CLIENT1_LIST_NUMBER',
          'TBL_ARCHIVER_CLIENT1_LIST_VARCHAR')
     AND REPLICA_STATUS = 'Y' AND QUALITY_STATUS = 'Y'
     AND TARGET_ROW_COUNT > 0;

  IF l_count = 0 THEN
    RAISE_APPLICATION_ERROR(-20602, 'REPLICA LIST setups did not produce positive quality rows');
  END IF;
END;
/

PROMPT REPLICA 003 completed
DIRPCK_20260702_152721_[END]
DIRPCK_20260702_152721_[FILE] tests/test_replica/004_quality.sql
DIRPCK_20260702_152721_[SIZE] 3760
DIRPCK_20260702_152721_[BEGIN]
PROMPT REPLICA 004 - quality and invalid objects

CONNECT &&ACTIVE_REPLICA_SCHEMA/"&&ACTIVE_REPLICA_PASSWORD"@&&ACTIVE_REPLICA_CONNECT

DECLARE
  l_count NUMBER;
BEGIN
  SELECT COUNT(*)
    INTO l_count
    FROM TBL_REPLICA_PARTITIONS
   WHERE SOURCE_OWNER = UPPER('&&ACTIVE_ARCHIVER_SCHEMA')
     AND SOURCE_TABLE_NAME IN
         ('TBL_ARCHIVER_CLIENT1_ORDERS', 'TBL_ARCHIVER_CLIENT1_SUBPART', 'TBL_ARCHIVER_CLIENT1_DAILY_INT',
          'TBL_ARCHIVER_CLIENT2_ORDERS', 'TBL_ARCHIVER_CLIENT2_SUBPART', 'TBL_ARCHIVER_CLIENT2_DAILY_INT',
          'TBL_ARCHIVER_CLIENT1_LIST_DATE', 'TBL_ARCHIVER_CLIENT1_LIST_NUMBER', 'TBL_ARCHIVER_CLIENT1_LIST_VARCHAR')
     AND REPLICA_STATUS = 'Y'
     AND (QUALITY_STATUS <> 'Y'
          OR NVL(SOURCE_ROW_COUNT, -1) <> NVL(TARGET_ROW_COUNT, -2));

  IF l_count != 0 THEN
    RAISE_APPLICATION_ERROR(-20610, 'REPLICA quality mismatch rows: ' || l_count);
  END IF;

  UPDATE TBL_REPLICA_TABLES
     SET REPLICATE_EXPRESSION = '1=2'
   WHERE SOURCE_TABLE_NAME = 'TBL_ARCHIVER_CLIENT1_LIST_NUMBER';
  COMMIT;

  SELECT COUNT(*) INTO l_count
    FROM VW_REPLICA_PURGE_PARTITIONS
   WHERE SOURCE_TABLE_NAME = 'TBL_ARCHIVER_CLIENT1_LIST_NUMBER';

  IF l_count = 0 THEN
    RAISE_APPLICATION_ERROR(-20611, 'REPLICA inverse expression did not produce purge candidates');
  END IF;

  PKG_REPLICA_PURGE.prc_purge
  (
    p_execute           => 'N',
    p_target_owner      => NULL,
    p_target_table_name => NULL
  );

  UPDATE TBL_REPLICA_TABLES
     SET REPLICATE_EXPRESSION = 'INVALID SQL'
   WHERE SOURCE_TABLE_NAME = 'TBL_ARCHIVER_CLIENT1_LIST_NUMBER';
  COMMIT;

  SELECT (SELECT COUNT(*) FROM VW_REPLICA_REPLICATE_PARTITIONS
           WHERE SOURCE_TABLE_NAME = 'TBL_ARCHIVER_CLIENT1_LIST_NUMBER')
       + (SELECT COUNT(*) FROM VW_REPLICA_PURGE_PARTITIONS
           WHERE SOURCE_TABLE_NAME = 'TBL_ARCHIVER_CLIENT1_LIST_NUMBER')
    INTO l_count FROM dual;

  IF l_count != 0 THEN
    RAISE_APPLICATION_ERROR(-20613, 'ERROR expression qualified work for execution');
  END IF;

  UPDATE TBL_REPLICA_TABLES
     SET REPLICATE_EXPRESSION = '10 IN (<partition_high_value>) OR 20 IN (<partition_high_value>)'
   WHERE SOURCE_TABLE_NAME = 'TBL_ARCHIVER_CLIENT1_LIST_NUMBER';
  COMMIT;

  SELECT COUNT(DISTINCT r.run_type)
    INTO l_count
    FROM TBL_REPLICA_RUNS r
    JOIN TBL_REPLICA_PROCESS_LOG l
      ON l.mstr_log_id = r.mstr_log_id
   WHERE (r.run_type, r.run_id) IN
         (
           SELECT run_type, MAX(run_id)
             FROM TBL_REPLICA_RUNS
            WHERE run_type IN ('DISCOVER', 'REPLICATE', 'QUALITY', 'PURGE')
            GROUP BY run_type
         )
     AND DBMS_LOB.INSTR(l.log_json, '"type":"TABLE_CONTEXT"') > 0;

  IF l_count != 4 THEN
    RAISE_APPLICATION_ERROR(-20614, 'REPLICA expected TABLE_CONTEXT logs for 4 processes, got ' || l_count);
  END IF;

  SELECT COUNT(*)
    INTO l_count
    FROM TBL_REPLICA_PROCESS_LOG
   WHERE DBMS_LOB.INSTR(log_msg, 'RANGE / ORDER_DATE / DATE') > 0
     AND DBMS_LOB.INSTR(log_msg, '| SUBPARTITION | NONE') > 0;

  IF l_count = 0 THEN
    RAISE_APPLICATION_ERROR(-20615, 'REPLICA RANGE table context was not logged');
  END IF;

  SELECT COUNT(*)
    INTO l_count
    FROM TBL_REPLICA_PROCESS_LOG
   WHERE DBMS_LOB.INSTR(log_msg, 'LIST / REGION_CODE / VARCHAR2') > 0
     AND DBMS_LOB.INSTR(log_msg, 'LIST / STATUS_CODE / VARCHAR2') > 0;

  IF l_count = 0 THEN
    RAISE_APPLICATION_ERROR(-20616, 'REPLICA LIST-LIST table context was not logged');
  END IF;

  SELECT COUNT(*)
    INTO l_count
    FROM USER_OBJECTS
   WHERE STATUS <> 'VALID';

  IF l_count != 0 THEN
    RAISE_APPLICATION_ERROR(-20612, 'REPLICA invalid objects: ' || l_count);
  END IF;
END;
/

PROMPT REPLICA 004 completed
DIRPCK_20260702_152721_[END]
DIRPCK_20260702_152721_[FILE] tests/test_replica/005_util_objects.sql
DIRPCK_20260702_152721_[SIZE] 1671
DIRPCK_20260702_152721_[BEGIN]
PROMPT REPLICA 005 - utility report and mail

CONNECT &&ACTIVE_REPLICA_SCHEMA/"&&ACTIVE_REPLICA_PASSWORD"@&&ACTIVE_REPLICA_CONNECT

DECLARE
  l_report CLOB;
  l_summary CLOB;
  l_enabled VARCHAR2(1);
  l_lookback_days VARCHAR2(4000);
  l_summary_max_chars VARCHAR2(4000);
BEGIN
  l_enabled := PKG_UTIL_MAIL.fn_mail_enabled;
  l_lookback_days := PKG_UTIL_REPORT.fn_get_config('REPORT_LOOKBACK_DAYS');
  l_summary_max_chars := PKG_UTIL_REPORT.fn_get_config('REPORT_SUMMARY_MAX_CHARS');

  IF l_enabled NOT IN ('Y', 'N') THEN
    RAISE_APPLICATION_ERROR(-20640, 'REPLICA utility mail enabled flag must be Y or N');
  END IF;

  IF l_lookback_days IS NULL OR NOT REGEXP_LIKE(l_lookback_days, '^[0-9]+$') THEN
    RAISE_APPLICATION_ERROR(-20642, 'REPLICA REPORT_LOOKBACK_DAYS must be numeric');
  END IF;

  IF l_summary_max_chars IS NULL OR NOT REGEXP_LIKE(l_summary_max_chars, '^[0-9]+$') THEN
    RAISE_APPLICATION_ERROR(-20644, 'REPLICA REPORT_SUMMARY_MAX_CHARS must be numeric');
  END IF;

  l_report := PKG_UTIL_REPORT.fn_report_html('UTIL_SMOKE_REPORT');
  IF DBMS_LOB.GETLENGTH(l_report) = 0 THEN
    RAISE_APPLICATION_ERROR(-20641, 'REPLICA utility report returned empty HTML');
  END IF;

  l_summary := PKG_UTIL_REPORT.fn_report_html('REPLICA_SUMMARY');
  IF DBMS_LOB.GETLENGTH(l_summary) = 0 THEN
    RAISE_APPLICATION_ERROR(-20643, 'REPLICA summary report returned empty HTML');
  END IF;

  IF l_enabled = 'Y' THEN
    PKG_UTIL_MAIL.prc_send_report('REPLICA_SUMMARY');
  ELSE
    PKG_UTIL_MAIL.prc_send_html('nobody@example.invalid', 'Disabled mail smoke', l_report);
  END IF;
END;
/

PROMPT REPLICA 005 completed
DIRPCK_20260702_152721_[END]
DIRPCK_20260702_152721_[FILE] tests/test_replica/006_list_validation.sql
DIRPCK_20260702_152721_[SIZE] 2319
DIRPCK_20260702_152721_[BEGIN]
PROMPT REPLICA 006 - LIST validation and metadata exclusions

CONNECT &&ACTIVE_REPLICA_SCHEMA/"&&ACTIVE_REPLICA_PASSWORD"@&&ACTIVE_REPLICA_CONNECT

BEGIN
  EXECUTE IMMEDIATE 'DROP TABLE TBL_REPLICA_TEST_TYPE PURGE';
EXCEPTION WHEN OTHERS THEN IF SQLCODE != -942 THEN RAISE; END IF;
END;
/
BEGIN
  EXECUTE IMMEDIATE 'DROP TABLE TBL_REPLICA_TEST_MULTI PURGE';
EXCEPTION WHEN OTHERS THEN IF SQLCODE != -942 THEN RAISE; END IF;
END;
/

CREATE TABLE TBL_REPLICA_TEST_TYPE
(
  ORDER_DATE VARCHAR2(30) NOT NULL
)
PARTITION BY LIST (ORDER_DATE)
(
  PARTITION P_ERROR VALUES ('#ERROR#')
);

CREATE TABLE TBL_REPLICA_TEST_MULTI
(
  ORDER_DATE DATE NOT NULL,
  ORDER_ID NUMBER NOT NULL
)
PARTITION BY RANGE (ORDER_DATE, ORDER_ID)
(
  PARTITION P_ERROR VALUES LESS THAN (DATE '1800-01-01', 0)
);

DECLARE
  l_count NUMBER;

  PROCEDURE assert_error(p_target VARCHAR2, p_method VARCHAR2, p_code NUMBER) IS
  BEGIN
    BEGIN
      PKG_REPLICA_DISCOVERY.prc_validate_table_setup
      (
        UPPER('&&ACTIVE_ARCHIVER_LINK'), UPPER('&&ACTIVE_ARCHIVER_SCHEMA'),
        'TBL_ARCHIVER_CLIENT1_LIST_DATE', UPPER('&&ACTIVE_REPLICA_SCHEMA'),
        p_target, p_method, NULL
      );
      RAISE_APPLICATION_ERROR(-20650, 'Expected validation error was not raised');
    EXCEPTION WHEN OTHERS THEN
      IF SQLCODE != p_code THEN RAISE; END IF;
    END;
  END;
BEGIN
  assert_error('TBL_REPLICA_CLIENT1_LIST_DATE', 'RANGE', -20264);
  assert_error('TBL_REPLICA_TEST_TYPE', 'LIST', -20266);
  assert_error('TBL_REPLICA_TEST_MULTI', 'LIST', -20262);

  SELECT COUNT(*) INTO l_count
    FROM VW_REPLICA_SOURCE_PARTITIONS
   WHERE SOURCE_TABLE_NAME = 'TBL_ARCHIVER_CLIENT1_ORDERS'
     AND PARTITION_HIGH_VALUE = 'MAXVALUE';
  IF l_count != 1 THEN
    RAISE_APPLICATION_ERROR(-20651, 'MAXVALUE is not visible in REPLICA source metadata');
  END IF;

  SELECT COUNT(*) INTO l_count
    FROM VW_REPLICA_DISCOVERY_PARTITIONS
   WHERE SOURCE_TABLE_NAME = 'TBL_ARCHIVER_CLIENT1_ORDERS'
     AND PARTITION_HIGH_VALUE = 'MAXVALUE';
  IF l_count != 0 THEN
    RAISE_APPLICATION_ERROR(-20652, 'Completed MAXVALUE metadata entered discovery');
  END IF;
END;
/

DROP TABLE TBL_REPLICA_TEST_TYPE PURGE;
DROP TABLE TBL_REPLICA_TEST_MULTI PURGE;

PROMPT REPLICA 006 completed
DIRPCK_20260702_152721_[END]
